0:{"buildId":"JFSdapXluxcZ7WLb1GQKv","data":[{"rsc":["$","$1","c",{"children":[["$","$L2",null,{"caseData":{"level":"RED","case_id":"D001","title":"Un clamor urgente de ayuda tras el huracán Helene","short_summary":"En medio de la devastación causada por el huracán Helene en 2024, la foto de una niña llorando mientras abrazaba a su cachorro en una inundación se volvió viral, se compartió millones de veces y desató un intenso debate sobre las labores de rescate.","duration_min":6,"skills":["Pruebas visuales","Lenguaje y afirmaciones","Cadenas de información"],"spotted_url":"/assets/images/D001/D001_spotted.png","theme":["Respuesta ante desastres","Información pública"],"story_context":"Tras el paso del huracán Helene, se difundió en las redes una imagen conmovedora de una niña llorando mientras abrazaba a un cachorro en una inundación. La imagen se presentó como el registro de un rescate real y se utilizó para influir en la opinión pública sobre la eficacia de la respuesta ante el desastre, aunque ni la niña ni la escena fotografiada existieron.","source":{"title":"Seeing is no longer believing: Artificial Intelligence's impact on photojournalism","url":"https://jsk.stanford.edu/news/seeing-no-longer-believing-artificial-intelligences-impact-photojournalism","note":"Escenario adaptado a partir del análisis de David Carson sobre la imagen generada por IA de la niña y el cachorro en la inundación que circuló durante el huracán Helene."},"modules":{"step_1_image_forensics":{"mechanic_type":"IMAGE_FORENSICS","image_url":"/assets/images/D001/D001_fake.webp","image_width":1024,"image_height":1024,"context_text":"Esta imagen se difundió como prueba documental del rescate de una menor durante las inundaciones catastróficas tras el huracán Helene.","target_anomalies":[{"anomaly_id":"D001_IMG_01","name":"synthetic_facial_features","x_pct":49.8,"y_pct":30.1,"radius_pct":25.5,"socratic_quiz":{"question":"Tras observar una piel demasiado lisa y detalles faciales inestables, ¿qué conclusión está mejor justificada?","options":["A. Este indicio basta para demostrar que toda la imagen fue generada por IA.","B. Es un indicio que debe contrastarse con la imagen original, su fuente y otros detalles independientes.","C. El procesado de la cámara explica el indicio, así que no hace falta comprobar nada más."],"correct_option":"B","explanation":"Una anomalía visual es un indicio, no un veredicto. Compara el original, su fuente y varios detalles independientes antes de concluir."},"description":"El rostro de la niña presenta un acabado demasiado liso y artificial, con incoherencias en los detalles alrededor de los ojos y la boca, así como en la expresión."}]},"step_2_text_highlight":{"mechanic_type":"TEXT_HIGHLIGHT","simulated_post":{"author":"Storm Truth Network","time_posted":"Hace 18 minutos","content":"Mira a esta pequeña aferrada a su cachorro en medio de la inundación. Los medios jamás te mostrarán lo que realmente ocurre tras el huracán. Esta foto demuestra que los equipos de rescate abandonaron a familias como la suya mientras las autoridades daban ruedas de prensa. Compártela antes de que borren las pruebas."},"traps":[{"trap_id":"D001_TRAP_01","ground_truth_start":141,"ground_truth_end":272,"matched_text":"Esta foto demuestra que los equipos de rescate abandonaron a familias como la suya mientras las autoridades daban ruedas de prensa.","weapon_type":["appeal_to_emotion","unsupported_inference"],"socratic_quiz":{"question":"¿Qué información permitiría comprobar más directamente que los equipos de rescate abandonaron a las familias?","options":["A. El número de veces que se compartió la publicación y los comentarios favorables del primer día.","B. Registros de rescate, lugar, hora e informes independientes sobre la zona concreta mencionada.","C. Otra cuenta que publique la misma imagen con un texto parecido."],"correct_option":"B","explanation":"Una imagen no demuestra cómo actuó todo un operativo. Contrasta la acusación con registros y fuentes independientes del mismo lugar y momento."}}]},"step_3_sorting_game":{"mechanic_type":"DRAG_AND_DROP_SORTING","context_text":"La imagen sintética del rescate entra en un ciclo de noticias acelerado durante un desastre real y comienza a condicionar la opinión pública sobre la respuesta institucional.","pool_items":[{"item_id":"D001_SORT_02","text":"Los usuarios reaccionan ante el sufrimiento de la menor y difunden la imagen como prueba de que los equipos de rescate fallaron a las familias."},{"item_id":"D001_SORT_03","text":"La difusión masiva desvincula la imagen de su origen desconocido, y el relato falso acaba compitiendo con la cobertura periodística verificada del desastre."},{"item_id":"D001_SORT_01","text":"Una cuenta publica una imagen sintética sobre un rescate con un texto referido a un desastre real, sin atribuir fotógrafo, ubicación ni fuente original."}],"correct_sequence":["D001_SORT_01","D001_SORT_02","D001_SORT_03"],"validation_feedback":{"success":"Correcto. La imagen sintética cobra fuerza al apoyarse en un desastre real, una lectura emocional y la difusión repetida. A medida que su origen se diluye, la narrativa inventada puede desviar la atención de los datos verificados sobre personas reales.","failure":"No es correcto. Comienza por la imagen sin fuente, sigue con la interpretación emocional y concluye con el impacto que la redifusión produce sobre el origen y la credibilidad de la imagen."}}},"dialogue_trigger":{"question":"Si una imagen despierta una reacción emocional intensa y parece confirmar lo que ya creías, ¿qué deberías comprobar antes de compartirla?","mil_insight":"Rastrea la publicación original más antigua, identifica al fotógrafo o creador, confirma la fecha y ubicación mediante periodismo independiente y busca credenciales de procedencia como Content Credentials. Los artefactos visuales son indicios, no un veredicto definitivo: las imágenes auténticas también pueden ser acusadas falsamente de estar generadas por IA."}}}],["$L3","$L4"],"$L5"]}],"isPartial":"$@6","staleTime":"$7","varyParams":null},{"rsc":"$L8","isPartial":"$@9","staleTime":"$7","varyParams":null},{"rsc":"$La","isPartial":"$@b","staleTime":"$7","varyParams":"$c"},{"rsc":"$Ld","isPartial":"$@e","staleTime":"$7","varyParams":"$c"},{"rsc":"$Lf","isPartial":"$@10","staleTime":"$7","varyParams":"$c"}],"isUpgradeableISRFallback":false,"a":"$@11","rootVaryParams":null,"needsRuntimeRequest":"$@12"}
