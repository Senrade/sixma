0:{"buildId":"JFSdapXluxcZ7WLb1GQKv","data":[{"rsc":["$","$1","c",{"children":[["$","$L2",null,{"children":["$","$L3",null,{"caseData":{"level":"RED","case_id":"S005","title":"¿Por qué está vacío Times Square?","short_summary":"Una imagen de un Times Square desierto vuelve a circular con afirmaciones sobre una emergencia sanitaria en 2026 y un nuevo confinamiento, desatando un tenso debate.","duration_min":6,"skills":["Pruebas visuales","Lenguaje y afirmaciones","Cadenas de información"],"spotted_url":"/assets/images/R005/R005_spotted.jpg","theme":["Salud pública","Actualidad"],"story_context":"Varias publicaciones comparten una imagen de Times Square completamente desierto mientras afirman que una grave emergencia sanitaria en 2026 obligó a las autoridades a confinar Nueva York. La fecha y la fuente originales no son visibles en las publicaciones en circulación. Examina lo que se puede determinar a partir de las pruebas disponibles.","source":{"title":"Context Collapse and Hybrid AI Misinformation","url":"","note":"Escenario basado en tácticas del mundo real en las que imágenes auténticas de crisis pasadas se alteran digitalmente para fabricar pánico en la actualidad."},"modules":{"step_1_image_forensics":{"mechanic_type":"IMAGE_FORENSICS","image_url":"/assets/images/R005/R005_fake.jpg","image_width":1536,"image_height":1024,"context_text":"Publicaciones en redes sociales comparten esta foto como prueba absoluta de un confinamiento de emergencia por coronavirus en 2026 en Times Square.","target_anomalies":[{"anomaly_id":"R005_IMG_01","name":"flipped_digit_in_year","x_pct":48.5,"y_pct":6.5,"radius_pct":6,"socratic_quiz":{"question":"¿Qué comparación comprueba mejor si «2026» pertenece al cartel o se añadió después?","options":["A. Comparar forma, perspectiva y luz de cada dígito entre sí y con imágenes antiguas fiables.","B. Comprobar si el edificio suele mostrar el año nuevo en sus carteles publicitarios.","C. Aumentar la nitidez para ver si los dígitos quedan más claros que los objetos cercanos."],"correct_option":"A","explanation":"Un añadido puede romper la coherencia de forma, perspectiva o luz. Las imágenes antiguas independientes ayudan a comprobarlo."},"description":"El primer dígito «2» en «2026» está invertido verticalmente, lo cual resulta totalmente ilógico en comparación con la tipografía original."},{"anomaly_id":"R005_IMG_02","name":"corrupted_billboard_text","x_pct":76,"y_pct":26.4,"radius_pct":15,"socratic_quiz":{"question":"¿Qué prueba distingue texto pequeño comprimido de texto generado o editado?","options":["A. Comparar el brillo del panel con otros carteles de la misma escena.","B. Comprobar si los caracteres repetidos conservan su forma y crean palabras coherentes en la fuente.","C. Decidir si el mensaje encaja con la situación descrita por la publicación."],"correct_option":"B","explanation":"La compresión elimina detalle, pero no suele deformar cada repetición de una letra de modo distinto. Compara con la fuente."},"description":"El texto contiene errores ortográficos extravagantes, con caracteres deformados en «STAYIE» y «SSJCK»."},{"anomaly_id":"R005_IMG_03","name":"illogical_light_reflection","x_pct":49.5,"y_pct":82.1,"radius_pct":15,"socratic_quiz":{"question":"¿Qué prueba evalúa mejor el reflejo rojo de la calle?","options":["A. Seguir la dirección y el color del reflejo hasta una fuente de luz correspondiente en la escena.","B. Comparar la calle mojada con la previsión del tiempo de la fecha indicada.","C. Comparar su saturación con los ajustes de la pantalla usada para ver la imagen."],"correct_option":"A","explanation":"Un reflejo debe corresponder a una fuente en dirección y color. La falta de correspondencia es un indicio que debe comprobarse."},"description":"El charco refleja una luz roja brillante, aunque no hay ninguna fuente de luz roja correspondiente en los carteles publicitarios de alrededor."}]},"step_2_text_highlight":{"mechanic_type":"TEXT_HIGHLIGHT","simulated_post":{"author":"NYC Daily Uncensored","time_posted":"Hace 15 minutos","content":"La situación en Nueva York se ha descontrolado por completo. Un brote grave de una nueva variante de coronavirus ha provocado un confinamiento de emergencia en todo Times Square esta misma mañana. Las agencias gubernamentales están ocultando esta información deliberadamente, pero esta foto revela toda la verdad. Si no actúas de inmediato, tu familia podría verse atrapada en la próxima ola de la pandemia. Todo el mundo debe compartir esta publicación en sus grupos de inmediato para alertar a la comunidad. Ponte en contacto con tus familiares en EE. UU. inmediatamente y diles que se abastezcan de alimentos y efectivo antes de que sea demasiado tarde."},"traps":[{"trap_id":"R005_TRAP_01","ground_truth_start":197,"ground_truth_end":313,"matched_text":"Las agencias gubernamentales están ocultando esta información deliberadamente, pero esta foto revela toda la verdad.","weapon_type":["conspiracy_theory","authority_undermining"],"socratic_quiz":{"question":"¿Qué respuesta evita tanto la confianza ciega como el rechazo total de las fuentes oficiales?","options":["A. Confiar en la publicación si muchos comentarios cuentan experiencias parecidas.","B. Comparar sus afirmaciones con datos primarios y fuentes independientes que expliquen su método.","C. Confiar en el comunicado oficial porque las instituciones siempre tienen información completa."],"correct_option":"B","explanation":"Ninguna fuente debe quedar exenta de examen. Contrasta afirmaciones concretas con datos, métodos e información independiente."}},{"trap_id":"R005_TRAP_02","ground_truth_start":314,"ground_truth_end":407,"matched_text":"Si no actúas de inmediato, tu familia podría verse atrapada en la próxima ola de la pandemia.","weapon_type":["appeal_to_fear","emotional_manipulation"],"socratic_quiz":{"question":"¿Qué conducta muestra que el miedo está sustituyendo la evaluación de las pruebas?","options":["A. El lector busca el informe original y anota lo que sigue siendo incierto.","B. El lector comparte de inmediato antes de comprobar la fuente y la fecha.","C. El lector se detiene, compara fuentes y decide después si debe actuar."],"correct_option":"B","explanation":"La emoción se vuelve manipulación cuando adelanta la acción a la verificación. Esa urgencia es una señal para detenerse."}},{"trap_id":"R005_TRAP_03","ground_truth_start":510,"ground_truth_end":656,"matched_text":"Ponte en contacto con tus familiares en EE. UU. inmediatamente y diles que se abastezcan de alimentos y efectivo antes de que sea demasiado tarde.","weapon_type":["manufactured_urgency","panic_inducing_action"],"socratic_quiz":{"question":"¿En qué orden pide la publicación que actúen los lectores?","options":["A. Compartir primero la advertencia e investigar después la fuente y las pruebas.","B. Rastrear la fuente, comparar pruebas y avisar solo si es necesario.","C. Preguntar a la comunidad, esperar consenso y tratarlo como verificación."],"correct_option":"A","explanation":"La llamada invierte el orden seguro al colocar la difusión antes de la verificación. La urgencia no mejora las pruebas."}}]},"step_3_sorting_game":{"mechanic_type":"DRAG_AND_DROP_SORTING","context_text":"El proceso mediante el cual los desinformadores combinan imágenes antiguas, tecnología de IA y psicología para crear una campaña completa de desinformación.","pool_items":[{"item_id":"R005_SORT_03","text":"Redactar una publicación con palabras sensacionalistas, sembrar teorías de la conspiración y adjuntar la foto editada con IA."},{"item_id":"R005_SORT_01","text":"Recopilar una foto real de un Times Square desierto tomada durante el confinamiento de 2020."},{"item_id":"R005_SORT_04","text":"Distribuir la publicación en grupos de redes sociales para incitar a la gente a acaparar productos y generar interacción."},{"item_id":"R005_SORT_02","text":"Utilizar herramientas de IA generativa para cambiar el año de 2020 a 2026 y modificar detalles en los carteles publicitarios para renovar la imagen."}],"correct_sequence":["R005_SORT_01","R005_SORT_02","R005_SORT_03","R005_SORT_04"],"validation_feedback":{"success":"¡Correcto! Has descubierto por completo el ciclo de vida de una estafa híbrida: buscar imágenes antiguas -> editar con IA -> incorporar trampas psicológicas -> difundir el pánico.","failure":"Ese no es el orden correcto. Comienza por seleccionar la foto original, continúa con la edición mediante IA y la redacción del contenido manipulador, y termina difundiendo la publicación."}}},"dialogue_trigger":{"question":"Si ves una foto que induce al pánico sobre una situación global, ¿cuál es tu proceso de verificación en 3 pasos?","mil_insight":"1. Análisis forense de la imagen: amplía la imagen para encontrar anomalías como texto deformado, dígitos invertidos y reflejos ilógicos.\n2. Verificación del contexto: utiliza una búsqueda inversa de imágenes para determinar cuándo y dónde se tomó la foto original.\n3. Contraste de fuentes: comprueba la información en comunicados de las autoridades o medios de comunicación fiables antes de compartirla."}}}]}],["$L4","$L5","$L6"],"$L7"]}],"isPartial":"$@8","staleTime":"$9","varyParams":null},{"rsc":"$La","isPartial":"$@b","staleTime":"$9","varyParams":null},{"rsc":"$Lc","isPartial":"$@d","staleTime":"$9","varyParams":"$e"},{"rsc":"$Lf","isPartial":"$@10","staleTime":"$9","varyParams":"$e"}],"isUpgradeableISRFallback":false,"a":"$@11","rootVaryParams":null,"needsRuntimeRequest":"$@12"}
