d:[["$","title","0",{"children":"Misión R001 | SIXMA"}],["$","meta","1",{"name":"description","content":"Investigaciones interactivas que enseñan a estudiantes y familias a identificar imágenes manipuladas, retórica coercitiva y patrones de suplantación de identidad."}],["$","link","2",{"rel":"icon","href":"/favicon.ico?favicon.0m88wzozi9rl0.ico","sizes":"32x32","type":"image/x-icon"}],["$","$L12","3",{}]]
