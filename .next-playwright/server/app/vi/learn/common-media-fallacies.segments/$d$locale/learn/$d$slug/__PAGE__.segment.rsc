4:["$","section","4. Cạm bẫy tất cả hoặc không gì cả (Lưỡng phân sai)",{"className":"mb-10","children":[["$","h2",null,{"className":"text-2xl font-black leading-tight text-info","children":"4. Cạm bẫy tất cả hoặc không gì cả (Lưỡng phân sai)"}],["$","p",null,{"className":"mt-3 text-base leading-8 text-ink-soft sm:text-lg","children":"Ngụy biện lưỡng phân sai chỉ đưa ra hai lựa chọn dù thực tế còn nhiều khả năng khác. Phương án không mong muốn bị mô tả là bất khả thi hoặc nguy hiểm để đẩy bạn về phía lựa chọn của người nói. Trước khi chấp nhận, hãy hỏi xem phương án trung gian, lựa chọn thay thế hoặc cách kết hợp nào đã bị bỏ qua."}]]}]
5:["$","section","5. Phản ứng dây chuyền (Dốc trượt)",{"className":"mb-10","children":[["$","h2",null,{"className":"text-2xl font-black leading-tight text-info","children":"5. Phản ứng dây chuyền (Dốc trượt)"}],["$","p",null,{"className":"mt-3 text-base leading-8 text-ink-soft sm:text-lg","children":"Ngụy biện dốc trượt cho rằng một bước nhỏ chắc chắn sẽ gây ra chuỗi hậu quả ngày càng cực đoan. Rủi ro đôi khi thực sự tích lũy, nhưng mỗi mắt xích đều cần bằng chứng. Hãy hỏi chuỗi sự kiện có thể dừng ở đâu, có biện pháp bảo vệ nào và hậu quả dự đoán đã từng xảy ra trong trường hợp tương tự hay chưa."}]]}]
6:["$","section","Nâng cấp tư duy của bạn",{"className":"mb-10","children":[["$","h2",null,{"className":"text-2xl font-black leading-tight text-info","children":"Nâng cấp tư duy của bạn"}],["$","p",null,{"className":"mt-3 text-base leading-8 text-ink-soft sm:text-lg","children":"Tư duy phản biện không chỉ là tìm ngay đáp án đúng mà là xem đáp án đó được hỗ trợ chặt chẽ đến đâu. Khi một bài đăng khiến bạn phản ứng mạnh, hãy dừng lại và diễn đạt tuyên bố bằng ngôn ngữ trung lập. Sau đó hỏi: bằng chứng là gì, nó có hỗ trợ đúng tuyên bố này không, phương án nào bị bỏ qua và điều gì có thể khiến mình thay đổi ý kiến?"}]]}]
