0:{"buildId":"JFSdapXluxcZ7WLb1GQKv","data":[{"rsc":["$","$1","c",{"children":[["$","div",null,{"className":"flex min-h-screen flex-col bg-background text-foreground","children":[["$","$L2",null,{}],["$","main",null,{"className":"flex-1","children":["$","article",null,{"className":"py-12 sm:py-16","children":[["$","header",null,{"className":"mx-auto max-w-3xl px-4 sm:px-6","children":[["$","span",null,{"className":"inline-flex items-center border-[3px] border-border px-2 py-0.5 font-mono text-xs font-bold uppercase bg-info text-info-foreground","children":"Tư duy phản biện"}],["$","h1",null,{"className":"mt-5 text-4xl font-black leading-tight sm:text-5xl","children":"Cẩm nang về các lỗi ngụy biện phổ biến trên truyền thông hiện nay"}],["$","p",null,{"className":"mt-4 text-lg leading-8 text-ink-soft","children":"Năm kiểu ngụy biện thường xuyên xuất hiện trên mạng xã hội. Hãy học cách nhận diện chúng trước khi chúng định hình điều bạn tin hoặc chia sẻ."}],["$","p",null,{"className":"mt-3 font-mono text-xs font-bold","children":["$","$L3",null,{"messageKey":"article.minuteRead","replacements":{"minutes":7}}]}]]}],["$","div",null,{"className":"mx-auto mt-10 max-w-3xl border-t-[3px] border-border px-4 pt-9 sm:px-6","children":[[["$","section","Vì sao ngụy biện dễ lan truyền trên mạng",{"className":"mb-10","children":[["$","h2",null,{"className":"text-2xl font-black leading-tight text-info","children":"Vì sao ngụy biện dễ lan truyền trên mạng"}],["$","p",null,{"className":"mt-3 text-base leading-8 text-ink-soft sm:text-lg","children":"Ngụy biện là những lỗi trong cách lập luận khiến một lập luận thiếu vững chắc, ngay cả khi kết luận của nó tình cờ đúng. Bài đăng trên mạng thường đề cao tốc độ, sự ngắn gọn và chắc chắn, vì vậy những lập luận đơn giản hóa có thể lan xa hơn lời giải thích cẩn trọng. Nhận biết các khuôn mẫu này giúp bạn dừng lại trước khi phản ứng hoặc chia sẻ."}]]}],["$","section","1. Công kích người nói (Ad Hominem)",{"className":"mb-10","children":[["$","h2",null,{"className":"text-2xl font-black leading-tight text-info","children":"1. Công kích người nói (Ad Hominem)"}],["$","p",null,{"className":"mt-3 text-base leading-8 text-ink-soft sm:text-lg","children":"Ngụy biện công kích cá nhân nhắm vào người đưa ra ý kiến thay vì kiểm tra chính ý kiến đó. Một đề xuất hợp lý có thể bị gạt bỏ chỉ vì người trình bày từng mắc sai lầm. Quá khứ có thể ảnh hưởng đến độ tin cậy, nhưng không quyết định bằng chứng hiện tại đúng hay sai. Hãy hỏi: phần nào của lập luận đã thực sự được phản biện?"}]]}],["$","section","2. Bóp méo quan điểm (Người rơm)",{"className":"mb-10","children":[["$","h2",null,{"className":"text-2xl font-black leading-tight text-info","children":"2. Bóp méo quan điểm (Người rơm)"}],["$","p",null,{"className":"mt-3 text-base leading-8 text-ink-soft sm:text-lg","children":"Ngụy biện người rơm thay thế quan điểm thật của đối phương bằng một phiên bản yếu hơn hoặc cực đoan hơn để dễ tấn công. Chẳng hạn, đề xuất áp dụng các hạn chế hợp lý có thể bị xuyên tạc thành yêu cầu cấm hoàn toàn. Hãy đối chiếu lời phản bác với phát biểu gốc: nếu chúng không khớp, lập luận thật vẫn chưa được trả lời."}]]}],["$","section","3. Nhầm sự trùng hợp với quan hệ nhân quả",{"className":"mb-10","children":[["$","h2",null,{"className":"text-2xl font-black leading-tight text-info","children":"3. Nhầm sự trùng hợp với quan hệ nhân quả"}],["$","p",null,{"className":"mt-3 text-base leading-8 text-ink-soft sm:text-lg","children":"Khi hai sự việc xảy ra cùng lúc, chúng ta dễ cho rằng việc này gây ra việc kia. Đây là ngụy biện 'sau việc này, nên do việc này'. Tương quan có thể là một manh mối hữu ích, nhưng một yếu tố khác có thể giải thích cả hai. Hãy tìm cơ chế hợp lý, các cách giải thích cạnh tranh và bằng chứng loại trừ chúng."}]]}],"$L4","$L5","$L6","$L7"],"$L8"]}]]}]}],"$L9"]}],["$La","$Lb"],"$Lc"]}],"isPartial":"$@d","staleTime":"$e","varyParams":null},{"rsc":"$Lf","isPartial":"$@10","staleTime":"$e","varyParams":null},{"rsc":"$L11","isPart