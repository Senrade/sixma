0:{"buildId":"JFSdapXluxcZ7WLb1GQKv","data":[{"rsc":["$","$1","c",{"children":[["$","$L2",null,{"caseData":{"level":"RED","case_id":"R002","title":"Khiếu nại từ căng tin","short_summary":"Một bức ảnh khay cơm đáng lo ngại được gửi tới nhà trường, kèm yêu cầu phản hồi ngay trước khi câu chuyện bị công khai.","duration_min":12,"skills":["Bằng chứng hình ảnh","Ngôn từ và tuyên bố","Chuỗi lan truyền thông tin"],"spotted_url":"/assets/images/R002/R002_spotted.png","theme":["Đời sống học đường","An toàn thực phẩm"],"story_context":"Một tin nhắn ẩn danh đính kèm ảnh từ căng tin và cảnh báo sẽ công khai sự việc nếu nhà trường không phản hồi trước hạn. Nhà trường cần xác định hình ảnh và ngôn từ thực sự chứng minh được điều gì trước khi hành động.","modules":{"step_1_image_forensics":{"mechanic_type":"IMAGE_FORENSICS","image_url":"/assets/images/R002/R002_fake.png","image_width":1020,"image_height":680,"context_text":"Bức ảnh rò rỉ đính kèm email tống tiền được cho là chụp \"một con gián ghê tởm trong khay thức ăn của căng tin trường trung học\".","target_anomalies":[{"anomaly_id":"R002_IMG_01","name":"fake_cockroach_insertion","x_pct":69.5,"y_pct":73,"radius_pct":13.5,"socratic_quiz":{"question":"Phép so sánh nào giúp kiểm tra tốt nhất liệu con gián có thuộc về khung cảnh này một cách tự nhiên hay không?","options":["A. Đo chiều dài của nó theo vài hạt cơm để xác định loài gián đó có thể tồn tại hay không.","B. So sánh chuyển màu, kết cấu bề mặt và vùng bắt sáng của nó với thức ăn và khay kim loại dưới cùng nguồn sáng.","C. Đếm số món ăn riêng biệt xuất hiện quanh nó trong khay."],"correct_option":"B","explanation":"Kích thước có thể thay đổi theo loài và phối cảnh. Sự khác biệt về chất liệu và ánh sáng dưới cùng điều kiện là phép so sánh đáng tin hơn, nhưng vẫn cần kiểm tra nguồn ảnh."},"description":"Con gián có màu quá rực, bề mặt bóng và giống đồ chơi, không phản ứng với ánh sáng giống cơm và khay kim loại xung quanh."}]},"step_2_text_highlight":{"mechanic_type":"TEXT_HIGHLIGHT","simulated_post":{"author":"Ẩn danh","time_posted":"5 giờ trước","content":"Tôi thường không đăng những chuyện thế này, nhưng bữa trưa hôm nay thật sự khiến tôi khó chịu. Trong lúc ăn, tôi thấy một thứ trông giống con gián trong khay cơm. Tôi không biết nó đến từ nhà bếp hay từ đâu khác, có lẽ vẫn có một lời giải thích hoàn toàn hợp lý, nhưng nếu nó thực sự đến từ căng tin thì học sinh có quyền lo lắng. Tôi không nói căng tin không an toàn. Tôi chỉ hỏi tại sao chuyện này cứ xảy ra và tại sao sau đó dường như chẳng ai giải thích gì. Dù sao nhà trường có vẻ không bao giờ xem xét phản hồi của học sinh về đồ ăn, cứ nói vấn đề quá phức tạp hay đại loại vậy. Đến lúc này, tôi nghĩ phụ huynh xứng đáng biết chuyện gì đang xảy ra trước khi mọi thứ bị âm thầm che giấu..."},"traps":[{"trap_id":"R002_TRAP_01","ground_truth_start":331,"ground_truth_end":461,"matched_text":"Tôi không nói căng tin không an toàn. Tôi chỉ hỏi tại sao chuyện này cứ xảy ra và tại sao sau đó dường như chẳng ai giải thích gì.","weapon_type":["seeding_doubt"],"socratic_quiz":{"question":"Cần có bằng chứng nào trước khi câu hỏi 'tại sao chuyện này cứ xảy ra' trở nên hợp lý?","options":["A. Sự không chắc chắn của tác giả về nguồn gốc con côn trùng.","B. Những vụ việc trước đó đã được kiểm chứng độc lập, cho thấy cùng vấn đề thực sự tái diễn.","C. Việc bài đăng cụ thể này chưa nhận được phản hồi ngay lập tức."],"correct_option":"B","explanation":"Cụm từ 'cứ xảy ra' biến một trường hợp chưa xác minh thành mô thức. Muốn khẳng định sự lặp lại, cần nhiều vụ việc đã được kiểm chứng độc lập."}},{"trap_id":"R002_TRAP_02","ground_truth_start":462,"ground_truth_end":584,"matched_text":"Dù sao nhà trường có vẻ không bao giờ xem xét phản hồi của học sinh về đồ ăn, cứ nói vấn đề quá phức tạp hay đại loại vậy.","weapon_type":["poisoning_the_well","overgeneralization"],"socratic_quiz":{"question":"Làm thế nào để đánh giá phản hồi sau này của nhà trường mà không bị đóng khung bởi bài đăng?","options":["A. Đánh giá phản hồi dựa trên số người bình luận vốn đã không tin nhà trường.","B. Xem xét bằng chứng và lập luận trong phản hồi trước khi kết luận sự phức tạp là có thật hay chỉ là cái cớ.","C. Bác bỏ phản hồi nếu nó chứa chi tiết kỹ thuật khó hiểu."],"correct_option":"B","explanation":"Bài đăng gắn nhãn mọi phản hồi tương lai là cái cớ trước khi nó xuất hiện. Đánh giá công bằng phải dựa trên bằng chứng trong phản hồi, không dựa trên cách đóng khung trước đó."}},{"trap_id":"R002_TRAP_03","ground_truth_start":585,"ground_truth_end":694,"matched_text":"Đến lúc này, tôi nghĩ phụ huynh xứng đáng biết chuyện gì đang xảy ra trước khi mọi thứ bị âm thầm che giấu...","weapon_type":["conspiracy_theory","appeal_to_fear"],"socratic_quiz":{"question":"Cụm từ 'trước khi mọi thứ bị âm thầm che giấu' thay đổi thứ tự hành động và kiểm chứng của người đọc như thế nào?","options":["A. Nó khiến việc chia sẻ ngay có vẻ như hành động bảo vệ, đưa sự leo thang lên trước bước kiểm tra xem có vụ che đậy thật hay không.","B. Nó giới hạn tuyên bố ở một quan sát cá nhân và làm giảm áp lực hành động.","C. Nó hướng người đọc tới một nguồn độc lập trước khi hình thành nhận định."],"correct_option":"A","explanation":"Ám chỉ che đậy khiến chia sẻ ngay có vẻ an toàn hơn chờ kiểm chứng. Thói quen đúng là xác minh trước, khuếch đại sau."}}]},"step_3_sorting_game":{"mechanic_type":"DRAG_AND_DROP_SORTING","context_text":"Một bài đăng gây hiểu lầm về căng tin trường học đã lan rộng trong cộng đồng.","pool_items":[{"item_id":"R002_SORT_01","text":"Những người dùng khác đăng lại ảnh với cáo buộc nặng nề hơn và mặc định tình huống xấu nhất."},{"item_id":"R002_SORT_02","text":"Tin đồn được chấp nhận như 'điều ai cũng biết' dù tuyên bố ban đầu chưa từng được xác nhận."},{"item_id":"R002_SORT_03","text":"Một người đăng ảnh kèm cách diễn giải cá nhân nhưng không có bối cảnh đã được xác minh."},{"item_id":"R002_SORT_04","text":"Mọi người phản ứng theo cảm xúc và chia sẻ bài đăng trước khi chờ xác minh chính thức."}],"correct_sequence":["R002_SORT_03","R002_SORT_01","R002_SORT_04","R002_SORT_02"],"validation_feedback":{"success":"Chính xác. Tin đồn thường trở nên đáng tin do được lặp lại chứ không phải nhờ bằng chứng. Một quan sát chưa kiểm chứng có thể biến thành 'ai cũng biết là thật' khi mọi người thêm suy đoán, chia sẻ theo cảm xúc và ngừng kiểm tra nguồn ban đầu.","failure":"Chưa đúng. Thông tin sai hiếm khi lan truyền chỉ nhờ một bài đăng thuyết phục. Nó tích lũy đà khi mọi người khuếch đại cáo buộc chưa xác minh và lặp lại chúng như sự thật trước khi có ai kiểm tra bằng chứng."}}},"dialogue_trigger":{"question":"Hãy hỏi Giáo viên/Phụ huynh: nếu nhận được tin nhắn này, bạn cần bằng chứng nào trước khi tin rằng bức ảnh phản ánh một vấn đề an toàn thực phẩm có thật thay vì một câu chuyện bị thao túng?","mil_insight":"Một hình ảnh đơn lẻ hiếm khi cung cấp đủ bối cảnh để xác định chuyện gì đã xảy ra. Hãy thảo luận cách phân biệt bằng chứng trực tiếp với giả định bằng việc kiểm tra nguồn ban đầu, xác minh ảnh được chụp ở đâu và khi nào, đồng thời theo dõi quy trình điều tra chính thức của nhà trường trước khi kết luận."}}}],["$L3","$L4","$L5"],"$L6"]}],"isPartial":"$@7","staleTime":"$8","varyParams":null},{"rsc":"$L9","isPartial":"$@a","staleTime":"$8","varyParams":null},{"rsc":"$Lb","isPartial":"$@c","staleTime":"$8","varyParams":"$d"},{"rsc":"$Le","isPartial":"$@f","staleTime":"$8","varyParams":"$d"}],"isUpgradeableISRFallback":false,"a":"$@10","rootVaryParams":null,"needsRuntimeRequest":"$@11"}
