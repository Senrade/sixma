0:{"buildId":"JFSdapXluxcZ7WLb1GQKv","data":[{"rsc":["$","$1","c",{"children":[["$","$L2",null,{"children":["$","$L3",null,{"caseData":{"level":"RED","case_id":"S005","title":"Quảng trường Thời Đại vắng lặng","short_summary":"Bức ảnh Quảng trường Thời đại vắng tanh xuất hiện trở lại cùng tuyên bố về tình trạng y tế khẩn cấp và lệnh phong tỏa mới năm 2026, làm dấy lên tranh luận lo lắng.","duration_min":6,"skills":["Bằng chứng hình ảnh","Ngôn từ và tuyên bố","Chuỗi lan truyền thông tin"],"spotted_url":"/assets/images/R005/R005_spotted.jpg","theme":["Y tế công cộng","Sự kiện thời sự"],"story_context":"Các bài đăng đang chia sẻ bức ảnh Quảng trường Thời đại hoàn toàn vắng người và tuyên bố tình trạng y tế nghiêm trọng năm 2026 buộc New York phải phong tỏa. Ngày chụp và nguồn gốc ban đầu không xuất hiện trong các bài đang lan truyền. Hãy xem bằng chứng hiện có cho phép xác định điều gì.","source":{"title":"Context Collapse and Hybrid AI Misinformation","url":"","note":"Tình huống dựa trên thủ đoạn có thật: chỉnh sửa kỹ thuật số tư liệu xác thực từ các cuộc khủng hoảng trong quá khứ để tạo ra nỗi hoảng loạn ở hiện tại."},"modules":{"step_1_image_forensics":{"mechanic_type":"IMAGE_FORENSICS","image_url":"/assets/images/R005/R005_fake.jpg","image_width":1536,"image_height":1024,"context_text":"Các bài đăng mạng xã hội đang chia sẻ bức ảnh này như bằng chứng tuyệt đối về lệnh phong tỏa khẩn cấp do virus Corona tại Quảng trường Thời đại năm 2026.","target_anomalies":[{"anomaly_id":"R005_IMG_01","name":"flipped_digit_in_year","x_pct":48.5,"y_pct":6.5,"radius_pct":6,"socratic_quiz":{"question":"Phép đối chiếu nào giúp xác định con số '2026' là chi tiết thật hay được chèn thêm?","options":["A. So hình dạng, phối cảnh và ánh sáng của từng chữ số với nhau và với ảnh cũ từ nguồn đáng tin.","B. Kiểm tra xem tòa nhà có thường trưng bày năm mới trên biển quảng cáo hay không.","C. Tăng độ nét để xem con số có đọc được rõ hơn các vật thể gần đó hay không."],"correct_option":"A","explanation":"Chi tiết chèn thêm thường lệch hình dạng, phối cảnh hoặc ánh sáng. Ảnh cũ từ nguồn độc lập giúp kiểm tra giả thuyết đó."},"description":"Chữ số '2' đầu tiên trong '2026' bị lật dọc, hoàn toàn phi logic so với phông chữ gốc."},{"anomaly_id":"R005_IMG_02","name":"corrupted_billboard_text","x_pct":76,"y_pct":26.4,"radius_pct":15,"socratic_quiz":{"question":"Cách kiểm tra nào phân biệt chữ nhỏ bị nén với chữ bị tạo hoặc chỉnh sửa sai?","options":["A. So độ sáng của bảng với các biển quảng cáo khác trong cùng khung hình.","B. Kiểm tra ký tự lặp lại có giữ hình dạng và tạo thành từ nhất quán trong ảnh nguồn hay không.","C. Đánh giá nội dung thông báo có phù hợp với tình hình được bài đăng mô tả hay không."],"correct_option":"B","explanation":"Nén ảnh làm giảm chi tiết nhưng thường không biến từng ký tự thành cấu trúc khác nhau. Hãy đối chiếu ảnh nguồn trước khi kết luận bị chỉnh sửa."},"description":"Dòng chữ có những lỗi chính tả kỳ quái, với các ký tự méo mó trong 'STAYIE' và 'SSJCK'."},{"anomaly_id":"R005_IMG_03","name":"illogical_light_reflection","x_pct":49.5,"y_pct":82.1,"radius_pct":15,"socratic_quiz":{"question":"Phép kiểm tra nào đánh giá tốt nhất vùng phản chiếu màu đỏ trên mặt đường?","options":["A. Lần theo hướng và màu phản chiếu để tìm nguồn sáng tương ứng trong cảnh.","B. Đối chiếu mặt đường ướt với dự báo thời tiết của ngày được nêu trong bài.","C. So độ bão hòa màu đỏ với cài đặt màn hình đang dùng để xem ảnh."],"correct_option":"A","explanation":"Phản chiếu phải liên hệ được với nguồn sáng về hướng và màu. Nếu không, đó là manh mối chỉnh sửa cần kiểm tra thêm."},"description":"Vũng nước phản chiếu ánh sáng đỏ rực nhưng không có nguồn sáng đỏ tương ứng từ các biển quảng cáo xung quanh."}]},"step_2_text_highlight":{"mechanic_type":"TEXT_HIGHLIGHT","simulated_post":{"author":"NYC Daily Không Kiểm Duyệt","time_posted":"15 phút trước","content":"Tình hình ở New York đã rơi vào hỗn loạn hoàn toàn. Một đợt bùng phát nghiêm trọng của biến thể Corona mới đã khiến toàn bộ Quảng trường Thời đại bị phong tỏa khẩn cấp vào sáng nay. Các cơ quan chính phủ đang cố tình che giấu thông tin này, nhưng bức ảnh đã phơi bày toàn bộ sự thật. Nếu không hành động ngay lập tức, gia đình bạn có thể bị cuốn vào làn sóng đại dịch tiếp theo. Mọi người cần chia sẻ bài đăng này ngay vào các nhóm để cảnh báo cộng đồng. Hãy liên hệ ngay với người thân ở Mỹ và bảo họ tích trữ thực phẩm cùng tiền mặt trước khi quá muộn."},"traps":[{"trap_id":"R005_TRAP_01","ground_truth_start":182,"ground_truth_end":283,"matched_text":"Các cơ quan chính phủ đang cố tình che giấu thông tin này, nhưng bức ảnh đã phơi bày toàn bộ sự thật.","weapon_type":["conspiracy_theory","authority_undermining"],"socratic_quiz":{"question":"Phản ứng nào tránh được cả tin mù quáng lẫn bác bỏ mọi nguồn chính thức?","options":["A. Tin bài đăng nếu nhiều bình luận kể lại trải nghiệm tương tự.","B. So tuyên bố cụ thể với dữ liệu gốc và nhiều nguồn độc lập có phương pháp minh bạch.","C. Tin thông báo chính thức vì cơ quan công quyền luôn có đầy đủ thông tin."],"correct_option":"B","explanation":"Không nguồn nào nên được miễn kiểm tra. Hãy so từng tuyên bố với dữ liệu gốc, phương pháp và các nguồn độc lập."}},{"trap_id":"R005_TRAP_02","ground_truth_start":284,"ground_truth_end":378,"matched_text":"Nếu không hành động ngay lập tức, gia đình bạn có thể bị cuốn vào làn sóng đại dịch tiếp theo.","weapon_type":["appeal_to_fear","emotional_manipulation"],"socratic_quiz":{"question":"Dấu hiệu hành vi nào cho thấy nỗi sợ đang thay thế việc đánh giá bằng chứng?","options":["A. Người đọc tìm bản tin gốc và ghi lại điều còn chưa chắc chắn.","B. Người đọc chia sẻ ngay để cảnh báo người khác trước khi kiểm tra nguồn và thời điểm.","C. Người đọc tạm dừng, so sánh nhiều nguồn rồi mới quyết định có hành động hay không."],"correct_option":"B","explanation":"Cảm xúc trở thành thao túng khi nó đẩy hành động lên trước kiểm chứng. Nhận ra sự thôi thúc đó là tín hiệu để dừng lại."}},{"trap_id":"R005_TRAP_03","ground_truth_start":455,"ground_truth_end":554,"matched_text":"Hãy liên hệ ngay với người thân ở Mỹ và bảo họ tích trữ thực phẩm cùng tiền mặt trước khi quá muộn.","weapon_type":["manufactured_urgency","panic_inducing_action"],"socratic_quiz":{"question":"Bài đăng đang yêu cầu người đọc thực hiện các bước theo thứ tự nào?","options":["A. Chia sẻ để cảnh báo trước, còn nguồn và bằng chứng sẽ được kiểm tra sau.","B. Xác định nguồn gốc, đối chiếu bằng chứng rồi mới cảnh báo nếu cần.","C. Hỏi ý kiến cộng đồng, chờ đồng thuận rồi coi đó là xác minh."],"correct_option":"A","explanation":"Lời kêu gọi đảo ngược quy trình an toàn bằng cách đặt chia sẻ trước kiểm chứng. Cảm giác cấp bách không làm bằng chứng đáng tin hơn."}}]},"step_3_sorting_game":{"mechanic_type":"DRAG_AND_DROP_SORTING","context_text":"Quá trình kẻ lừa đảo kết hợp tư liệu cũ, công nghệ AI và tâm lý học để tạo ra một chiến dịch thông tin sai lệch hoàn chỉnh.","pool_items":[{"item_id":"R005_SORT_03","text":"Soạn bài đăng chứa từ ngữ giật gân, gieo thuyết âm mưu và đính kèm ảnh đã chỉnh sửa bằng AI."},{"item_id":"R005_SORT_01","text":"Thu thập một bức ảnh thật về Quảng trường Thời đại vắng người được chụp trong đợt phong tỏa năm 2020."},{"item_id":"R005_SORT_04","text":"Phát tán bài đăng vào các nhóm mạng xã hội để kích động mọi người tích trữ hàng hóa và tăng tương tác."},{"item_id":"R005_SORT_02","text":"Dùng công cụ AI tạo sinh để đổi năm 2020 thành 2026 và sửa chi tiết trên biển quảng cáo nhằm làm mới bức ảnh."}],"correct_sequence":["R005_SORT_01","R005_SORT_02","R005_SORT_03","R005_SORT_04"],"validation_feedback":{"success":"Chính xác! Bạn đã vạch trần hoàn toàn vòng đời của một vụ lừa đảo lai: tìm tư liệu cũ -> chỉnh sửa bằng AI -> cài bẫy tâm lý -> phát tán hoảng loạn.","failure":"Thứ tự chưa đúng. Hãy bắt đầu bằng việc chọn ảnh gốc, sau đó chỉnh sửa bằng AI, tiếp theo viết nội dung thao túng và cuối cùng là phát tán."}}},"dialogue_trigger":{"question":"Nếu thấy một bức ảnh gây hoảng loạn về tình hình toàn cầu, quy trình xác minh ba bước của bạn là gì?","mil_insight":"1. Giám định kỹ thuật (Giám định AI): phóng to để tìm dị thường như chữ méo, chữ số bị lật và phản chiếu phi logic.\n2. Xác minh bối cảnh (Tìm kiếm hình ảnh ngược): dùng công cụ tìm kiếm hình ảnh để xác định ảnh gốc được chụp ở đâu và khi nào.\n3. Đối chiếu (Nguồn chính thức): kiểm tra thông báo của cơ quan có thẩm quyền hoặc cơ quan báo chí uy tín trước khi chia sẻ."}}}]}],["$L4","$L5","$L6"],"$L7"]}],"isPartial":"$@8","staleTime":"$9","varyParams":null},{"rsc":"$La","isPartial":"$@b","staleTime":"$9","varyParams":null},{"rsc":"$Lc","isPartial":"$@d","staleTime":"$9","varyParams":"$e"},{"rsc":"$Lf","isPartial":"$@10","staleTime":"$9","varyParams":"$e"}],"isUpgradeableISRFallback":false,"a":"$@11","rootVaryParams":null,"needsRuntimeRequest":"$@12"}
