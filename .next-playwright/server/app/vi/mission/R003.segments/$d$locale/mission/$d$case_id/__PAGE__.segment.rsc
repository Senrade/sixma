0:{"buildId":"JFSdapXluxcZ7WLb1GQKv","data":[{"rsc":["$","$1","c",{"children":[["$","$L2",null,{"caseData":{"level":"RED","case_id":"R003","title":"Tuổi 20 và đã thành công?","short_summary":"Một bài đăng trau chuốt về tiền bạc, kỷ luật và thành công kéo người trẻ vào cuộc so sánh gay gắt xem ai đang bị bỏ lại phía sau.","duration_min":15,"skills":["Bằng chứng hình ảnh","Ngôn từ và tuyên bố","Chuỗi lan truyền thông tin"],"spotted_url":"/assets/images/R003/R003_spotted.png","theme":["Mạng xã hội","Tài chính cá nhân"],"story_context":"Một bài đăng của nhân vật trẻ tên 'Minh Khang' ghép lời khuyên tài chính với bức ảnh về lối sống đáng mơ ước. Thông điệp đang khiến người xem ngưỡng mộ, phòng thủ và so sánh bản thân. Hãy xem xét bài đăng trước khi quyết định nên tin tưởng tới mức nào.","modules":{"step_1_image_forensics":{"mechanic_type":"IMAGE_FORENSICS","image_url":"/assets/images/R003/R003_fake.jpg","image_width":1402,"image_height":1122,"context_text":"Bức ảnh này được dùng để củng cố tuyên bố của Minh Khang về lối sống xa hoa. Hãy xem các chi tiết vật lý trong ảnh có nhất quán với nhau hay không.","target_anomalies":[{"anomaly_id":"R003_IMG_01","name":"inconsistent_hand_features","x_pct":38.7,"y_pct":58.2,"radius_pct":8.6,"socratic_quiz":{"question":"Phép so sánh nào hữu ích nhất khi xem xét bàn tay của anh chàng đang cầm điện thoại?","options":["A. Kiểm tra xem riêng hiệu ứng phối cảnh có giải thích được vì sao bàn tay trông lớn hơn cổ tay hay không.","B. Kiểm tra màu da và đường nét khớp ngón có chuyển tiếp tự nhiên từ cổ tay đến tư thế cầm hay không.","C. Kiểm tra góc điện thoại có cùng hướng với ánh nhìn của người trong ảnh hay không."],"correct_option":"B","explanation":"Phối cảnh có thể giải thích kích thước, nhưng không giải thích màu và cấu trúc khớp thiếu nhất quán. Hãy xem đây là manh mối, không phải bằng chứng duy nhất."},"description":"Bàn tay cầm điện thoại có màu quá rực và bóng như sáp, trong khi đường nét các khớp ngón không hoàn toàn khớp với tư thế cầm tự nhiên."},{"anomaly_id":"R003_IMG_02","name":"warped_window_frame","x_pct":17,"y_pct":49.9,"radius_pct":11.2,"socratic_quiz":{"question":"Cách kiểm tra nào giúp phân biệt hiệu ứng phối cảnh với điểm không nhất quán ở khu vực cửa sổ?","options":["A. So sánh độ sáng của khung cửa với các tòa nhà bên ngoài.","B. Lần theo khung và tay nắm để xem các vật cứng giữ đường nét trơn hay gợn sóng độc lập dọc theo chiều dài.","C. Kiểm tra tay nắm có nằm ở độ cao thuận tiện để mở cửa sổ hay không."],"correct_option":"B","explanation":"Phối cảnh có thể làm vật cứng trông nghiêng, nhưng đường viền vẫn phải liền mạch. Hãy đối chiếu độ gợn với toàn bộ khung và cửa sổ thật."},"description":"Khung cửa sổ và tay nắm vốn cứng lại xuất hiện những đường gợn sóng không đều, không giữ được hình dạng gia công nhất quán."}]},"step_2_text_highlight":{"mechanic_type":"TEXT_HIGHLIGHT","simulated_post":{"author":"Minh Khang","time_posted":"2 giờ trước","content":"Thật buồn cười khi có người cứ nói 'tiền không mua được hạnh phúc' mỗi khi ai đó đăng món đồ đẹp. Kiểu như... chỉ vì bạn không đủ tiền mua không có nghĩa đó là 'khoe khoang'. Trong khi đó, tất cả những người tôi biết đều đang cày cuốc, kiếm chỗ thực tập, mua thứ họ muốn và thực sự làm được điều gì đó với cuộc đời. Nếu bạn vẫn viện cớ trong khi tất cả mọi người đều tiến lên, có lẽ hãy ngừng đổ lỗi cho người khác và tự hỏi tại sao mình đang bị bỏ lại phía sau. Cứ tức giận nếu bạn muốn, nhưng đừng mong thế giới chờ bạn."},"traps":[{"trap_id":"R003_T1","ground_truth_start":110,"ground_truth_end":174,"matched_text":"chỉ vì bạn không đủ tiền mua không có nghĩa đó là 'khoe khoang'.","weapon_type":["attacking_motive","strawman"],"socratic_quiz":{"question":"Cách phản hồi nào đánh giá lời chỉ trích mà không suy đoán động cơ của người nói?","options":["A. Xem người chỉ trích có từng đăng nội dung về tiền bạc hay không.","B. Xem lời chỉ trích có nêu được hành vi cụ thể và tiêu chí hợp lý hay không.","C. Xem phần lớn người bình luận cho rằng họ ghen tị hay chân thành."],"correct_option":"B","explanation":"Động cơ bị suy đoán không quyết định một lời phê bình đúng hay sai. Hãy đánh giá nội dung và bằng chứng của lời phê bình trước."}},{"trap_id":"R003_T2","ground_truth_start":189,"ground_truth_end":314,"matched_text":"tất cả những người tôi biết đều đang cày cuốc, kiếm chỗ thực tập, mua thứ họ muốn và thực sự làm được điều gì đó với cuộc đời","weapon_type":["false_comparison"],"socratic_quiz":{"question":"Dữ liệu nào cần có để kiểm tra tuyên bố 'mua được đồ xa xỉ nghĩa là thành công hơn'?","options":["A. Giá trung bình của những món đồ xuất hiện trong bài đăng.","B. Tiêu chí thành công rõ ràng cùng dữ liệu về thu nhập, nợ, hỗ trợ gia đình và điểm xuất phát.","C. Số người quen của tác giả đã thích hoặc chia sẻ bài đăng."],"correct_option":"B","explanation":"Khả năng mua sắm không tự đại diện cho thành công. Một so sánh có ý nghĩa cần cùng tiêu chí và phải tính đến điểm xuất phát khác nhau."}},{"trap_id":"R003_T3","ground_truth_start":316,"ground_truth_end":461,"matched_text":"Nếu bạn vẫn viện cớ trong khi tất cả mọi người đều tiến lên, có lẽ hãy ngừng đổ lỗi cho người khác và tự hỏi tại sao mình đang bị bỏ lại phía sau","weapon_type":["inducing_fomo","personal_attack"],"socratic_quiz":{"question":"Bằng chứng nào cần có trước khi tin rằng 'mọi người đều đang tiến lên còn bạn tụt lại'?","options":["A. Nhiều bài đăng nổi bật cho thấy bạn bè đang mua sắm và đi du lịch.","B. Dữ liệu đại diện về tiến bộ của nhóm, gồm cả những trường hợp không được đăng và hoàn cảnh của họ.","C. Cảm giác lo lắng của người đọc sau khi xem liên tiếp nhiều nội dung tương tự."],"correct_option":"B","explanation":"Dòng thời gian chỉ hiển thị phần mọi người chọn đăng, không phải mẫu đại diện. Đừng biến cảm giác bị bỏ lại thành kết luận về thực tế."}},{"trap_id":"R003_T4","ground_truth_start":463,"ground_truth_end":522,"matched_text":"Cứ tức giận nếu bạn muốn, nhưng đừng mong thế giới chờ bạn.","weapon_type":["emotional_dismissal"],"socratic_quiz":{"question":"Cụm từ 'cứ tức đi' làm gì với một ý kiến phản đối có bằng chứng?","options":["A. Đòi hỏi người phản đối trình bày bằng chứng rõ hơn trước khi tranh luận.","B. Đổi ý kiến phản đối thành một phản ứng cảm xúc để khỏi trả lời nội dung của nó.","C. Thừa nhận cảm xúc của người phản đối rồi mời họ giải thích thêm."],"correct_option":"B","explanation":"Gắn nhãn cảm xúc không trả lời được nội dung phản đối. Hãy quay lại lập luận và bằng chứng thay vì phán đoán trạng thái của người nói."}}]},"step_3_sorting_game":{"mechanic_type":"DRAG_AND_DROP_SORTING","context_text":"Các chiến dịch khoe khoang độc hại thường khiến người đọc cảm thấy kém cỏi trước khi bán cho họ những khóa học lừa đảo. Hãy sắp xếp các giai đoạn của chiến lược thao túng tâm lý này theo đúng thứ tự.","pool_items":[{"item_id":"R003_SORT_01","text":"Người đọc trải qua FOMO và sự hoài nghi bản thân mạnh mẽ, lo sợ mình đang tụt lại sau bạn bè."},{"item_id":"R003_SORT_02","text":"Người có ảnh hưởng đăng ảnh đồ xa xỉ giả do AI tạo ra để xây dựng địa vị và uy tín giả tạo."},{"item_id":"R003_SORT_03","text":"Người có ảnh hưởng chào bán một 'lớp học tư duy làm giàu' đắt tiền như con đường tắt tối ưu đến thành công."},{"item_id":"R003_SORT_04","text":"Bài đăng dùng so sánh sai và ngôn ngữ trịch thượng để hạ thấp những người trẻ lao động bình thường là 'lười biếng'."}],"correct_sequence":["R003_SORT_02","R003_SORT_04","R003_SORT_01","R003_SORT_03"],"validation_feedback":{"success":"Chính xác! Bạn đã giải mã phễu khoe khoang độc hại kinh điển: bịa đặt địa vị (Mồi nhử) -> hạ thấp bằng so sánh sai (Công kích) -> kích hoạt bất an và FOMO (Lo âu) -> bán khóa học 'đường tắt' đắt tiền (Kiếm tiền).","failure":"Thứ tự chưa đúng. Kẻ thao túng bằng khoe khoang độc hại trước tiên tạo dựng sự giàu có giả, sau đó tấn công lòng tự trọng của khán giả để tạo FOMO rồi mới đưa khóa học trả phí ra như một giải pháp giả."}}},"dialogue_trigger":{"question":"Hãy hỏi Giáo viên/Phụ huynh: nếu một bài đăng mạng xã hội khiến bạn lo mình đang tụt lại sau những người bạn có vẻ đủ tiền sống xa hoa, bạn có thể làm gì để đánh giá đâu là thật và đâu là dàn dựng?","mil_insight":"Những khoảnh khắc nổi bật trên mạng xã hội hiếm khi phản ánh toàn bộ thực tế, còn công cụ tạo ảnh AI giúp việc làm giả lối sống xa hoa trở nên dễ dàng. Hãy nhắc người trẻ rằng thành công không được đo bằng khoe vật chất hay hạ thấp người khác, và lời chào bán cấp bách cho các 'khóa học tư duy' đắt tiền hầu như luôn là lừa đảo trục lợi."}}}],["$L3","$L4","$L5"],"$L6"]}],"isPartial":"$@7","staleTime":"$8","varyParams":null},{"rsc":"$L9","isPartial":"$@a","staleTime":"$8","varyParams":null},{"rsc":"$Lb","isPartial":"$@c","staleTime":"$8","varyParams":"$d"},{"rsc":"$Le","isPartial":"$@f","staleTime":"$8","varyParams":"$d"}],"isUpgradeableISRFallback":false,"a":"$@10","rootVaryParams":null,"needsRuntimeRequest":"$@11"}
