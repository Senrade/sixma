0:{"buildId":"JFSdapXluxcZ7WLb1GQKv","data":[{"rsc":["$","$1","c",{"children":[["$","$L2",null,{"caseData":{"level":"RED","case_id":"R001","title":"AI giảng dạy thay giáo viên?","short_summary":"Một bức ảnh lớp học làm bùng lên tranh luận về cách công nghệ được sử dụng quanh học sinh, trong khi bài đăng nóng bỏng lan nhanh hơn câu trả lời.","duration_min":15,"skills":["Bằng chứng hình ảnh","Ngôn từ và tuyên bố","Chuỗi lan truyền thông tin"],"spotted_url":"/assets/images/R001/R001_spotted.jpg","theme":["Giáo dục","Công nghệ"],"story_context":"Học sinh và phụ huynh đang chia sẻ một bức ảnh lớp học kèm tuyên bố về việc giám sát và đánh giá tự động. Cuộc tranh luận ngày càng căng thẳng, và nhiều bài đăng dẫn người đọc tới thông tin bổ sung. Hãy xem xét tài liệu trước khi quyết định chuyện gì đang xảy ra.","modules":{"step_1_image_forensics":{"mechanic_type":"IMAGE_FORENSICS","image_url":"/assets/images/R001/R001_fake.jpg","image_width":1000,"image_height":1000,"context_text":"Bức ảnh rò rỉ đính kèm bài đăng gây tranh cãi được cho là 'bằng chứng AI đang giám sát và đánh giá học sinh trong lớp học'.","target_anomalies":[{"anomaly_id":"R001_IMG_01","name":"gibberish_text","x_pct":57.4,"y_pct":18.7,"radius_pct":14.5,"socratic_quiz":{"question":"Cách kiểm tra nào phân biệt tốt nhất chữ bị lỗi do tạo ảnh với chữ mờ do chất lượng ảnh thấp?","options":["A. So độ sáng màn hình với các vùng sáng khác trong lớp.","B. Kiểm tra xem nét chữ có tạo thành ký tự nhất quán ở nhiều vị trí hay không.","C. Xác định màn hình có được đặt đúng vị trí thường thấy trong lớp học hay không."],"correct_option":"B","explanation":"Ảnh mờ thường làm mất chi tiết một cách tương đối đồng đều; ký tự biến dạng khác nhau từng chỗ là dấu hiệu đáng kiểm tra với ảnh nguồn."},"description":"Dòng chữ vô nghĩa, méo mó và không thể đọc được hiển thị trên bảng điện tử."},{"anomaly_id":"R001_IMG_02","name":"clipping_students","x_pct":57.8,"y_pct":68.6,"radius_pct":15.7,"socratic_quiz":{"question":"Nhìn nhóm học sinh ở giữa, phía trước ảnh. Chi tiết nào thực sự không ổn?","options":["A. Các học sinh ngồi sát nhau nên một số bạn che khuất một phần cơ thể của nhau.","B. Đầu và vai của học sinh nhỏ ở giữa hòa vào những người xung quanh, khiến khó xác định cơ thể của từng người kết thúc ở đâu.","C. Khuôn mặt các học sinh bị mờ vì máy ảnh đang lấy nét vào robot."],"correct_option":"B","explanation":"Vị trí của các học sinh ở khu vực này bị chồng chéo lên nhau và không tuân theo một quy luật nhất định. Có 2 cái bàn nhưng  thay vì được che khuất rõ ràng thì vị trí của các học sinh lại không hợp lý. Chính chỗ hòa lẫn đó là dấu hiệu bất thường."},"description":"Các học sinh ở trung tâm tiền cảnh chồng lấn bất thường và hòa vào nhau."}]},"step_2_text_highlight":{"mechanic_type":"TEXT_HIGHLIGHT","simulated_post":{"author":"Cộng đồng Phụ huynh và Giáo dục","time_posted":"2 giờ trước","content":"Vừa biết Bộ Giáo dục sẽ thí điểm một trợ lý học tập AI mới tại một số trường vào học kỳ tới. Thành thật mà nói, đây có vẻ là một bước đi bí mật nhằm loại bỏ hoàn toàn giáo viên thật. Rõ ràng các tập đoàn công nghệ lớn chỉ đang muốn tự động hóa toàn bộ giáo dục để khai thác dữ liệu học sinh vì lợi nhuận. Ngay cả Giáo sư Tan cũng nói trong báo cáo mới nhất rằng 'AI hiện đang kiểm soát hoàn toàn lớp học'. Nếu phụ huynh không đứng lên và tẩy chay việc triển khai này ngay lập tức, con em chúng ta sẽ mất hoàn toàn khả năng tư duy phản biện!"},"traps":[{"trap_id":"R001_TRAP_01","ground_truth_start":93,"ground_truth_end":182,"matched_text":"Thành thật mà nói, đây có vẻ là một bước đi bí mật nhằm loại bỏ hoàn toàn giáo viên thật.","weapon_type":["conspiracy_theory","intentionality_bias"],"socratic_quiz":{"question":"Bằng chứng nào cần có trước khi kết luận chương trình thí điểm nhằm thay thế giáo viên?","options":["A. Nhiều phụ huynh cho biết họ lo ngại AI sẽ ảnh hưởng đến vai trò của giáo viên.","B. Chương trình có dùng một công cụ AI trong một số hoạt động học tập.","C. Kế hoạch nhân sự, ngân sách hoặc tài liệu triển khai cho thấy vị trí giáo viên thực sự bị loại bỏ."],"correct_option":"C","explanation":"Sự tồn tại của công cụ AI không tự chứng minh mục đích thay thế giáo viên. Kết luận về động cơ cần tài liệu hoặc hành động cụ thể, không chỉ sự lo ngại."}},{"trap_id":"R001_TRAP_02","ground_truth_start":183,"ground_truth_end":304,"matched_text":"Rõ ràng các tập đoàn công nghệ lớn chỉ đang muốn tự động hóa toàn bộ giáo dục để khai thác dữ liệu học sinh vì lợi nhuận.","weapon_type":["attribution_bias","overgeneralization","conspiracy_theory"],"socratic_quiz":{"question":"Phản ứng nào giữ được tư duy độc lập trước cụm từ 'Rõ ràng'?","options":["A. Tạm tin vì người viết diễn đạt chắc chắn và có vẻ nắm thông tin nội bộ.","B. Bác bỏ toàn bộ công nghệ giáo dục vì rủi ro thu thập dữ liệu là có thật.","C. Tách giọng điệu chắc chắn khỏi nội dung và yêu cầu bằng chứng cụ thể về dữ liệu cùng động cơ."],"correct_option":"C","explanation":"Giọng điệu tự tin không làm tăng chất lượng bằng chứng. Hãy tách từng khẳng định và yêu cầu nguồn kiểm chứng cho từng phần."}},{"trap_id":"R001_TRAP_03","ground_truth_start":406,"ground_truth_end":540,"matched_text":"Nếu phụ huynh không đứng lên và tẩy chay việc triển khai này ngay lập tức, con em chúng ta sẽ mất hoàn toàn khả năng tư duy phản biện!","weapon_type":["false_dilemma","slippery_slope"],"socratic_quiz":{"push_question":"Câu kết đã loại bỏ những khả năng hợp lý nào khỏi lựa chọn của phụ huynh?","options":["A. Khả năng ủng hộ chương trình ngay mà không cần điều kiện hay giám sát bổ sung.","B. Khả năng tìm hiểu, đặt điều kiện bảo vệ, thử nghiệm có giám sát hoặc phản đối một phần của chương trình.","C. Khả năng tẩy chay chương trình nếu sau này xuất hiện bằng chứng về rủi ro nghiêm trọng."],"correct_option":"B","explanation":"Câu viết chỉ chừa hai cực đoan: tẩy chay ngay hoặc chịu thảm họa. Nhận ra các lựa chọn trung gian giúp người đọc thoát khỏi khung ép buộc."}}]},"step_3_sorting_game":{"mechanic_type":"DRAG_AND_DROP_SORTING","context_text":"Sự hoảng loạn do bài đăng gây ra đã dẫn đến một email lừa đảo nhắm vào phụ huynh.","pool_items":[{"item_id":"R001_SORT_01","text":"Nhấp vào liên kết bảo mật bên dưới để trả phí xử lý 50.000 đồng và xác minh quyền từ chối tham gia."},{"item_id":"R001_SORT_02","text":"CẢNH BÁO: Dữ liệu cá nhân của con bạn hiện đã được lên lịch đồng bộ với hệ thống AI của Bộ."},{"item_id":"R001_SORT_03","text":"Để bảo vệ quyền riêng tư và xóa tên con khỏi dự án, phụ huynh phải hoàn thành 'Biểu mẫu từ chối' trong vòng 24 giờ."}],"correct_sequence":["R001_SORT_02","R001_SORT_03","R001_SORT_01"],"validation_feedback":{"success":"Chính xác. Bạn đã giải mã chuỗi thao túng tâm lý kinh điển: tạo sợ hãi và khẩn cấp (Mồi nhử) -> đưa ra giải pháp cấp bách (Chuyển hướng) -> cài bẫy để lấy tiền hoặc dữ liệu cá nhân (Cạm bẫy).","failure":"Logic chưa đúng. Các cuộc lừa đảo hiếm khi đòi tiền ngay từ đầu. Chúng thường bắt đầu bằng một cuộc khủng hoảng giả để làm tê liệt tư duy phản biện của nạn nhân."}}},"dialogue_trigger":{"question":"Hãy hỏi Giáo viên/Phụ huynh: nếu một tin nhắn từ trường yêu cầu phụ huynh nhấp vào liên kết lạ và thanh toán gấp để 'bảo vệ dữ liệu học tập của con', dấu hiệu then chốt nào chứng minh đó là lừa đảo?","mil_insight":"Hãy giúp phụ huynh và học sinh đối chiếu tin nhắn với quy trình hành chính chuẩn: các cơ sở giáo dục hợp pháp không dùng áp lực thời gian như thời hạn 24 giờ hoặc liên kết thanh toán không chính thức để xử lý vấn đề bảo mật."}}}],["$L3","$L4","$L5"],"$L6"]}],"isPartial":"$@7","staleTime":"$8","varyParams":null},{"rsc":"$L9","isPartial":"$@a","staleTime":"$8","varyParams":null},{"rsc":"$Lb","isPartial":"$@c","staleTime":"$8","varyParams":"$d"},{"rsc":"$Le","isPartial":"$@f","staleTime":"$8","varyParams":"$d"}],"isUpgradeableISRFallback":false,"a":"$@10","rootVaryParams":null,"needsRuntimeRequest":"$@11"}
