0:{"buildId":"JFSdapXluxcZ7WLb1GQKv","data":[{"rsc":["$","$1","c",{"children":[["$","$L2",null,{"caseData":{"level":"RED","case_id":"R004","title":"Đề thi quốc gia bị lộ?","short_summary":"Một kênh Discord tràn ngập ảnh chụp màn hình, tin nhắn khẩn cấp và những lời chào mời xoay quanh nghi vấn lộ đề thi quốc gia.","duration_min":15,"skills":["Bằng chứng hình ảnh","Ngôn từ và tuyên bố","Chuỗi lan truyền thông tin"],"spotted_url":"/assets/images/R004/R004_spotted.jpg","theme":["Giáo dục","Cộng đồng trực tuyến"],"story_context":"Học sinh trong một máy chủ Discord đang phản ứng trước tuyên bố đề thi quốc gia đã bị lộ. Một số tài khoản hứa cung cấp ngay, số khác kể lại điều bạn bè nghe được, còn thời hạn thì đang đến gần. Hãy xem xét ảnh chụp, tin nhắn và trình tự sự việc trước khi đánh giá độ tin cậy.","modules":{"step_1_image_forensics":{"mechanic_type":"IMAGE_FORENSICS","image_url":"/assets/images/R004/R004_fake.jpg","image_width":853,"image_height":548,"context_text":"Ảnh chụp màn hình kênh Discord này đang lan truyền với lời khẳng định có '100% đề thi chính thức từ Bộ Giáo dục'. Hãy xem các chi tiết giao diện có nhất quán với một màn hình Discord thật hay không.","target_anomalies":[{"anomaly_id":"R004_IMG_03","name":"distorted_ui_icon","x_pct":85.8,"y_pct":90,"radius_pct":8,"socratic_quiz":{"question":"Quan sát nào hữu ích nhất khi đánh giá hai nút nhỏ ở góc dưới bên phải?","options":["A. Nền tối của chúng có màu gần giống thanh nhập tin nhắn.","B. Các nút GIF lặp lại nhưng không giữ được hình dạng chữ và cấu trúc nhất quán.","C. Vị trí của chúng nằm gần những công cụ nhắn tin khác."],"correct_option":"B","explanation":"Các nút giao diện lặp lại phải giữ được chữ, tỷ lệ và đường viền dễ nhận biết. Khi hai nút GIF được cho là giống nhau lại khác biệt ở những chi tiết này, hãy đối chiếu ảnh với giao diện Discord thật trước khi tin tưởng."},"description":"Các icon GIF và công cụ trò chuyện ở góc dưới bên phải khung chat bị méo mó, biến dạng bất thường."},{"anomaly_id":"R004_IMG_04","name":"artifact_edge_shape","x_pct":93.6,"y_pct":31.8,"radius_pct":8,"socratic_quiz":{"question":"Điểm nào không nhất quán ở mép phải của vùng tin nhắn được tô sáng?","options":["A. Góc trên và góc dưới đều có cùng kiểu bo tròn.","B. Đường viền bị ngắt bởi một chỗ lõm vào, không tiếp nối vùng được tô sáng.","C. Mép phải nằm gần cạnh bên của cửa sổ trò chuyện."],"correct_option":"B","explanation":"Vùng tô sáng của một tin nhắn phải tạo thành một khung liền mạch. Ở đây, chỗ lõm không có nút hay nội dung nào giải thích lại làm đứt mép phải, cho thấy phần này của ảnh chụp màn hình đã bị chỉnh sửa."},"description":"Mép phải của vùng tin nhắn được tô sáng bị ngắt bởi một chỗ lõm vào, phá vỡ đường viền vốn phải liền mạch."}]},"step_2_text_highlight":{"mechanic_type":"TEXT_HIGHLIGHT","simulated_post":{"author":"Hội đồng tuyển chọn học bổng","time_posted":"Ngay bây giờ","content":"Chúc mừng! Bạn đã được chọn nhận Học bổng Sinh viên Xuất sắc. Chỉ có 50 sinh viên được lựa chọn. Nếu bạn không hoàn tất xác minh trong vòng 2 giờ, suất học bổng của bạn sẽ được chuyển cho một sinh viên khác. Vui lòng đăng nhập để thanh toán phí xác minh 49.000 VNĐ. Không liên hệ với văn phòng nhà trường vì quá trình xác minh được thực hiện bởi đối tác học bổng của chúng tôi."},"traps":[{"trap_id":"R004_TRAP_01","ground_truth_start":11,"ground_truth_end":61,"matched_text":"Bạn đã được chọn nhận Học bổng Sinh viên Xuất sắc.","weapon_type":["authority_bias","reward_bait"],"socratic_quiz":{"question":"Việc xác nhận bạn 'đã được chọn' nhằm thay đổi bước tiếp theo của bạn như thế nào?","options":["A. Chuyển sự chú ý từ kiểm tra tính hợp lệ sang làm nhanh các bước để nhận phần thưởng.","B. Khuyến khích người nhận hỏi nhà trường về tiêu chí xét chọn trước khi phản hồi.","C. Cho người nhận đủ thông tin để so sánh thông báo với quy trình học bổng chính thức."],"correct_option":"A","explanation":"Cảm giác đã thắng khiến người nhận tập trung vào nhận thưởng thay vì xác minh. Hãy kiểm tra quy trình qua kênh chính thức trước khi làm bước tiếp theo."}},{"trap_id":"R004_TRAP_02","ground_truth_start":97,"ground_truth_end":207,"matched_text":"Nếu bạn không hoàn tất xác minh trong vòng 2 giờ, suất học bổng của bạn sẽ được chuyển cho một sinh viên khác.","weapon_type":["artificial_urgency"],"socratic_quiz":{"question":"Cách kiểm tra nào xác định tốt nhất thời hạn hai giờ có hợp lệ hay chỉ tạo áp lực?","options":["A. Xem đồng hồ đếm ngược trên trang có hoạt động chính xác hay không.","B. Kiểm tra quy định trên website chính thức và liên hệ đơn vị qua thông tin tự tìm được.","C. So sánh giá trị học bổng với thời gian còn lại để quyết định có đáng mạo hiểm."],"correct_option":"B","explanation":"Thời hạn chỉ đáng tin khi xuất hiện trong quy trình chính thức và được xác nhận độc lập. Áp lực thời gian không thay thế được bằng chứng."}},{"trap_id":"R004_TRAP_03","ground_truth_start":241,"ground_truth_end":264,"matched_text":"phí xác minh 49.000 VNĐ","weapon_type":["advance_fee_scam"],"socratic_quiz":{"question":"Hành động nào kiểm tra yêu cầu 'phí xác minh' mà không đi theo đường dẫn của người gửi?","options":["A. Tìm điều lệ học bổng và hỏi đơn vị cấp học bổng qua website hoặc số điện thoại chính thức.","B. Chuyển thử số tiền nhỏ vì thiệt hại có vẻ thấp hơn giá trị phần thưởng.","C. Kiểm tra trang thanh toán có logo, màu sắc và ngôn ngữ chuyên nghiệp hay không."],"correct_option":"A","explanation":"Khoản tiền nhỏ vẫn có thể là bước đầu của lừa đảo hoặc đánh cắp dữ liệu. Luôn xác minh yêu cầu qua một kênh do bạn tự tìm."}},{"trap_id":"R004_TRAP_04","ground_truth_start":266,"ground_truth_end":377,"matched_text":"Không liên hệ với văn phòng nhà trường vì quá trình xác minh được thực hiện bởi đối tác học bổng của chúng tôi.","weapon_type":["isolation_tactic"],"socratic_quiz":{"question":"Vì sao việc tự liên hệ nhà trường qua kênh chính thức là phép thử quan trọng nhất ở đây?","options":["A. Nhà trường có thể gia hạn thời hạn nên người nhận không cần đánh giá nội dung tin nhắn.","B. Một kênh tin cậy độc lập phá vỡ sự cô lập và xác nhận thông báo có tồn tại hay không.","C. Bộ phận hành chính có thể cho biết những học sinh khác đã trả phí bao nhiêu."],"correct_option":"B","explanation":"Yêu cầu giữ bí mật thường ngăn nạn nhân tiếp cận phép kiểm tra thực tế. Liên hệ độc lập giúp xác minh mà không phụ thuộc vào người gửi."}}]},"step_3_sorting_game":{"mechanic_type":"DRAG_AND_DROP_SORTING","context_text":"Hãy sắp xếp các bước theo đúng trình tự thời gian của đợt tấn công Phishing này để thấy rõ cách kẻ gian chiếm đoạt tài khoản và tiền bạc!","pool_items":[{"item_id":"R004_SORT_01","text":"Sinh viên nhận được tin nhắn khẩn cấp thông báo trúng học bổng bất ngờ."},{"item_id":"R004_SORT_02","text":"Sinh viên bấm vào đường link xác minh giả mạo đi kèm."},{"item_id":"R004_SORT_03","text":"Sinh viên nhập tên đăng nhập và mật khẩu tài khoản trường học vào trang giả."},{"item_id":"R004_SORT_04","text":"Hệ thống của kẻ lừa đảo âm thầm thu thập và lưu trữ thông tin đăng nhập."},{"item_id":"R004_SORT_05","text":"Trang web giả tiếp tục yêu cầu nhập mã OTP hoặc nộp khoản phí xác minh."},{"item_id":"R004_SORT_06","text":"Kẻ tấn công chạy ngầm việc đăng nhập và chiếm quyền điều khiển tài khoản trường học thật."},{"item_id":"R004_SORT_07","text":"Sinh viên bị mất hoàn toàn tài khoản trước cả khi nhận ra học bổng chỉ là một cú lừa."}],"correct_sequence":["R004_SORT_01","R004_SORT_02","R004_SORT_03","R004_SORT_04","R004_SORT_05","R004_SORT_06","R004_SORT_07"],"validation_feedback":{"success":"Xuất sắc! Kẻ lừa đảo không chỉ nhắm vào 49.000 VNĐ. Việc chiếm đoạt tài khoản trường học giúp chúng xâm nhập hệ thống nội bộ và tiếp tục mạo danh bạn để đi lừa những người khác.","failure":"Chưa chính xác. Hãy nhớ rằng các đòn Phishing luôn âm thầm đánh cắp thông tin tài khoản ngay khi bạn vừa bấm đăng nhập, trước cả khi bạn thực hiện bước chuyển tiền!"}}},"dialogue_trigger":{"question":"Nếu nhận được thông báo trúng học bổng hay quà tặng bất ngờ, quy trình kiểm chứng an toàn mà không bấm vào link lạ của bạn là gì?","mil_insight":"1. Bắt bài tâm lý: Học bổng thật không bao giờ bắt bạn đóng phí xác minh hay ép thời gian tính bằng giờ.\n2. Cảnh giác link lạ: Không truy cập vào các đường link đính kèm trong tin nhắn/email lạ.\n3. Kiểm chứng trực tiếp: Vào thẳng trang web chính thức của nhà trường hoặc liên hệ phòng Công tác sinh viên để xác minh."}}}],["$L3","$L4","$L5"],"$L6"]}],"isPartial":"$@7","staleTime":"$8","varyParams":null},{"rsc":"$L9","isPartial":"$@a","staleTime":"$8","varyParams":null},{"rsc":"$Lb","isPartial":"$@c","staleTime":"$8","varyParams":"$d"},{"rsc":"$Le","isPartial":"$@f","staleTime":"$8","varyParams":"$d"}],"isUpgradeableISRFallback":false,"a":"$@10","rootVaryParams":null,"needsRuntimeRequest":"$@11"}
