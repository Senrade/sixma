0:{"buildId":"JFSdapXluxcZ7WLb1GQKv","data":[{"rsc":["$","$1","c",{"children":[["$","$L2",null,{"caseData":{"level":"RED","case_id":"D001","title":"Lời cầu cứu tại tâm bão Helene","short_summary":"Một bức ảnh giữa dòng nước lũ thu hút hàng triệu lượt xem và làm bùng lên chỉ trích về công tác cứu hộ sau bão Helene. Bức ảnh thực sự chứng minh được điều gì?","duration_min":6,"skills":["Bằng chứng hình ảnh","Ngôn từ và tuyên bố","Chuỗi lan truyền thông tin"],"spotted_url":"/assets/images/D001/D001_spotted.png","theme":["Ứng phó thảm họa","Thông tin công chúng"],"story_context":"Sau bão Helene, bức ảnh giàu cảm xúc về một bé gái đang khóc và ôm chú chó con giữa dòng nước lũ lan truyền rộng rãi. Nhiều tài khoản dùng ảnh để chỉ trích công tác cứu hộ, nhưng không rõ nhiếp ảnh gia, địa điểm hay bài đăng gốc. Hãy xem bằng chứng thực sự cho phép kết luận điều gì.","source":{"title":"Seeing is no longer believing: Artificial Intelligence's impact on photojournalism","url":"https://jsk.stanford.edu/news/seeing-no-longer-believing-artificial-intelligences-impact-photojournalism","note":"Tình huống được phỏng theo phần thảo luận của David Carson về bức ảnh bé gái và chó con trong lũ do AI tạo ra, từng lan truyền trong thời gian bão Helene."},"modules":{"step_1_image_forensics":{"mechanic_type":"IMAGE_FORENSICS","image_url":"/assets/images/D001/D001_fake.webp","image_width":1024,"image_height":1024,"context_text":"Bức ảnh này được chia sẻ như bằng chứng tư liệu về việc giải cứu một em bé trong trận lũ thảm khốc sau bão Helene.","target_anomalies":[{"anomaly_id":"D001_IMG_01","name":"synthetic_facial_features","x_pct":49.8,"y_pct":30.1,"radius_pct":25.5,"socratic_quiz":{"question":"Sau khi nhận thấy khuôn mặt quá mịn và các chi tiết thiếu ổn định, kết luận nào là hợp lý nhất?","options":["A. Chỉ riêng dấu hiệu này đủ để khẳng định toàn bộ bức ảnh do AI tạo ra.","B. Đây là manh mối cần được kiểm tra cùng ảnh gốc, nguồn đăng và các chi tiết khác.","C. Hiệu ứng xử lý của máy ảnh giải thích được dấu hiệu nên không cần kiểm tra thêm."],"correct_option":"B","explanation":"Một dị thường thị giác là manh mối, không phải phán quyết. Hãy đối chiếu ảnh gốc, nguồn đăng và nhiều dấu hiệu độc lập trước khi kết luận."},"description":"Khuôn mặt bé gái có độ mịn nhân tạo bất thường; chi tiết quanh mắt, miệng và biểu cảm thiếu nhất quán."}]},"step_2_text_highlight":{"mechanic_type":"TEXT_HIGHLIGHT","simulated_post":{"author":"Mạng lưới Sự thật Bão lũ","time_posted":"18 phút trước","content":"Hãy nhìn bé gái đang ôm chặt chú chó con giữa dòng nước lũ. Truyền thông sẽ không bao giờ cho bạn thấy điều thực sự xảy ra sau cơn bão. Bức ảnh này chứng minh lực lượng cứu hộ đã bỏ mặc những gia đình như em trong khi các quan chức chỉ dàn dựng họp báo. Hãy chia sẻ ngay trước khi họ xóa bằng chứng."},"traps":[{"trap_id":"D001_TRAP_01","ground_truth_start":136,"ground_truth_end":253,"matched_text":"Bức ảnh này chứng minh lực lượng cứu hộ đã bỏ mặc những gia đình như em trong khi các quan chức chỉ dàn dựng họp báo.","weapon_type":["appeal_to_emotion","unsupported_inference"],"socratic_quiz":{"question":"Thông tin nào sẽ giúp kiểm tra trực tiếp nhất cáo buộc lực lượng cứu hộ bỏ mặc các gia đình?","options":["A. Số lượt chia sẻ và bình luận đồng tình với bài đăng trong ngày đầu tiên.","B. Hồ sơ cứu hộ, địa điểm, thời gian và tường thuật độc lập về chính khu vực được nhắc tới.","C. Một tài khoản khác đăng lại cùng bức ảnh với lời chú thích tương tự."],"correct_option":"B","explanation":"Một ảnh đơn lẻ không chứng minh được hoạt động của cả lực lượng cứu hộ. Cáo buộc phải được đối chiếu với hồ sơ và nguồn độc lập gắn đúng nơi, đúng thời điểm."}}]},"step_3_sorting_game":{"mechanic_type":"DRAG_AND_DROP_SORTING","context_text":"Bức ảnh giải cứu tổng hợp xuất hiện trong một chu kỳ tin tức diễn biến nhanh giữa thảm họa có thật và bắt đầu tác động đến cách mọi người đánh giá hoạt động ứng phó.","pool_items":[{"item_id":"D001_SORT_02","text":"Người xem phản ứng trước nỗi đau của em bé và đăng lại ảnh như bằng chứng rằng lực lượng cứu hộ đã bỏ mặc các gia đình."},{"item_id":"D001_SORT_03","text":"Sự lặp lại tách bức ảnh khỏi nguồn gốc không rõ ràng, khiến câu chuyện sai lệch cạnh tranh với thông tin đã được kiểm chứng về thảm họa."},{"item_id":"D001_SORT_01","text":"Một tài khoản đăng ảnh giải cứu tổng hợp kèm chú thích về thảm họa có thật nhưng không cung cấp nhiếp ảnh gia, địa điểm hay nguồn gốc ban đầu."}],"correct_sequence":["D001_SORT_01","D001_SORT_02","D001_SORT_03"],"validation_feedback":{"success":"Chính xác. Bức ảnh tổng hợp có sức ảnh hưởng nhờ một thảm họa có thật, cách diễn giải giàu cảm xúc và việc chia sẻ lặp lại. Khi nguồn gốc biến mất, câu chuyện bịa đặt có thể làm lu mờ thông tin đã được kiểm chứng về những con người có thật.","failure":"Chưa đúng. Hãy bắt đầu từ bức ảnh không có nguồn, tiếp theo là cách diễn giải cảm tính, rồi kết thúc bằng tác động của việc chia sẻ lặp lại đối với nguồn gốc và độ tin cậy của ảnh."}}},"dialogue_trigger":{"question":"Nếu một hình ảnh tạo ra phản ứng cảm xúc mạnh và dường như xác nhận điều bạn vốn tin, bạn cần kiểm tra gì trước khi chia sẻ?","mil_insight":"Hãy truy tìm lượt đăng sớm nhất có thể, xác định nhiếp ảnh gia hoặc người tạo, kiểm chứng ngày tháng và địa điểm qua các nguồn tin độc lập, đồng thời tìm thông tin xuất xứ như Content Credentials. Dị thường thị giác chỉ là manh mối, không phải kết luận cuối cùng: ảnh thật cũng có thể bị cáo buộc nhầm là do AI tạo ra."}}}],["$L3","$L4","$L5"],"$L6"]}],"isPartial":"$@7","staleTime":"$8","varyParams":null},{"rsc":"$L9","isPartial":"$@a","staleTime":"$8","varyParams":null},{"rsc":"$Lb","isPartial":"$@c","staleTime":"$8","varyParams":"$d"},{"rsc":"$Le","isPartial":"$@f","staleTime":"$8","varyParams":"$d"}],"isUpgradeableISRFallback":false,"a":"$@10","rootVaryParams":null,"needsRuntimeRequest":"$@11"}
