4:["$","html",null,{"lang":"vi","suppressHydrationWarning":true,"className":"h-full antialiased","children":["$","body",null,{"className":"flex min-h-full flex-col","children":["$","$Lf",null,{"initialLocale":"vi","localeOptions":[{"code":"en","label":"English"},{"code":"vi","label":"Tiếng Việt"},{"code":"es","label":"Español"}],"messages":{"nav.home":"Trang chủ","nav.cases":"Kho hồ sơ","nav.knowledge":"Kiến thức","nav.dashboard":"Tổng quan","nav.about":"Giới thiệu","nav.contact":"Liên hệ","nav.redeem":"Nhập mã","nav.signIn":"Đăng nhập","nav.menu":"Menu","nav.close":"Đóng","language.label":"Ngôn ngữ","language.vi":"Tiếng Việt","language.en":"English","nav.primaryAria":"Điều hướng chính","nav.mobileAria":"Điều hướng trên điện thoại","footer.tagline":"Giáo dục kỹ năng truyền thông qua tương tác dành cho học sinh, gia đình và nhà trường.","footer.prototype":"Bản thử nghiệm Hackathon","footer.independent":"Dự án độc lập","footer.explore":"Khám phá","footer.project":"Dự án","footer.achievements":"Thành tựu","footer.eventAccess":"Truy cập sự kiện","footer.faq":"Câu hỏi thường gặp","footer.privacy":"Bảo mật","footer.terms":"Điều khoản","footer.disclaimer":"SIXMA là sản phẩm dự thi UNESCO Youth Hackathon 2026. Đây là một dự án độc lập, không trực thuộc và không được tài trợ bởi UNESCO.","home.kicker":"Học kỹ năng truyền thông qua thực hành","home.description":"Một trò chơi tương tác về kỹ năng truyền thông dành cho học sinh, gia đình và giáo viên. Hãy thử giải quyết các tình huống thực tế trước khi gặp phải những áp lực tương tự ngoài đời.","home.playDemo":"Chơi thử bản demo","home.openCases":"Mở kho hồ sơ","home.redeem":"Kích hoạt thẻ","home.whatLabel":"SIXMA là gì?","home.whatTitle":"Tập thói quen dừng lại một nhịp trước khi tin hoặc chia sẻ","home.whatText":"SIXMA biến các mô típ thông tin sai lệch thành những cuộc điều tra ngắn. Người chơi sẽ kiểm tra nguồn tài liệu, nhận diện các thủ thuật thao túng và lần ra cách những lời đồn vô căn cứ lan truyền.","home.builtFor":"Dành cho ai?","home.students":"Học sinh","home.studentsText":"Xây dựng thói quen xác minh thông tin trước khi phản ứng với các nội dung viral.","home.families":"Gia đình","home.familiesText":"Cùng nhau thảo luận về các trò lừa đảo, áp lực tâm lý và những thông tin đáng ngờ.","home.educators":"Giáo viên","home.educatorsText":"Sử dụng các hồ sơ tinh gọn để hướng dẫn học sinh thực hành kỹ năng truyền thông.","home.howLabel":"Cách thức điều tra","home.step1":"Kiểm tra chi tiết","home.step1Text":"Tìm ra những điểm bất hợp lý thay vì tin ngay vào ấn tượng đầu tiên.","home.step2":"Đặt câu hỏi về nội dung","home.step2Text":"Nhận diện những từ ngữ mang tính xúi giục sự sợ hãi hoặc lập luận sai lệch.","home.step3":"Lần theo dấu vết","home.step3Text":"Tái hiện lại chuỗi chiêu trò thao túng người xem từ lúc cắn câu đến khi sập bẫy.","home.casesLabel":"Hồ sơ vụ việc","home.casesTitle":"Bắt đầu cuộc điều tra đầu tiên","home.browseAll":"Xem tất cả","welcome.eyebrow":"Phát hiện tín hiệu mới","welcome.title":"Bạn mới đến? Bắt đầu bằng một vụ án mẫu.","welcome.description":"Dành 6 phút thử làm điều tra viên và xem phản xạ ban đầu có đánh lừa bạn? Mở là chơi, không cần tài khoản.","welcome.play":"Bắt đầu điều tra","welcome.opening":"Đang tải vụ án...","welcome.cardPrompt":"Bạn có thẻ SIXMA? Hãy nhập mã để mở khóa câu chuyện.","welcome.redeem":"Nhập mã thẻ","welcome.about":"Về SIXMA","welcome.online":"Trực tuyến","demoStory.signal1":"Góc khuất đằng sau bức ảnh","demoStory.title1":"Bức ảnh cứu hộ này hoàn toàn là giả.","demoStory.body1":"Cô bé và chú chó đều do AI tạo ra. Dù vậy, nó vẫn tiếp cận hàng triệu người thật, âm thầm thao túng dư luận ngay trong một thảm họa có thật.","demoStory.sourceBefore":"Câu chuyện được ghi lại","demoStory.sourceLink":"tại đây","demoStory.sourceAfter":"bởi chương trình John S. Knight Journalism Fellowships thuộc Đại học Stanford.","demoStory.signal2":"Phản ứng tâm lý","demoStory.title2":"Bạn thấy bức ảnh vừa rồi có dễ nhận biết không?","demoStory.body2":"Tinh mắt đấy! Nhưng nhiều người lại không lướt qua kỹ đến vậy. Bức ảnh đánh trúng tâm lý và tạo cảm giác rất thật thoạt từ cái nhìn đầu tiên. Người ta chia sẻ nó vì lòng trắc ẩn và đó cũng chính là điểm tựa hoàn hảo cho các chiêu trò thao túng.","demoStory.signal3":"Góc nhìn toàn cảnh","demoStory.title3":"Đó mới chỉ là bề nổi của tảng băng.","demoStory.body3":"Nhận diện một bức ảnh AI có thể không khó, nhưng mối đe dọa thực sự nằm ở vô số câu chuyện được thêu dệt mỗi ngày trên mạng xã hội. Chúng bóp méo nhận thức của chúng ta nếu không có sự kiểm chứng.","demoStory.signal4":"Giải pháp từ SIXMA","demoStory.title4":"Một nhịp lặng ngắn có thể làm nên sự thay đổi lớn.","demoStory.body4":"SIXMA giúp bạn rèn luyện tư duy phản biện qua một thói quen đơn giản: chậm lại một nhịp, soi kỹ nguồn tin, đối chiếu bằng chứng và tự hỏi bản chất sự thật là gì.","demoStory.back":"Quay lại","demoStory.continue":"Tiếp tục","demoStory.feedbackPrompt":"Hãy giúp SIXMA cải thiện:","demoStory.feedbackLink":"Mở form Feedback tại đây.","demoStory.explore":"Khám phá SIXMA","demoStory.debrief":"D001 | Tổng kết","demoStory.progressAria":"Cảnh {{current}} trên {{total}}","home.faqLabel":"Hỏi và đáp","home.faqTitle":"Câu hỏi thường gặp","home.faqIntro":"Cách hoạt động của tiến trình hồ sơ, bài tập bằng chứng và dự án độc lập này.","faq.whatQuestion":"SIXMA là gì và hoạt động như thế nào?","faq.whatAnswer":"SIXMA dùng game để giúp bạn tạo thói quen: khựng lại một nhịp, soi kỹ nguồn tin và nhận biết các chiêu trò AI hay tin giả trước khi bấm \"Chia sẻ\".","faq.valueQuestion":"SIXMA giúp ích gì cho mình trong thực tế?","faq.valueAnswer":"Hãy coi đây như một mô hình luyện tư duy phản biện. Thông qua việc thực hành trên các tình huống thực tế, bạn sẽ hình thành phản xạ tự nhiên trong việc phát hiện deepfake, nhận diện các lỗi ngụy biện và chủ động phòng tránh các hành vi lừa đảo trực tuyến.","faq.insideQuestion":"Game này chơi như thế nào?","faq.insideAnswer":"Mỗi vụ án gồm 3 cơ chế: truy tìm sai sót thị giác trong ảnh AI, phân tích lỗi logic trong văn bản và hoàn thành bằng một câu đố kéo-thả tương tác. Chỉ mất vài phút là bạn đã có thể thử tài nhận diện và phá án!","faq.proofQuestion":"Phương pháp luyện tập này có thực sự hiệu quả?","faq.proofAnswer":"Có. Phương pháp này dựa trên nguyên lý tâm lý học Prebunking. Việc tiếp xúc với các kỹ thuật thao túng trong môi trường mô phỏng an toàn giúp bạn hình thành khả năng tự đề kháng khi tiếp cận thông tin trên không gian mạng.","faq.proQuestion":"Nếu mình vốn đã hay kiểm chứng nguồn tin thì có cần không?","faq.proAnswer":"Tuyệt vời! Tuy nhiên, công nghệ AI và deepfake đang biến đổi cực kỳ nhanh. SIXMA luôn ở đây bất cứ khi nào bạn muốn củng cố sự sắc bén khi lướt feed.","cases.kicker":"Kho điều tra","cases.title":"Kho hồ sơ","cases.intro":"Chọn một hồ sơ và giải quyết trọn vẹn ba học phần dựa trên phân tích bằng chứng.","cases.search":"Tìm kiếm hồ sơ điều tra","cases.searchPlaceholder":"Tiêu đề, mã hồ sơ, hoặc chủ đề","cases.gameMode":"Chế độ chơi","cases.fullCase":"Toàn bộ hồ sơ","cases.practice":"Thực hành theo học phần","cases.filter":"Lọc theo mức độ rủi ro","cases.comingSoon":"Sắp ra mắt","cases.practiceTitle":"Thực hành từng học phần riêng lẻ","cases.practiceText":"Chế độ thực hành học phần sẽ mở khóa sau khi bạn hoàn thành một hồ sơ trọn vẹn. Hiện tại, mọi cuộc điều tra đều tuân theo trình tự đầy đủ từ lúc tìm bằng chứng đến khi đưa ra lời giải thích.","cases.checking":"Đang kiểm tra quyền truy cập hồ sơ...","cases.empty":"Không có hồ sơ nào khớp với tìm kiếm này.","case.file":"Tài liệu điều tra","case.completed":"Đã hoàn thành","case.locked":"Đã khóa","case.evidenceSealed":"Hồ sơ đã niêm phong","case.sealedText":"Bản xem trước tài liệu sẽ được hé lộ sau khi hoàn thành.","case.evidence":"Bằng chứng","case.classified":"Tuyệt mật","case.minutes":"phút","case.modules":"học phần","case.unlock":"Hoàn thành {{caseId}} để mở khóa","case.review":"Xem lại hồ sơ","case.investigate":"Điều tra","case.imageAlt":"Bằng chứng cho {{title}}","case.hiddenSummary":"Hoàn thành trọn vẹn cuộc điều tra để mở khóa hồ sơ này.","case.previous":"hồ sơ trước","dashboard.kicker":"Thiết bị này","dashboard.title":"Bảng điều khiển điều tra","dashboard.intro":"Tiến trình của bạn trong phiên bản thử nghiệm này chỉ được lưu cục bộ trên trình duyệt.","learn.kicker":"Tạp chí hiểu biết truyền thông","learn.title":"Kho kiến thức","learn.intro":"Các bài phân tích và công cụ thực tế giúp bạn suy nghĩ sáng suốt về những nội dung truyền thông gặp hằng ngày.","learn.read":"Đọc","learn.minRead":"phút đọc","redeem.kicker":"Truy cập sự kiện bản demo","redeem.title":"Thử thẻ Fear Appeal","redeem.intro":"Dùng thẻ demo Fear Appeal để mở khóa một hồ sơ đặc biệt và nhận huy hiệu thẻ trên thiết bị này.","redeem.demoLabel":"Chế độ demo","redeem.deviceOnly":"Chỉ lưu trên thiết bị này","redeem.codeHelp":"Nhập chín ký tự hiển thị trên thẻ demo Fear Appeal. Dấu gạch nối sẽ được thêm tự động.","redeem.demoNotice":"Chỉ mã Fear Appeal hoạt động trong bản demo này. Quyền truy cập và huy hiệu chỉ được lưu trong trình duyệt; chưa có tài khoản hay xác thực máy chủ.","redeem.invalid":"Mã này chưa hoạt động trong bản demo. Hãy dùng mã Fear Appeal trong phần hướng dẫn.","redeem.storageUnavailable":"Trình duyệt đã chặn bộ nhớ cục bộ nên không thể duy trì trạng thái mở khóa.","redeem.unlocked":"Đã mở khóa {{caseId}} trên thiết bị này.","redeem.alreadyUnlocked":"{{caseId}} đã được mở khóa trên thiết bị này. Hệ thống không tạo quyền truy cập trùng lặp.","redeem.accessGranted":"Đã mở khóa hồ sơ đặc biệt","redeem.cardArtAlt":"Thẻ sự kiện SIXMA {{cardName}}","redeem.cardBackAlt":"Mặt sau thẻ sự kiện SIXMA có mã kích hoạt","redeem.startCase":"Bắt đầu S005","redeem.viewBadges":"Xem huy hiệu","redeem.tryCardLabel":"Thẻ tặng trong bản demo","redeem.guideTitle":"Thử thẻ Fear Appeal","redeem.demoCodeLabel":"Mã trên thẻ demo này","redeem.guideStepOne":"Nhập mã phía trên vào ô kích hoạt.","redeem.guideStepTwo":"Mở khóa S005 và hoàn thành ba bước kiểm chứng.","redeem.guideStepThree":"Kết thúc cuộc điều tra để thêm huy hiệu Fear Appeal vào bộ sưu tập.","special.checkingAccess":"Đang kiểm tra quyền truy cập sự kiện...","special.cardRequired":"Cần có thẻ sự kiện","special.lockedTitle":"Hồ sơ đặc biệt đang bị khóa","special.lockedBody":"Hãy kích hoạt thẻ sự kiện Fear Appeal trên thiết bị này trước khi mở S005.","special.redeemCard":"Nhập mã thẻ","metadata.siteTitle":"SIXMA | Kỹ năng truyền thông tương tác","metadata.siteTitleTemplate":"%s | SIXMA","metadata.siteDescription":"Các cuộc điều tra dưới dạng trò chơi giúp học sinh và gia đình nhận diện hình ảnh bị chỉnh sửa, các thủ thuật thao túng ngôn từ và các mánh khóe lừa đảo.","metadata.notFound.case":"Không tìm thấy hồ sơ","metadata.notFound.debrief":"Không tìm thấy báo cáo tổng kết","metadata.notFound.guide":"Không tìm thấy sổ tay hướng dẫn","metadata.notFound.mission":"Không tìm thấy nhiệm vụ","metadata.title.about":"Giới thiệu","metadata.title.achievements":"Thành tựu","metadata.title.caseHub":"Kho hồ sơ","metadata.title.contact":"Liên hệ","metadata.title.dashboard":"Bảng điều khiển","metadata.title.knowledgeHub":"Kho kiến thức","metadata.title.privacy":"Bảo mật","metadata.title.redeem":"Kích hoạt thẻ sự kiện","metadata.title.signIn":"Đăng nhập","metadata.title.signUp":"Tạo tài khoản","metadata.title.terms":"Điều khoản","metadata.title.mission":"Nhiệm vụ {{caseId}}","metadata.title.debrief":"Tổng kết {{caseId}}","home.heroImageAlt":"Một điều tra viên mạng đang xem xét bằng chứng kỹ thuật số","theme.light":"Sáng","theme.dark":"Tối","cases.gameModeAria":"Chọn chế độ chơi","cases.filterAll":"TẤT CẢ","cases.filterRed":"ĐỎ","cases.filterAmber":"VÀNG","cases.filterGreen":"XANH","briefing.begin":"Bắt đầu điều tra","briefing.back":"Quay lại kho hồ sơ","briefing.imageAlt":"Bằng chứng chính cho {{title}}","briefing.unverified":"Chưa được xác minh","briefing.label":"Tóm tắt hồ sơ","briefing.situation":"Tình huống","briefing.estimatedTime":"Thời gian dự kiến: {{minutes}} phút","debrief.kicker":"Tổng kết hồ sơ / {{caseId}}","debrief.complete":"Hoàn tất điều tra","debrief.summary":"Bạn đã xem xét bằng chứng, lật tẩy các lời lẽ thao túng và dựng lại toàn bộ chuỗi chiêu trò.","debrief.label":"Bài học từ vụ này","debrief.title":"Vận dụng vào thực tế","debrief.reflection":"Câu hỏi suy ngẫm","debrief.anotherCase":"Chọn hồ sơ khác","debrief.replay":"Chơi lại hồ sơ","debrief.knowledgeHub":"Kho kiến thức","mission.step.inspect":"Kiểm tra","mission.step.analyze":"Phân tích","mission.step.reconstruct":"Tái hiện","mission.exit":"Thoát nhiệm vụ","mission.progress":"Bước {{current}} trên {{total}}","mission.exitDialog.eyebrow":"Nhiệm vụ dang dở","mission.exitDialog.title":"Bạn muốn thoát nhiệm vụ này?","mission.exitDialog.description":"Tiến trình hiện tại sẽ không được lưu lại. Lần tới khi mở hồ sơ này, bạn sẽ phải bắt đầu lại từ Học phần 01.","mission.exitDialog.confirm":"Thoát nhiệm vụ","mission.exitDialog.cancel":"Tiếp tục nhiệm vụ","module.guide.aria":"Cách chơi: {{title}}","module.guide.label":"Cách chơi / Học phần {{number}}","module.guide.show":"Hiện các bước","module.guide.hide":"Ẩn các bước","module.image.title":"Giám định hình ảnh","module.image.summary":"Khoanh vùng một điểm bất thường rõ rệt và giải thích lý do tại sao nó đáng ngờ.","module.image.step1":"Kéo từ một rìa của vùng đáng ngờ sang rìa đối diện, hoặc nhấn vào tâm vùng đó.","module.image.step2":"Trả lời câu hỏi về bằng chứng để ghi nhận lại điểm bất thường.","module.text.title":"Phân tích ngôn từ","module.text.summary":"Bôi đen đoạn văn bản sử dụng mánh khóe thao túng tâm lý.","module.text.step1":"Chọn một đoạn ngắn nhất chứa yếu tố thao túng.","module.text.step2":"Xác nhận đoạn đã chọn, sau đó trả lời câu hỏi kiểm tra tư duy phản biện.","module.sort.title":"Tái hiện chuỗi sự kiện","module.sort.summary":"Sắp xếp từng giai đoạn của chiêu trò thao túng theo trình tự thời gian.","module.sort.step1":"Nhấn hoặc kéo thả từng bằng chứng vào các ô đánh số trên trục thời gian.","module.sort.step2":"Sắp xếp lại trục thời gian, nộp đáp án và chỉnh sửa nếu trình tự chưa chính xác.","module.common.criticalThinking":"Kiểm tra tư duy phản biện","module.common.correct":"Chính xác.","module.common.continue":"Tiếp tục","module.common.checkAnswer":"Kiểm tra đáp án","module.common.cancel":"Hủy","module.common.ok":"OK","module.common.next":"Tiếp theo","module.image.windowTitle":"Học phần 01 / Giám định Hình ảnh","module.image.canvasAria":"Hình ảnh bằng chứng. Hãy kéo qua hoặc nhấn vào một vùng đáng ngờ.","module.image.evidenceAlt":"Bằng chứng","module.image.circleAria":"Vòng tròn khoanh vùng bằng chứng hiện tại","module.image.userMarkAria":"Vùng bằng chứng bạn đã đánh dấu","module.image.anomalyFoundAria":"Đã tìm thấy {{name}}","module.image.drawError":"Vùng đánh dấu chưa trùng đủ gần với một vùng bằng chứng đã xác minh. Hãy quan sát lại và thử một vị trí khác.","module.image.quizError":"Giải thích này chưa khớp với điểm bất thường bạn vừa chọn. Hãy thử lại.","module.image.continueToText":"Tiếp tục sang phần Phân tích Văn bản","module.image.reviewEvidence":"Xem lại toàn bộ bằng chứng","module.image.log":"Nhật ký điều tra","module.image.evidenceFound":"Bằng chứng đã tìm thấy: {{found}} / {{total}}","module.image.allFound":"Đã ghi nhận toàn bộ các điểm bất thường trên ảnh. Chuyển sang phần phân tích văn bản.","module.image.reviewTitle":"Đối chiếu bằng chứng","module.image.reviewSummary":"Hãy đối chiếu các vùng bạn chọn với toàn bộ vùng bằng chứng đã xác minh trước khi tiếp tục.","module.image.userMarkLegend":"Vùng bạn chọn","module.image.verifiedAreaLegend":"Vùng bằng chứng đã xác minh","module.text.windowTitle":"Học phần 02 / Phân tích Ngôn từ","module.text.defaultQuestion":"Vì sao đoạn này lại đáng ngờ?","module.text.communityWire":"Tin tức cộng đồng","module.text.unverified":"Chưa được xác minh","module.text.postOptionsAria":"Tùy chọn bài viết","module.text.contentAria":"Nội dung bài viết mạng xã hội cần phân tích","module.text.publicPost":"Bài viết công khai","module.text.contextPending":"Đang chờ bối cảnh","module.text.evidenceMarks":"Đánh dấu bằng chứng {{completed}}/{{total}}","module.text.confirmSelection":"Bạn chốt chọn đoạn này?","module.text.overlapError":"Mức độ trùng khớp là {{overlap}}%. Cần chọn trúng ít nhất {{required}}% của một đoạn thao túng.","module.text.overlapSuccess":"Đã chọn phần có khả năng là chiêu trò (trùng khớp {{overlap}}%).","module.text.allFound":"Đã ghi nhận toàn bộ các thủ thuật thao túng.","module.text.quizError":"Câu trả lời này không khớp với thủ thuật thao túng bạn vừa chọn. Hãy thử lại.","module.text.correctAnswer":"Đáp án đúng:","module.sort.windowTitle":"Học phần 03 / Tái hiện Chuỗi sự kiện","module.sort.status.ready":"Sẵn sàng","module.sort.status.incorrect":"Chưa chính xác","module.sort.status.correct":"Chính xác","module.sort.defaultSuccess":"Trình tự chính xác.","module.sort.defaultFailure":"Trình tự này vẫn chưa đúng.","module.sort.caseContext":"Bối cảnh hồ sơ","module.sort.evidenceBank":"Kho bằng chứng","module.sort.timeline":"Trục thời gian","module.sort.dropHere":"Thả vào đây","module.sort.items":"Số lượng: {{count}}","module.sort.status":"Trạng thái: {{status}}","module.sort.complete":"Hoàn tất điều tra","module.hint.label":"Gợi ý {{current}}/{{total}}","module.hint.show":"Bạn cần gợi ý?","module.hint.next":"Xem gợi ý rõ hơn","module.hint.area.left":"bên trái","module.hint.area.center":"chính giữa","module.hint.area.right":"bên phải","module.hint.area.top":"phía trên","module.hint.area.middle":"khoảng giữa","module.hint.area.bottom":"phía dưới","module.hint.image.inspect":"So sánh chữ viết, hình dạng lặp lại, ánh sáng và các điểm nối vật lý. Tìm chi tiết không tuân theo logic chung của cảnh.","module.hint.image.focus":"Thu hẹp tìm kiếm vào vùng {{vertical}} - {{horizontal}}. Chỉ đánh dấu chi tiết đáng ngờ, không khoanh cả ảnh.","module.hint.quiz.compareEvidence":"Ưu tiên đáp án dựa trên điều quan sát được trong ảnh, thay vì điều chỉ có vẻ lạ.","module.hint.quiz.rejectAssumption":"Hãy hỏi đáp án nào cần ít giả định chưa được chứng minh nhất.","module.hint.quiz.identifyEffect":"Tập trung vào điều câu chữ khiến người đọc vội tin, cảm thấy hoặc làm trước khi kiểm chứng.","module.hint.text.inspect":"Tìm đoạn ngắn nhất biến điều chưa chắc thành chắc chắn, gán động cơ hoặc thúc ép người đọc hành động.","module.hint.text.focus":"Thủ thuật tiếp theo nằm gần phần {{region}} bài viết. Chọn trọn vẹn mệnh đề, không lấy phần dẫn thừa.","module.hint.text.region.start":"đầu","module.hint.text.region.middle":"giữa","module.hint.text.region.end":"cuối","module.hint.sort.inspect":"Tách sự kiện gây chú ý, sự kiện tăng áp lực và yêu cầu hành động rủi ro. Nguyên nhân phải đứng trước hệ quả.","module.hint.sort.first":"Bắt đầu bằng sự kiện này rồi suy ra điều nó tạo điều kiện xảy ra: {{item}}","dashboard.loading":"Đang tải tiến trình từ thiết bị này...","dashboard.completed":"Đã hoàn thành","dashboard.inProgress":"Đang thực hiện","dashboard.remaining":"Chưa bắt đầu","dashboard.progressTitle":"Tiến độ điều tra","dashboard.progressDescription":"Theo dõi mức độ nhất quán khi bạn kiểm tra hình ảnh, ngôn từ và chuỗi thông tin trong năm hồ sơ cốt lõi.","dashboard.learningPath":"Lộ trình học cốt lõi","dashboard.caseProgress":"Đã hoàn thành {{completed}}/{{total}} hồ sơ","dashboard.achievementsTitle":"Thành tựu học tập","dashboard.achievementsDescription":"Các cột mốc ghi nhận việc vận dụng phương pháp kiểm chứng trong những bối cảnh sai lệch thông tin mới.","dashboard.viewAchievements":"Mở trang thành tựu","achievements.kicker":"Thiết bị này","achievements.title":"Thành tựu","achievements.intro":"Theo dõi riêng các cột mốc học tập và huy hiệu thẻ sự kiện đã thu thập trên thiết bị này.","achievements.tabs.learning":"Thành tựu học tập","achievements.tabs.badges":"Bộ sưu tập huy hiệu","achievements.earned":"Đã đạt","achievements.locked":"Đã khóa","achievements.caseProgress":"Hồ sơ khác nhau","achievements.evidence.title":"Hoàn tất vòng kiểm chứng","achievements.evidence.description":"Hoàn thành một cuộc điều tra bằng cách kiểm tra bằng chứng hình ảnh, ngôn từ thao túng và chuỗi lan truyền thông tin.","achievements.transfer.title":"Vận dụng phương pháp","achievements.transfer.description":"Hoàn thành ba hồ sơ khác nhau để áp dụng cùng một phương pháp kiểm chứng trong nhiều bối cảnh sai lệch thông tin.","achievements.investigator.title":"Điều tra viên toàn diện","achievements.investigator.description":"Hoàn thành năm hồ sơ cốt lõi khác nhau để tiếp xúc với toàn bộ nhóm tình huống thao túng.","achievements.badgeCount":"Đã thu thập {{current}}/{{total}} huy hiệu","achievements.badgeCollectionIntro":"Huy hiệu thẻ ghi nhận những cuộc điều tra đặc biệt đã hoàn thành thông qua thẻ sự kiện được kích hoạt.","achievements.badgeLockedHint":"Kích hoạt thẻ Fear Appeal và hoàn thành S005 để nhận huy hiệu này.","achievements.redeemCard":"Thử Fear Appeal","badge.earned":"Đã nhận huy hiệu","badge.signalBreaker.title":"Fear Appeal","badge.signalBreaker.description":"Đã hoàn thành S005 và học cách kiểm chứng bằng chứng trước khi phản ứng với những tuyên bố kích động cảm xúc.","badge.viewCollection":"Xem bộ sưu tập huy hiệu","case.eventCard":"Thẻ sự kiện","case.redeemToUnlock":"Nhập mã để mở khóa","form.signIn.message":"Tính năng đăng nhập chưa được kết nối trong bản thử nghiệm này. Mọi thông tin của bạn đều không bị gửi đi hay lưu trữ.","form.signUp.message":"Tính năng tạo tài khoản chưa được kết nối trong bản thử nghiệm này. Không có dữ liệu cá nhân nào bị gửi đi hay lưu trữ.","form.redeem.message":"Việc kích hoạt mã yêu cầu dịch vụ tài khoản bảo mật. Mã này chưa được gửi đi hay bị đánh dấu là đã sử dụng.","form.contact.message":"Tính năng gửi tin nhắn chưa được kết nối trong bản thử nghiệm này. Tin nhắn của bạn chưa được gửi đi hay lưu trữ.","form.eventCode":"Mã thẻ sự kiện","form.checkCode":"Kiểm tra mã","form.name":"Tên","form.email":"Email","form.message":"Tin nhắn","form.password":"Mật khẩu","form.displayName":"Tên hiển thị","form.sendMessage":"Gửi tin nhắn","form.signIn":"Đăng nhập","form.createAccount":"Tạo tài khoản","form.codePlaceholder":"XXX-XXX-XXX","form.emailPlaceholder":"ban@example.com","auth.eyebrow":"Truy cập tài khoản","auth.signIn.title":"Đăng nhập","auth.signIn.intro":"Dịch vụ tài khoản sẽ được ra mắt trong giai đoạn phát triển hệ thống tiếp theo. Bạn vẫn có thể chơi bản demo mà không cần tài khoản.","auth.signIn.prompt":"Bạn là người mới?","auth.signIn.link":"Tạo tài khoản","auth.signUp.title":"Tạo tài khoản","auth.signUp.intro":"Giao diện này đã sẵn sàng để tích hợp nhà cung cấp dịch vụ bảo mật, nhưng phiên bản MVP tĩnh này sẽ không thu thập dữ liệu tài khoản.","auth.signUp.prompt":"Bạn đã có tài khoản?","auth.signUp.link":"Đăng nhập","about.eyebrow":"Về dự án","about.title":"Rèn tư duy phản biện dưới áp lực","about.intro":"SIXMA là bản thử nghiệm tương tác về kỹ năng truyền thông và thông tin dành cho học sinh, gia đình và giáo viên.","about.section1.title":"Tại sao lại chọn cơ chế game này","about.section1.body":"Việc học thuộc lòng vài gạch đầu dòng hiếm khi đánh bại được thông tin sai lệch. Mỗi hồ sơ sẽ yêu cầu người học tự kiểm tra bằng chứng, đưa ra nhận định, nhận phản hồi và giải thích lập luận đằng sau phán đoán đó.","about.section2.title":"Thiết kế để thực hành","about.section2.body":"Cấu trúc của hồ sơ kết hợp giám định hình ảnh, phân tích ngôn từ và tái hiện chuỗi thao túng. Những kỹ năng này có thể ứng dụng ngay khi gặp các bài đăng đáng ngờ, trò lừa đảo, truyền thông bẩn và những tin nhắn hối thúc ngoài đời thực.","about.section3.title":"Trạng thái dự án","about.section3.body":"Đây là một dự án độc lập dành cho cuộc thi Hackathon. Các câu hỏi trong hồ sơ và nội dung bài học vẫn đang trong quá trình được đánh giá.","contact.eyebrow":"Liên hệ dự án","contact.title":"Liên hệ","contact.intro":"Mọi câu hỏi, phản hồi từ lớp học và các ý tưởng hợp tác đều giúp chúng tôi hoàn thiện phiên bản tiếp theo.","contact.send":"Gửi tin nhắn","privacy.eyebrow":"Chính sách của bản thử nghiệm","privacy.title":"Thông báo bảo mật","privacy.intro":"Thông báo này mô tả cơ chế của bản dựng thử nghiệm tĩnh hiện tại, không đại diện cho các dịch vụ chính thức có tính năng tạo tài khoản sau này.","privacy.section1.title":"Dữ liệu được lưu trên thiết bị này","privacy.section1.body":"Bản thử nghiệm lưu tiến trình, thời gian hoàn thành hồ sơ, quyền truy cập sự kiện demo và huy hiệu trong bộ nhớ cục bộ của trình duyệt. Ứng dụng hiện tại không truyền thông tin này về máy chủ của dự án.","privacy.section2.title":"Biểu mẫu và tài khoản","privacy.section2.body":"Các màn hình tài khoản và liên hệ chỉ là giao diện xem trước và không gửi dữ liệu. Mã sự kiện được đối chiếu cục bộ với danh sách demo; mã gốc không được lưu lại. Tuyệt đối không nhập thông tin nhạy cảm vào một bản thử nghiệm.","privacy.section3.title":"Máy chủ của bên thứ ba","privacy.section3.body":"Nền tảng lưu trữ web có thể xử lý các thông tin truy cập tiêu chuẩn như địa chỉ IP và siêu dữ liệu trình duyệt. Trước khi thu thập dữ liệu tài khoản trong bản phát hành chính thức, dự án phải công bố rõ nền tảng lưu trữ, thời hạn lưu trữ, cơ sở pháp lý và quyền của người dùng.","privacy.section4.title":"Trước khi phát hành chính thức","privacy.section4.body":"Bản nháp này phải được thay thế bằng một chính sách quyền riêng tư phù hợp với pháp luật hiện hành sau khi chốt xong nhà cung cấp dịch vụ xác thực, các công cụ phân tích dữ liệu, yêu cầu độ tuổi người dùng và quy tắc lưu trữ dữ liệu.","terms.eyebrow":"Điều khoản bản thử nghiệm","terms.title":"Điều khoản sử dụng","terms.intro":"Các điều khoản đơn giản hóa này chỉ áp dụng riêng cho phiên bản trình diễn giáo dục hiện tại.","terms.section1.title":"Bản thử nghiệm giáo dục","terms.section1.body":"SIXMA cung cấp các bài thực hành và kiến thức tổng quan về kỹ năng truyền thông. Nền tảng không có chức năng xác thực độ tin cậy của một hình ảnh, một bài viết hay một cá nhân cụ thể nào trên mạng.","terms.section2.title":"Nội dung bản nháp","terms.section2.body":"Các hồ sơ có thể chứa những kịch bản hư cấu và các câu hỏi thử nghiệm chưa phải là phiên bản cuối cùng. Vui lòng không dùng bản thử nghiệm này để thay thế cho các lời khuyên chuyên môn về an toàn thông tin.","terms.section3.title":"Quy định sử dụng","terms.section3.body":"Không cố ý nhập thông tin cá nhân của người khác, phá hoại dịch vụ, hoặc sử dụng các thành tựu của bản thử nghiệm này như một chứng chỉ chính quy.","terms.section4.title":"Đánh giá cho bản phát hành","terms.section4.body":"Để ra mắt bản chính thức có hỗ trợ tài khoản, nền tảng cần phải được đánh giá pháp lý đầy đủ, xây dựng quy trình hỗ trợ người dùng, tuân thủ các quy định về độ tuổi và cung cấp thông tin chi tiết về đơn vị vận hành.","article.minuteRead":"{{minutes}} phút đọc","article.back":"Quay lại kho kiến thức"},"children":"$L10"}]}]}]
