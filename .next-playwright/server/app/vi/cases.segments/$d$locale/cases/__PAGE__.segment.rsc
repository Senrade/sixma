0:{"buildId":"JFSdapXluxcZ7WLb1GQKv","data":[{"rsc":["$","$1","c",{"children":[["$","div",null,{"className":"flex min-h-screen flex-col bg-background text-foreground","children":[["$","$L2",null,{}],["$","main",null,{"className":"flex-1","children":["$","section",null,{"className":"case-grid-bg min-h-[70vh] py-12 sm:py-16","children":["$","div",null,{"className":"mx-auto max-w-7xl px-4 sm:px-6","children":[["$","$L3",null,{"kicker":"cases.kicker","title":"cases.title","description":"cases.intro"}],["$","$L4",null,{"cases":[{"level":"RED","case_id":"D001","title":"Lời cầu cứu tại tâm bão Helene","short_summary":"Một bức ảnh giữa dòng nước lũ thu hút hàng triệu lượt xem và làm bùng lên chỉ trích về công tác cứu hộ sau bão Helene. Bức ảnh thực sự chứng minh được điều gì?","duration_min":6,"skills":["Bằng chứng hình ảnh","Ngôn từ và tuyên bố","Chuỗi lan truyền thông tin"],"spotted_url":"/assets/images/D001/D001_spotted.png","theme":["Ứng phó thảm họa","Thông tin công chúng"],"story_context":"Sau bão Helene, bức ảnh giàu cảm xúc về một bé gái đang khóc và ôm chú chó con giữa dòng nước lũ lan truyền rộng rãi. Nhiều tài khoản dùng ảnh để chỉ trích công tác cứu hộ, nhưng không rõ nhiếp ảnh gia, địa điểm hay bài đăng gốc. Hãy xem bằng chứng thực sự cho phép kết luận điều gì.","source":{"title":"Seeing is no longer believing: Artificial Intelligence's impact on photojournalism","url":"https://jsk.stanford.edu/news/seeing-no-longer-believing-artificial-intelligences-impact-photojournalism","note":"Tình huống được phỏng theo phần thảo luận của David Carson về bức ảnh bé gái và chó con trong lũ do AI tạo ra, từng lan truyền trong thời gian bão Helene."},"modules":{"step_1_image_forensics":{"mechanic_type":"IMAGE_FORENSICS","image_url":"/assets/images/D001/D001_fake.webp","image_width":1024,"image_height":1024,"context_text":"Bức ảnh này được chia sẻ như bằng chứng tư liệu về việc giải cứu một em bé trong trận lũ thảm khốc sau bão Helene.","target_anomalies":[{"anomaly_id":"D001_IMG_01","name":"synthetic_facial_features","x_pct":49.8,"y_pct":30.1,"radius_pct":25.5,"socratic_quiz":{"question":"Sau khi nhận thấy khuôn mặt quá mịn và các chi tiết thiếu ổn định, kết luận nào là hợp lý nhất?","options":["A. Chỉ riêng dấu hiệu này đủ để khẳng định toàn bộ bức ảnh do AI tạo ra.","B. Đây là manh mối cần được kiểm tra cùng ảnh gốc, nguồn đăng và các chi tiết khác.","C. Hiệu ứng xử lý của máy ảnh giải thích được dấu hiệu nên không cần kiểm tra thêm."],"correct_option":"B","explanation":"Một dị thường thị giác là manh mối, không phải phán quyết. Hãy đối chiếu ảnh gốc, nguồn đăng và nhiều dấu hiệu độc lập trước khi kết luận."},"description":"Khuôn mặt bé gái có độ mịn nhân tạo bất thường; chi tiết quanh mắt, miệng và biểu cảm thiếu nhất quán."}]},"step_2_text_highlight":{"mechanic_type":"TEXT_HIGHLIGHT","simulated_post":{"author":"Mạng lưới Sự thật Bão lũ","time_posted":"18 phút trước","content":"Hãy nhìn bé gái đang ôm chặt chú chó con giữa dòng nước lũ. Truyền thông sẽ không bao giờ cho bạn thấy điều thực sự xảy ra sau cơn bão. Bức ảnh này chứng minh lực lượng cứu hộ đã bỏ mặc những gia đình như em trong khi các quan chức chỉ dàn dựng họp báo. Hãy chia sẻ ngay trước khi họ xóa bằng chứng."},"traps":[{"trap_id":"D001_TRAP_01","ground_truth_start":136,"ground_truth_end":253,"matched_text":"Bức ảnh này chứng minh lực lượng cứu hộ đã bỏ mặc những gia đình như em trong khi các quan chức chỉ dàn dựng họp báo.","weapon_type":["appeal_to_emotion","unsupported_inference"],"socratic_quiz":{"question":"Thông tin nào sẽ giúp kiểm tra trực tiếp nhất cáo buộc lực lượng cứu hộ bỏ mặc các gia đình?","options":["A. Số lượt chia sẻ và bình luận đồng tình với bài đăng trong ngày đầu tiên.","B. Hồ sơ cứu hộ, địa điểm, thời gian và tường thuật độc lập về chính khu vực được nhắc tới.","C. Một tài khoản khác đăng lại cùng bức ảnh với lời chú thích tương tự."],"correct_option":"B","explanation":"Một ảnh đơn lẻ không chứng minh được hoạt động của cả lực lượng cứu hộ. Cáo buộc phải được đối chiếu với hồ sơ và nguồn độc lập gắn đúng nơi, đúng thời điểm."}}]},"step_3_sorting_game":{"mechanic_type":"DRAG_AND_DROP_SORTING","context_text":"Bức ảnh giải cứu tổng hợp xuất hiện trong một chu kỳ tin tức diễn biến nhanh giữa thảm họa có thật và bắt đầu tác động đến cách mọi người đánh giá hoạt động ứng phó.","pool_items":[{"item_id":"D001_SORT_02","text":"Người xem phản ứng trước nỗi đau của em bé và đăng lại ảnh như bằng chứng rằng lực lượng cứu hộ đã bỏ mặc các gia đình."},{"item_id":"D001_SORT_03","text":"Sự lặp lại tách bức ảnh khỏi nguồn gốc không rõ ràng, khiến câu chuyện sai lệch cạnh tranh với thông tin đã được kiểm chứng về thảm họa."},{"item_id":"D001_SORT_01","text":"Một tài khoản đăng ảnh giải cứu tổng hợp kèm chú thích về thảm họa có thật nhưng không cung cấp nhiếp ảnh gia, địa điểm hay nguồn gốc ban đầu."}],"correct_sequence":["D001_SORT_01","D001_SORT_02","D001_SORT_03"],"validation_feedback":{"success":"Chính xác. Bức ảnh tổng hợp có sức ảnh hưởng nhờ một thảm họa có thật, cách diễn giải giàu cảm xúc và việc chia sẻ lặp lại. Khi nguồn gốc biến mất, câu chuyện bịa đặt có thể làm lu mờ thông tin đã được kiểm chứng về những con người có thật.","failure":"Chưa đúng. Hãy bắt đầu từ bức ảnh không có nguồn, tiếp theo là cách diễn giải cảm tính, rồi kết thúc bằng tác động của việc chia sẻ lặp lại đối với nguồn gốc và độ tin cậy của ảnh."}}},"dialogue_trigger":{"question":"Nếu một hình ảnh tạo ra phản ứng cảm xúc mạnh và dường như xác nhận điều bạn vốn tin, bạn cần kiểm tra gì trước khi chia sẻ?","mil_insight":"Hãy truy tìm lượt đăng sớm nhất có thể, xác định nhiếp ảnh gia hoặc người tạo, kiểm chứng ngày tháng và địa điểm qua các nguồn tin độc lập, đồng thời tìm thông tin xuất xứ như Content Credentials. Dị thường thị giác chỉ là manh mối, không phải kết luận cuối cùng: ảnh thật cũng có thể bị cáo buộc nhầm là do AI tạo ra."}},{"level":"RED","case_id":"R001","title":"AI giảng dạy thay giáo viên?","short_summary":"Một bức ảnh lớp học làm bùng lên tranh luận về cách công nghệ được sử dụng quanh học sinh, trong khi bài đăng nóng bỏng lan nhanh hơn câu trả lời.","duration_min":15,"skills":["Bằng chứng hình ảnh","Ngôn từ và tuyên bố","Chuỗi lan truyền thông tin"],"spotted_url":"/assets/images/R001/R001_spotted.jpg","theme":["Giáo dục","Công nghệ"],"story_context":"Học sinh và phụ huynh đang chia sẻ một bức ảnh lớp học kèm tuyên bố về việc giám sát và đánh giá tự động. Cuộc tranh luận ngày càng căng thẳng, và nhiều bài đăng dẫn người đọc tới thông tin bổ sung. Hãy xem xét tài liệu trước khi quyết định chuyện gì đang xảy ra.","modules":{"step_1_image_forensics":{"mechanic_type":"IMAGE_FORENSICS","image_url":"/assets/images/R001/R001_fake.jpg","image_width":1000,"image_height":1000,"context_text":"Bức ảnh rò rỉ đính kèm bài đăng gây tranh cãi được cho là 'bằng chứng AI đang giám sát và đánh giá học sinh trong lớp học'.","target_anomalies":[{"anomaly_id":"R001_IMG_01","name":"gibberish_text","x_pct":57.4,"y_pct":18.7,"radius_pct":14.5,"socratic_quiz":{"question":"Cách kiểm tra nào phân biệt tốt nhất chữ bị lỗi do tạo ảnh với chữ mờ do chất lượng ảnh thấp?","options":["A. So độ sáng màn hình với các vùng sáng khác trong lớp.","B. Kiểm tra xem nét chữ có tạo thành ký tự nhất quán ở nhiều vị trí hay không.","C. Xác định màn hình có được đặt đúng vị trí thường thấy trong lớp học hay không."],"correct_option":"B","explanation":"Ảnh mờ thường làm mất chi tiết một cách tương đối đồng đều; ký tự biến dạng khác nhau từng chỗ là dấu hiệu đáng kiểm tra với ảnh nguồn."},"description":"Dòng chữ vô nghĩa, méo mó và không thể đọc được hiển thị trên bảng điện tử."},{"anomaly_id":"R001_IMG_02","name":"clipping_students","x_pct":57.8,"y_pct":68.6,"radius_pct":15.7,"socratic_quiz":{"question":"Nhìn nhóm học sinh ở giữa, phía trước ảnh. Chi tiết nào thực sự không ổn?","options":["A. Các học sinh ngồi sát nhau nên một số bạn che khuất một phần cơ thể của nhau.","B. Đầu và vai của học sinh nhỏ ở giữa hòa vào những người xung quanh, khiến khó xác định cơ thể của từng người kết thúc ở đâu.","C. Khuôn mặt các học sinh bị mờ vì máy ảnh đang lấy nét vào robot."],"correct_option":"B","explanation":"Vị trí của các học sinh ở khu vực này bị chồng chéo lên nhau và không tuân theo một quy luật nhất định. Có 2 cái bàn nhưng  thay vì được che khuất rõ ràng thì vị trí của các học sinh lại không hợp lý. Chính chỗ hòa lẫn đó là dấu hiệu bất thường."},"description":"Các học sinh ở trung tâm tiền cảnh chồng lấn bất thường và hòa vào nhau."}]},"step_2_text_highlight":{"mechanic_type":"TEXT_HIGHLIGHT","simulated_post":{"author":"Cộng đồng Phụ huynh và Giáo dục","time_posted":"2 giờ trước","content":"Vừa biết Bộ Giáo dục sẽ thí điểm một trợ lý học tập AI mới tại một số trường vào học kỳ tới. Thành thật mà nói, đây có vẻ là một bước đi bí mật nhằm loại bỏ hoàn toàn giáo viên thật. Rõ ràng các tập đoàn công nghệ lớn chỉ đang muốn tự động hóa toàn bộ giáo dục để khai thác dữ liệu học sinh vì lợi nhuận. Ngay cả Giáo sư Tan cũng nói trong báo cáo mới nhất rằng 'AI hiện đang kiểm soát hoàn toàn lớp học'. Nếu phụ huynh không đứng lên và tẩy chay việc triển khai này ngay lập tức, con em chúng ta sẽ mất hoàn toàn khả năng tư duy phản biện!"},"traps":[{"trap_id":"R001_TRAP_01","ground_truth_start":93,"ground_truth_end":182,"matched_text":"Thành thật mà nói, đây có vẻ là một bước đi bí mật nhằm loại bỏ hoàn toàn giáo viên thật.","weapon_type":["conspiracy_theory","intentionality_bias"],"socratic_quiz":{"question":"Bằng chứng nào cần có trước khi kết luận chương trình thí điểm nhằm thay thế giáo viên?","options":["A. Nhiều phụ huynh cho biết họ lo ngại AI sẽ ảnh hưởng đến vai trò của giáo viên.","B. Chương trình có dùng một công cụ AI trong một số hoạt động học tập.","C. Kế hoạch nhân sự, ngân sách hoặc tài liệu triển khai cho thấy vị trí giáo viên thực sự bị loại bỏ."],"correct_option":"C","explanation":"Sự tồn tại của công cụ AI không tự chứng minh mục đích thay thế giáo viên. Kết luận về động cơ cần tài liệu hoặc hành động cụ thể, không chỉ sự lo ngại."}},{"trap_id":"R001_TRAP_02","ground_truth_start":183,"ground_truth_end":304,"matched_text":"Rõ ràng các tập đoàn công nghệ lớn chỉ đang muốn tự động hóa toàn bộ giáo dục để khai thác dữ liệu học sinh vì lợi nhuận.","weapon_type":["attribution_bias","overgeneralization","conspiracy_theory"],"socratic_quiz":{"question":"Phản ứng nào giữ được tư duy độc lập trước cụm từ 'Rõ ràng'?","options":["A. Tạm tin vì người viết diễn đạt chắc chắn và có vẻ nắm thông tin nội bộ.","B. Bác bỏ toàn bộ công nghệ giáo dục vì rủi ro thu thập dữ liệu là có thật.","C. Tách giọng điệu chắc chắn khỏi nội dung và yêu cầu bằng chứng cụ thể về dữ liệu cùng động cơ."],"correct_option":"C","explanation":"Giọng điệu tự tin không làm tăng chất lượng bằng chứng. Hãy tách từng khẳng định và yêu cầu nguồn kiểm chứng cho từng phần."}},{"trap_id":"R001_TRAP_03","ground_truth_start":406,"ground_truth_end":540,"matched_text":"Nếu phụ huynh không đứng lên và tẩy chay việc triển khai này ngay lập tức, con em chúng ta sẽ mất hoàn toàn khả năng tư duy phản biện!","weapon_type":["false_dilemma","slippery_slope"],"socratic_quiz":{"push_question":"Câu kết đã loại bỏ những khả năng hợp lý nào khỏi lựa chọn của phụ huynh?","options":["A. Khả năng ủng hộ chương trình ngay mà không cần điều kiện hay giám sát bổ sung.","B. Khả năng tìm hiểu, đặt điều kiện bảo vệ, thử nghiệm có giám sát hoặc phản đối một phần của chương trình.","C. Khả năng tẩy chay chương trình nếu sau này xuất hiện bằng chứng về rủi ro nghiêm trọng."],"correct_option":"B","explanation":"Câu viết chỉ chừa hai cực đoan: tẩy chay ngay hoặc chịu thảm họa. Nhận ra các lựa chọn trung gian giúp người đọc thoát khỏi khung ép buộc."}}]},"step_3_sorting_game":{"mechanic_type":"DRAG_AND_DROP_SORTING","context_text":"Sự hoảng loạn do bài đăng gây ra đã dẫn đến một email lừa đảo nhắm vào phụ huynh.","pool_items":[{"item_id":"R001_SORT_01","text":"Nhấp vào liên kết bảo mật bên dưới để trả phí xử lý 50.000 đồng và xác minh quyền từ chối tham gia."},{"item_id":"R001_SORT_02","text":"CẢNH BÁO: Dữ liệu cá nhân của con bạn hiện đã được lên lịch đồng bộ với hệ thống AI của Bộ."},{"item_id":"R001_SORT_03","text":"Để bảo vệ quyền riêng tư và xóa tên con khỏi dự án, phụ huynh phải hoàn thành 'Biểu mẫu từ chối' trong vòng 24 giờ."}],"correct_sequence":["R001_SORT_02","R001_SORT_03","R001_SORT_01"],"validation_feedback":{"success":"Chính xác. Bạn đã giải mã chuỗi thao túng tâm lý kinh điển: tạo sợ hãi và khẩn cấp (Mồi nhử) -> đưa ra giải pháp cấp bách (Chuyển hướng) -> cài bẫy để lấy tiền hoặc dữ liệu cá nhân (Cạm bẫy).","failure":"Logic chưa đúng. Các cuộc lừa đảo hiếm khi đòi tiền ngay từ đầu. Chúng thường bắt đầu bằng một cuộc khủng hoảng giả để làm tê liệt tư duy phản biện của nạn nhân."}}},"dialogue_trigger":{"question":"Hãy hỏi Giáo viên/Phụ huynh: nếu một tin nhắn từ trường yêu cầu phụ huynh nhấp vào liên kết lạ và thanh toán gấp để 'bảo vệ dữ liệu học tập của con', dấu hiệu then chốt nào chứng minh đó là lừa đảo?","mil_insight":"Hãy giúp phụ huynh và học sinh đối chiếu tin nhắn với quy trình hành chính chuẩn: các cơ sở giáo dục hợp pháp không dùng áp lực thời gian như thời hạn 24 giờ hoặc liên kết thanh toán không chính thức để xử lý vấn đề bảo mật."}},{"level":"RED","case_id":"R002","title":"Khiếu nại từ căng tin","short_summary":"Một bức ảnh khay cơm đáng lo ngại được gửi tới nhà trường, kèm yêu cầu phản hồi ngay trước khi câu chuyện bị công khai.","duration_min":12,"skills":["Bằng chứng hình ảnh","Ngôn từ và tuyên bố","Chuỗi lan truyền thông tin"],"spotted_url":"/assets/images/R002/R002_spotted.png","theme":["Đời sống học đường","An toàn thực phẩm"],"story_context":"Một tin nhắn ẩn danh đính kèm ảnh từ căng tin và cảnh báo sẽ công khai sự việc nếu nhà trường không phản hồi trước hạn. Nhà trường cần xác định hình ảnh và ngôn từ thực sự chứng minh được điều gì trước khi hành động.","modules":{"step_1_image_forensics":{"mechanic_type":"IMAGE_FORENSICS","image_url":"/assets/images/R002/R002_fake.png","image_width":1020,"image_height":680,"context_text":"Bức ảnh rò rỉ đính kèm email tống tiền được cho là chụp \"một con gián ghê tởm trong khay thức ăn của căng tin trường trung học\".","target_anomalies":[{"anomaly_id":"R002_IMG_01","name":"fake_cockroach_insertion","x_pct":69.5,"y_pct":73,"radius_pct":13.5,"socratic_quiz":{"question":"Phép so sánh nào giúp kiểm tra tốt nhất liệu con gián có thuộc về khung cảnh này một cách tự nhiên hay không?","options":["A. Đo chiều dài của nó theo vài hạt cơm để xác định loài gián đó có thể tồn tại hay không.","B. So sánh chuyển màu, kết cấu bề mặt và vùng bắt sáng của nó với thức ăn và khay kim loại dưới cùng nguồn sáng.","C. Đếm số món ăn riêng biệt xuất hiện quanh nó trong khay."],"correct_option":"B","explanation":"Kích thước có thể thay đổi theo loài và phối cảnh. Sự khác biệt về chất liệu và ánh sáng dưới cùng điều kiện là phép so sánh đáng tin hơn, nhưng vẫn cần kiểm tra nguồn ảnh."},"description":"Con gián có màu quá rực, bề mặt bóng và giống đồ chơi, không phản ứng với ánh sáng giống cơm và khay kim loại xung quanh."}]},"step_2_text_highlight":{"mechanic_type":"TEXT_HIGHLIGHT","simulated_post":{"author":"Ẩn danh","time_posted":"5 giờ trước","content":"Tôi thường không đăng những chuyện thế này, nhưng bữa trưa hôm nay thật sự khiến tôi khó chịu. Trong lúc ăn, tôi thấy một thứ trông giống con gián trong khay cơm. Tôi không biết nó đến từ nhà bếp hay từ đâu khác, có lẽ vẫn có một lời giải thích hoàn toàn hợp lý, nhưng nếu nó thực sự đến từ căng tin thì học sinh có quyền lo lắng. Tôi không nói căng tin không an toàn. Tôi chỉ hỏi tại sao chuyện này cứ xảy ra và tại sao sau đó dường như chẳng ai giải thích gì. Dù sao nhà trường có vẻ không bao giờ xem xét phản hồi của học sinh về đồ ăn, cứ nói vấn đề quá phức tạp hay đại loại vậy. Đến lúc này, tôi nghĩ phụ huynh xứng đáng biết chuyện gì đang xảy ra trước khi mọi thứ bị âm thầm che giấu..."},"traps":[{"trap_id":"R002_TRAP_01","ground_truth_start":331,"ground_truth_end":461,"matched_text":"Tôi không nói căng tin không an toàn. Tôi chỉ hỏi tại sao chuyện này cứ xảy ra và tại sao sau đó dường như chẳng ai giải thích gì.","weapon_type":["seeding_doubt"],"socratic_quiz":{"question":"Cần có bằng chứng nào trước khi câu hỏi 'tại sao chuyện này cứ xảy ra' trở nên hợp lý?","options":["A. Sự không chắc chắn của tác giả về nguồn gốc con côn trùng.","B. Những vụ việc trước đó đã được kiểm chứng độc lập, cho thấy cùng vấn đề thực sự tái diễn.","C. Việc bài đăng cụ thể này chưa nhận được phản hồi ngay lập tức."],"correct_option":"B","explanation":"Cụm từ 'cứ xảy ra' biến một trường hợp chưa xác minh thành mô thức. Muốn khẳng định sự lặp lại, cần nhiều vụ việc đã được kiểm chứng độc lập."}},{"trap_id":"R002_TRAP_02","ground_truth_start":462,"ground_truth_end":584,"matched_text":"Dù sao nhà trường có vẻ không bao giờ xem xét phản hồi của học sinh về đồ ăn, cứ nói vấn đề quá phức tạp hay đại loại vậy.","weapon_type":["poisoning_the_well","overgeneralization"],"socratic_quiz":{"question":"Làm thế nào để đánh giá phản hồi sau này của nhà trường mà không bị đóng khung bởi bài đăng?","options":["A. Đánh giá phản hồi dựa trên số người bình luận vốn đã không tin nhà trường.","B. Xem xét bằng chứng và lập luận trong phản hồi trước khi kết luận sự phức tạp là có thật hay chỉ là cái cớ.","C. Bác bỏ phản hồi nếu nó chứa chi tiết kỹ thuật khó hiểu."],"correct_option":"B","explanation":"Bài đăng gắn nhãn mọi phản hồi tương lai là cái cớ trước khi nó xuất hiện. Đánh giá công bằng phải dựa trên bằng chứng trong phản hồi, không dựa trên cách đóng khung trước đó."}},{"trap_id":"R002_TRAP_03","ground_truth_start":585,"ground_truth_end":694,"matched_text":"Đến lúc này, tôi nghĩ phụ huynh xứng đáng biết chuyện gì đang xảy ra trước khi mọi thứ bị âm thầm che giấu...","weapon_type":["conspiracy_theory","appeal_to_fear"],"socratic_quiz":{"question":"Cụm từ 'trước khi mọi thứ bị âm thầm che giấu' thay đổi thứ tự hành động và kiểm chứng của người đọc như thế nào?","options":["A. Nó khiến việc chia sẻ ngay có vẻ như hành động bảo vệ, đưa sự leo thang lên trước bước kiểm tra xem có vụ che đậy thật hay không.","B. Nó giới hạn tuyên bố ở một quan sát cá nhân và làm giảm áp lực hành động.","C. Nó hướng người đọc tới một nguồn độc lập trước khi hình thành nhận định."],"correct_option":"A","explanation":"Ám chỉ che đậy khiến chia sẻ ngay có vẻ an toàn hơn chờ kiểm chứng. Thói quen đúng là xác minh trước, khuếch đại sau."}}]},"step_3_sorting_game":{"mechanic_type":"DRAG_AND_DROP_SORTING","context_text":"Một bài đăng gây hiểu lầm về căng tin trường học đã lan rộng trong cộng đồng.","pool_items":[{"item_id":"R002_SORT_01","text":"Những người dùng khác đăng lại ảnh với cáo buộc nặng nề hơn và mặc định tình huống xấu nhất."},{"item_id":"R002_SORT_02","text":"Tin đồn được chấp nhận như 'điều ai cũng biết' dù tuyên bố ban đầu chưa từng được xác nhận."},{"item_id":"R002_SORT_03","text":"Một người đăng ảnh kèm cách diễn giải cá nhân nhưng không có bối cảnh đã được xác minh."},{"item_id":"R002_SORT_04","text":"Mọi người phản ứng theo cảm xúc và chia sẻ bài đăng trước khi chờ xác minh chính thức."}],"correct_sequence":["R002_SORT_03","R002_SORT_01","R002_SORT_04","R002_SORT_02"],"validation_feedback":{"success":"Chính xác. Tin đồn thường trở nên đáng tin do được lặp lại chứ không phải nhờ bằng chứng. Một quan sát chưa kiểm chứng có thể biến thành 'ai cũng biết là thật' khi mọi người thêm suy đoán, chia sẻ theo cảm xúc và ngừng kiểm tra nguồn ban đầu.","failure":"Chưa đúng. Thông tin sai hiếm khi lan truyền chỉ nhờ một bài đăng thuyết phục. Nó tích lũy đà khi mọi người khuếch đại cáo buộc chưa xác minh và lặp lại chúng như sự thật trước khi có ai kiểm tra bằng chứng."}}},"dialogue_trigger":{"question":"Hãy hỏi Giáo viên/Phụ huynh: nếu nhận được tin nhắn này, bạn cần bằng chứng nào trước khi tin rằng bức ảnh phản ánh một vấn đề an toàn thực phẩm có thật thay vì một câu chuyện bị thao túng?","mil_insight":"Một hình ảnh đơn lẻ hiếm khi cung cấp đủ bối cảnh để xác định chuyện gì đã xảy ra. Hãy thảo luận cách phân biệt bằng chứng trực tiếp với giả định bằng việc kiểm tra nguồn ban đầu, xác minh ảnh được chụp ở đâu và khi nào, đồng thời theo dõi quy trình điều tra chính thức của nhà trường trước khi kết luận."}},{"level":"RED","case_id":"R003","title":"Tuổi 20 và đã thành công?","short_summary":"Một bài đăng trau chuốt về tiền bạc, kỷ luật và thành công kéo người trẻ vào cuộc so sánh gay gắt xem ai đang bị bỏ lại phía sau.","duration_min":15,"skills":["Bằng chứng hình ảnh","Ngôn từ và tuyên bố","Chuỗi lan truyền thông tin"],"spotted_url":"/assets/images/R003/R003_spotted.png","theme":["Mạng xã hội","Tài chính cá nhân"],"story_context":"Một bài đăng của nhân vật trẻ tên 'Minh Khang' ghép lời khuyên tài chính với bức ảnh về lối sống đáng mơ ước. Thông điệp đang khiến người xem ngưỡng mộ, phòng thủ và so sánh bản thân. Hãy xem xét bài đăng trước khi quyết định nên tin tưởng tới mức nào.","modules":{"step_1_image_forensics":{"mechanic_type":"IMAGE_FORENSICS","image_url":"/assets/images/R003/R003_fake.jpg","image_width":1402,"image_height":1122,"context_text":"Bức ảnh này được dùng để củng cố tuyên bố của Minh Khang về lối sống xa hoa. Hãy xem các chi tiết vật lý trong ảnh có nhất quán với nhau hay không.","target_anomalies":[{"anomaly_id":"R003_IMG_01","name":"inconsistent_hand_features","x_pct":38.7,"y_pct":58.2,"radius_pct":8.6,"socratic_quiz":{"question":"Phép so sánh nào hữu ích nhất khi xem xét bàn tay của anh chàng đang cầm điện thoại?","options":["A. Kiểm tra xem riêng hiệu ứng phối cảnh có giải thích được vì sao bàn tay trông lớn hơn cổ tay hay không.","B. Kiểm tra màu da và đường nét khớp ngón có chuyển tiếp tự nhiên từ cổ tay đến tư thế cầm hay không.","C. Kiểm tra góc điện thoại có cùng hướng với ánh nhìn của người trong ảnh hay không."],"correct_option":"B","explanation":"Phối cảnh có thể giải thích kích thước, nhưng không giải thích màu và cấu trúc khớp thiếu nhất quán. Hãy xem đây là manh mối, không phải bằng chứng duy nhất."},"description":"Bàn tay cầm điện thoại có màu quá rực và bóng như sáp, trong khi đường nét các khớp ngón không hoàn toàn khớp với tư thế cầm tự nhiên."},{"anomaly_id":"R003_IMG_02","name":"warped_window_frame","x_pct":17,"y_pct":49.9,"radius_pct":11.2,"socratic_quiz":{"question":"Cách kiểm tra nào giúp phân biệt hiệu ứng phối cảnh với điểm không nhất quán ở khu vực cửa sổ?","options":["A. So sánh độ sáng của khung cửa với các tòa nhà bên ngoài.","B. Lần theo khung và tay nắm để xem các vật cứng giữ đường nét trơn hay gợn sóng độc lập dọc theo chiều dài.","C. Kiểm tra tay nắm có nằm ở độ cao thuận tiện để mở cửa sổ hay không."],"correct_option":"B","explanation":"Phối cảnh có thể làm vật cứng trông nghiêng, nhưng đường viền vẫn phải liền mạch. Hãy đối chiếu độ gợn với toàn bộ khung và cửa sổ thật."},"description":"Khung cửa sổ và tay nắm vốn cứng lại xuất hiện những đường gợn sóng không đều, không giữ được hình dạng gia công nhất quán."}]},"step_2_text_highlight":{"mechanic_type":"TEXT_HIGHLIGHT","simulated_post":{"author":"Minh Khang","time_posted":"2 giờ trước","content":"Thật buồn cười khi có người cứ nói 'tiền không mua được hạnh phúc' mỗi khi ai đó đăng món đồ đẹp. Kiểu như... chỉ vì bạn không đủ tiền mua không có nghĩa đó là 'khoe khoang'. Trong khi đó, tất cả những người tôi biết đều đang cày cuốc, kiếm chỗ thực tập, mua thứ họ muốn và thực sự làm được điều gì đó với cuộc đời. Nếu bạn vẫn viện cớ trong khi tất cả mọi người đều tiến lên, có lẽ hãy ngừng đổ lỗi cho người khác và tự hỏi tại sao mình đang bị bỏ lại phía sau. Cứ tức giận nếu bạn muốn, nhưng đừng mong thế giới chờ bạn."},"traps":[{"trap_id":"R003_T1","ground_truth_start":110,"ground_truth_end":174,"matched_text":"chỉ vì bạn không đủ tiền mua không có nghĩa đó là 'khoe khoang'.","weapon_type":["attacking_motive","strawman"],"socratic_quiz":{"question":"Cách phản hồi nào đánh giá lời chỉ trích mà không suy đoán động cơ của người nói?","options":["A. Xem người chỉ trích có từng đăng nội dung về tiền bạc hay không.","B. Xem lời chỉ trích có nêu được hành vi cụ thể và tiêu chí hợp lý hay không.","C. Xem phần lớn người bình luận cho rằng họ ghen tị hay chân thành."],"correct_option":"B","explanation":"Động cơ bị suy đoán không quyết định một lời phê bình đúng hay sai. Hãy đánh giá nội dung và bằng chứng của lời phê bình trước."}},{"trap_id":"R003_T2","ground_truth_start":189,"ground_truth_end":314,"matched_text":"tất cả những người tôi biết đều đang cày cuốc, kiếm chỗ thực tập, mua thứ họ muốn và thực sự làm được điều gì đó với cuộc đời","weapon_type":["false_comparison"],"socratic_quiz":{"question":"Dữ liệu nào cần có để kiểm tra tuyên bố 'mua được đồ xa xỉ nghĩa là thành công hơn'?","options":["A. Giá trung bình của những món đồ xuất hiện trong bài đăng.","B. Tiêu chí thành công rõ ràng cùng dữ liệu về thu nhập, nợ, hỗ trợ gia đình và điểm xuất phát.","C. Số người quen của tác giả đã thích hoặc chia sẻ bài đăng."],"correct_option":"B","explanation":"Khả năng mua sắm không tự đại diện cho thành công. Một so sánh có ý nghĩa cần cùng tiêu chí và phải tính đến điểm xuất phát khác nhau."}},{"trap_id":"R003_T3","ground_truth_start":316,"ground_truth_end":461,"matched_text":"Nếu bạn vẫn viện cớ trong khi tất cả mọi người đều tiến lên, có lẽ hãy ngừng đổ lỗi cho người khác và tự hỏi tại sao mình đang bị bỏ lại phía sau","weapon_type":["inducing_fomo","personal_attack"],"socratic_quiz":{"question":"Bằng chứng nào cần có trước khi tin rằng 'mọi người đều đang tiến lên còn bạn tụt lại'?","options":["A. Nhiều bài đăng nổi bật cho thấy bạn bè đang mua sắm và đi du lịch.","B. Dữ liệu đại diện về tiến bộ của nhóm, gồm cả những trường hợp không được đăng và hoàn cảnh của họ.","C. Cảm giác lo lắng của người đọc sau khi xem liên tiếp nhiều nội dung tương tự."],"correct_option":"B","explanation":"Dòng thời gian chỉ hiển thị phần mọi người chọn đăng, không phải mẫu đại diện. Đừng biến cảm giác bị bỏ lại thành kết luận về thực tế."}},{"trap_id":"R003_T4","ground_truth_start":463,"ground_truth_end":522,"matched_text":"Cứ tức giận nếu bạn muốn, nhưng đừng mong thế giới chờ bạn.","weapon_type":["emotional_dismissal"],"socratic_quiz":{"question":"Cụm từ 'cứ tức đi' làm gì với một ý kiến phản đối có bằng chứng?","options":["A. Đòi hỏi người phản đối trình bày bằng chứng rõ hơn trước khi tranh luận.","B. Đổi ý kiến phản đối thành một phản ứng cảm xúc để khỏi trả lời nội dung của nó.","C. Thừa nhận cảm xúc của người phản đối rồi mời họ giải thích thêm."],"correct_option":"B","explanation":"Gắn nhãn cảm xúc không trả lời được nội dung phản đối. Hãy quay lại lập luận và bằng chứng thay vì phán đoán trạng thái của người nói."}}]},"step_3_sorting_game":{"mechanic_type":"DRAG_AND_DROP_SORTING","context_text":"Các chiến dịch khoe khoang độc hại thường khiến người đọc cảm thấy kém cỏi trước khi bán cho họ những khóa học lừa đảo. Hãy sắp xếp các giai đoạn của chiến lược thao túng tâm lý này theo đúng thứ tự.","pool_items":[{"item_id":"R003_SORT_01","text":"Người đọc trải qua FOMO và sự hoài nghi bản thân mạnh mẽ, lo sợ mình đang tụt lại sau bạn bè."},{"item_id":"R003_SORT_02","text":"Người có ảnh hưởng đăng ảnh đồ xa xỉ giả do AI tạo ra để xây dựng địa vị và uy tín giả tạo."},{"item_id":"R003_SORT_03","text":"Người có ảnh hưởng chào bán một 'lớp học tư duy làm giàu' đắt tiền như con đường tắt tối ưu đến thành công."},{"item_id":"R003_SORT_04","text":"Bài đăng dùng so sánh sai và ngôn ngữ trịch thượng để hạ thấp những người trẻ lao động bình thường là 'lười biếng'."}],"correct_sequence":["R003_SORT_02","R003_SORT_04","R003_SORT_01","R003_SORT_03"],"validation_feedback":{"success":"Chính xác! Bạn đã giải mã phễu khoe khoang độc hại kinh điển: bịa đặt địa vị (Mồi nhử) -> hạ thấp bằng so sánh sai (Công kích) -> kích hoạt bất an và FOMO (Lo âu) -> bán khóa học 'đường tắt' đắt tiền (Kiếm tiền).","failure":"Thứ tự chưa đúng. Kẻ thao túng bằng khoe khoang độc hại trước tiên tạo dựng sự giàu có giả, sau đó tấn công lòng tự trọng của khán giả để tạo FOMO rồi mới đưa khóa học trả phí ra như một giải pháp giả."}}},"dialogue_trigger":{"question":"Hãy hỏi Giáo viên/Phụ huynh: nếu một bài đăng mạng xã hội khiến bạn lo mình đang tụt lại sau những người bạn có vẻ đủ tiền sống xa hoa, bạn có thể làm gì để đánh giá đâu là thật và đâu là dàn dựng?","mil_insight":"Những khoảnh khắc nổi bật trên mạng xã hội hiếm khi phản ánh toàn bộ thực tế, còn công cụ tạo ảnh AI giúp việc làm giả lối sống xa hoa trở nên dễ dàng. Hãy nhắc người trẻ rằng thành công không được đo bằng khoe vật chất hay hạ thấp người khác, và lời chào bán cấp bách cho các 'khóa học tư duy' đắt tiền hầu như luôn là lừa đảo trục lợi."}},{"level":"RED","case_id":"R004","title":"Đề thi quốc gia bị lộ?","short_summary":"Một kênh Discord tràn ngập ảnh chụp màn hình, tin nhắn khẩn cấp và những lời chào mời xoay quanh nghi vấn lộ đề thi quốc gia.","duration_min":15,"skills":["Bằng chứng hình ảnh","Ngôn từ và tuyên bố","Chuỗi lan truyền thông tin"],"spotted_url":"/assets/images/R004/R004_spotted.jpg","theme":["Giáo dục","Cộng đồng trực tuyến"],"story_context":"Học sinh trong một máy chủ Discord đang phản ứng trước tuyên bố đề thi quốc gia đã bị lộ. Một số tài khoản hứa cung cấp ngay, số khác kể lại điều bạn bè nghe được, còn thời hạn thì đang đến gần. Hãy xem xét ảnh chụp, tin nhắn và trình tự sự việc trước khi đánh giá độ tin cậy.","modules":{"step_1_image_forensics":{"mechanic_type":"IMAGE_FORENSICS","image_url":"/assets/images/R004/R004_fake.jpg","image_width":853,"image_height":548,"context_text":"Ảnh chụp màn hình kênh Discord này đang lan truyền với lời khẳng định có '100% đề thi chính thức từ Bộ Giáo dục'. Hãy xem các chi tiết giao diện có nhất quán với một màn hình Discord thật hay không.","target_anomalies":[{"anomaly_id":"R004_IMG_03","name":"distorted_ui_icon","x_pct":85.8,"y_pct":90,"radius_pct":8,"socratic_quiz":{"question":"Quan sát nào hữu ích nhất khi đánh giá hai nút nhỏ ở góc dưới bên phải?","options":["A. Nền tối của chúng có màu gần giống thanh nhập tin nhắn.","B. Các nút GIF lặp lại nhưng không giữ được hình dạng chữ và cấu trúc nhất quán.","C. Vị trí của chúng nằm gần những công cụ nhắn tin khác."],"correct_option":"B","explanation":"Các nút giao diện lặp lại phải giữ được chữ, tỷ lệ và đường viền dễ nhận biết. Khi hai nút GIF được cho là giống nhau lại khác biệt ở những chi tiết này, hãy đối chiếu ảnh với giao diện Discord thật trước khi tin tưởng."},"description":"Các icon GIF và công cụ trò chuyện ở góc dưới bên phải khung chat bị méo mó, biến dạng bất thường."},{"anomaly_id":"R004_IMG_04","name":"artifact_edge_shape","x_pct":93.6,"y_pct":31.8,"radius_pct":8,"socratic_quiz":{"question":"Điểm nào không nhất quán ở mép phải của vùng tin nhắn được tô sáng?","options":["A. Góc trên và góc dưới đều có cùng kiểu bo tròn.","B. Đường viền bị ngắt bởi một chỗ lõm vào, không tiếp nối vùng được tô sáng.","C. Mép phải nằm gần cạnh bên của cửa sổ trò chuyện."],"correct_option":"B","explanation":"Vùng tô sáng của một tin nhắn phải tạo thành một khung liền mạch. Ở đây, chỗ lõm không có nút hay nội dung nào giải thích lại làm đứt mép phải, cho thấy phần này của ảnh chụp màn hình đã bị chỉnh sửa."},"description":"Mép phải của vùng tin nhắn được tô sáng bị ngắt bởi một chỗ lõm vào, phá vỡ đường viền vốn phải liền mạch."}]},"step_2_text_highlight":{"mechanic_type":"TEXT_HIGHLIGHT","simulated_post":{"author":"Hội đồng tuyển chọn học bổng","time_posted":"Ngay bây giờ","content":"Chúc mừng! Bạn đã được chọn nhận Học bổng Sinh viên Xuất sắc. Chỉ có 50 sinh viên được lựa chọn. Nếu bạn không hoàn tất xác minh trong vòng 2 giờ, suất học bổng của bạn sẽ được chuyển cho một sinh viên khác. Vui lòng đăng nhập để thanh toán phí xác minh 49.000 VNĐ. Không liên hệ với văn phòng nhà trường vì quá trình xác minh được thực hiện bởi đối tác học bổng của chúng tôi."},"traps":[{"trap_id":"R004_TRAP_01","ground_truth_start":11,"ground_truth_end":61,"matched_text":"Bạn đã được chọn nhận Học bổng Sinh viên Xuất sắc.","weapon_type":["authority_bias","reward_bait"],"socratic_quiz":{"question":"Việc xác nhận bạn 'đã được chọn' nhằm thay đổi bước tiếp theo của bạn như thế nào?","options":["A. Chuyển sự chú ý từ kiểm tra tính hợp lệ sang làm nhanh các bước để nhận phần thưởng.","B. Khuyến khích người nhận hỏi nhà trường về tiêu chí xét chọn trước khi phản hồi.","C. Cho người nhận đủ thông tin để so sánh thông báo với quy trình học bổng chính thức."],"correct_option":"A","explanation":"Cảm giác đã thắng khiến người nhận tập trung vào nhận thưởng thay vì xác minh. Hãy kiểm tra quy trình qua kênh chính thức trước khi làm bước tiếp theo."}},{"trap_id":"R004_TRAP_02","ground_truth_start":97,"ground_truth_end":207,"matched_text":"Nếu bạn không hoàn tất xác minh trong vòng 2 giờ, suất học bổng của bạn sẽ được chuyển cho một sinh viên khác.","weapon_type":["artificial_urgency"],"socratic_quiz":{"question":"Cách kiểm tra nào xác định tốt nhất thời hạn hai giờ có hợp lệ hay chỉ tạo áp lực?","options":["A. Xem đồng hồ đếm ngược trên trang có hoạt động chính xác hay không.","B. Kiểm tra quy định trên website chính thức và liên hệ đơn vị qua thông tin tự tìm được.","C. So sánh giá trị học bổng với thời gian còn lại để quyết định có đáng mạo hiểm."],"correct_option":"B","explanation":"Thời hạn chỉ đáng tin khi xuất hiện trong quy trình chính thức và được xác nhận độc lập. Áp lực thời gian không thay thế được bằng chứng."}},{"trap_id":"R004_TRAP_03","ground_truth_start":241,"ground_truth_end":264,"matched_text":"phí xác minh 49.000 VNĐ","weapon_type":["advance_fee_scam"],"socratic_quiz":{"question":"Hành động nào kiểm tra yêu cầu 'phí xác minh' mà không đi theo đường dẫn của người gửi?","options":["A. Tìm điều lệ học bổng và hỏi đơn vị cấp học bổng qua website hoặc số điện thoại chính thức.","B. Chuyển thử số tiền nhỏ vì thiệt hại có vẻ thấp hơn giá trị phần thưởng.","C. Kiểm tra trang thanh toán có logo, màu sắc và ngôn ngữ chuyên nghiệp hay không."],"correct_option":"A","explanation":"Khoản tiền nhỏ vẫn có thể là bước đầu của lừa đảo hoặc đánh cắp dữ liệu. Luôn xác minh yêu cầu qua một kênh do bạn tự tìm."}},{"trap_id":"R004_TRAP_04","ground_truth_start":266,"ground_truth_end":377,"matched_text":"Không liên hệ với văn phòng nhà trường vì quá trình xác minh được thực hiện bởi đối tác học bổng của chúng tôi.","weapon_type":["isolation_tactic"],"socratic_quiz":{"question":"Vì sao việc tự liên hệ nhà trường qua kênh chính thức là phép thử quan trọng nhất ở đây?","options":["A. Nhà trường có thể gia hạn thời hạn nên người nhận không cần đánh giá nội dung tin nhắn.","B. Một kênh tin cậy độc lập phá vỡ sự cô lập và xác nhận thông báo có tồn tại hay không.","C. Bộ phận hành chính có thể cho biết những học sinh khác đã trả phí bao nhiêu."],"correct_option":"B","explanation":"Yêu cầu giữ bí mật thường ngăn nạn nhân tiếp cận phép kiểm tra thực tế. Liên hệ độc lập giúp xác minh mà không phụ thuộc vào người gửi."}}]},"step_3_sorting_game":{"mechanic_type":"DRAG_AND_DROP_SORTING","context_text":"Hãy sắp xếp các bước theo đúng trình tự thời gian của đợt tấn công Phishing này để thấy rõ cách kẻ gian chiếm đoạt tài khoản và tiền bạc!","pool_items":[{"item_id":"R004_SORT_01","text":"Sinh viên nhận được tin nhắn khẩn cấp thông báo trúng học bổng bất ngờ."},{"item_id":"R004_SORT_02","text":"Sinh viên bấm vào đường link xác minh giả mạo đi kèm."},{"item_id":"R004_SORT_03","text":"Sinh viên nhập tên đăng nhập và mật khẩu tài khoản trường học vào trang giả."},{"item_id":"R004_SORT_04","text":"Hệ thống của kẻ lừa đảo âm thầm thu thập và lưu trữ thông tin đăng nhập."},{"item_id":"R004_SORT_05","text":"Trang web giả tiếp tục yêu cầu nhập mã OTP hoặc nộp khoản phí xác minh."},{"item_id":"R004_SORT_06","text":"Kẻ tấn công chạy ngầm việc đăng nhập và chiếm quyền điều khiển tài khoản trường học thật."},{"item_id":"R004_SORT_07","text":"Sinh viên bị mất hoàn toàn tài khoản trước cả khi nhận ra học bổng chỉ là một cú lừa."}],"correct_sequence":["R004_SORT_01","R004_SORT_02","R004_SORT_03","R004_SORT_04","R004_SORT_05","R004_SORT_06","R004_SORT_07"],"validation_feedback":{"success":"Xuất sắc! Kẻ lừa đảo không chỉ nhắm vào 49.000 VNĐ. Việc chiếm đoạt tài khoản trường học giúp chúng xâm nhập hệ thống nội bộ và tiếp tục mạo danh bạn để đi lừa những người khác.","failure":"Chưa chính xác. Hãy nhớ rằng các đòn Phishing luôn âm thầm đánh cắp thông tin tài khoản ngay khi bạn vừa bấm đăng nhập, trước cả khi bạn thực hiện bước chuyển tiền!"}}},"dialogue_trigger":{"question":"Nếu nhận được thông báo trúng học bổng hay quà tặng bất ngờ, quy trình kiểm chứng an toàn mà không bấm vào link lạ của bạn là gì?","mil_insight":"1. Bắt bài tâm lý: Học bổng thật không bao giờ bắt bạn đóng phí xác minh hay ép thời gian tính bằng giờ.\n2. Cảnh giác link lạ: Không truy cập vào các đường link đính kèm trong tin nhắn/email lạ.\n3. Kiểm chứng trực tiếp: Vào thẳng trang web chính thức của nhà trường hoặc liên hệ phòng Công tác sinh viên để xác minh."}},{"level":"RED","case_id":"S005","title":"Quảng trường Thời Đại vắng lặng","short_summary":"Bức ảnh Quảng trường Thời đại vắng tanh xuất hiện trở lại cùng tuyên bố về tình trạng y tế khẩn cấp và lệnh phong tỏa mới năm 2026, làm dấy lên tranh luận lo lắng.","duration_min":6,"skills":["Bằng chứng hình ảnh","Ngôn từ và tuyên bố","Chuỗi lan truyền thông tin"],"spotted_url":"/assets/images/R005/R005_spotted.jpg","theme":["Y tế công cộng","Sự kiện thời sự"],"story_context":"Các bài đăng đang chia sẻ bức ảnh Quảng trường Thời đại hoàn toàn vắng người và tuyên bố tình trạng y tế nghiêm trọng năm 2026 buộc New York phải phong tỏa. Ngày chụp và nguồn gốc ban đầu không xuất hiện trong các bài đang lan truyền. Hãy xem bằng chứng hiện có cho phép xác định điều gì.","source":{"title":"Context Collapse and Hybrid AI Misinformation","url":"","note":"Tình huống dựa trên thủ đoạn có thật: chỉnh sửa kỹ thuật số tư liệu xác thực từ các cuộc khủng hoảng trong quá khứ để tạo ra nỗi hoảng loạn ở hiện tại."},"modules":{"step_1_image_forensics":{"mechanic_type":"IMAGE_FORENSICS","image_url":"/assets/images/R005/R005_fake.jpg","image_width":1536,"image_height":1024,"context_text":"Các bài đăng mạng xã hội đang chia sẻ bức ảnh này như bằng chứng tuyệt đối về lệnh phong tỏa khẩn cấp do virus Corona tại Quảng trường Thời đại năm 2026.","target_anomalies":[{"anomaly_id":"R005_IMG_01","name":"flipped_digit_in_year","x_pct":48.5,"y_pct":6.5,"radius_pct":6,"socratic_quiz":{"question":"Phép đối chiếu nào giúp xác định con số '2026' là chi tiết thật hay được chèn thêm?","options":["A. So hình dạng, phối cảnh và ánh sáng của từng chữ số với nhau và với ảnh cũ từ nguồn đáng tin.","B. Kiểm tra xem tòa nhà có thường trưng bày năm mới trên biển quảng cáo hay không.","C. Tăng độ nét để xem con số có đọc được rõ hơn các vật thể gần đó hay không."],"correct_option":"A","explanation":"Chi tiết chèn thêm thường lệch hình dạng, phối cảnh hoặc ánh sáng. Ảnh cũ từ nguồn độc lập giúp kiểm tra giả thuyết đó."},"description":"Chữ số '2' đầu tiên trong '2026' bị lật dọc, hoàn toàn phi logic so với phông chữ gốc."},{"anomaly_id":"R005_IMG_02","name":"corrupted_billboard_text","x_pct":76,"y_pct":26.4,"radius_pct":15,"socratic_quiz":{"question":"Cách kiểm tra nào phân biệt chữ nhỏ bị nén với chữ bị tạo hoặc chỉnh sửa sai?","options":["A. So độ sáng của bảng với các biển quảng cáo khác trong cùng khung hình.","B. Kiểm tra ký tự lặp lại có giữ hình dạng và tạo thành từ nhất quán trong ảnh nguồn hay không.","C. Đánh giá nội dung thông báo có phù hợp với tình hình được bài đăng mô tả hay không."],"correct_option":"B","explanation":"Nén ảnh làm giảm chi tiết nhưng thường không biến từng ký tự thành cấu trúc khác nhau. Hãy đối chiếu ảnh nguồn trước khi kết luận bị chỉnh sửa."},"description":"Dòng chữ có những lỗi chính tả kỳ quái, với các ký tự méo mó trong 'STAYIE' và 'SSJCK'."},{"anomaly_id":"R005_IMG_03","name":"illogical_light_reflection","x_pct":49.5,"y_pct":82.1,"radius_pct":15,"socratic_quiz":{"question":"Phép kiểm tra nào đánh giá tốt nhất vùng phản chiếu màu đỏ trên mặt đường?","options":["A. Lần theo hướng và màu phản chiếu để tìm nguồn sáng tương ứng trong cảnh.","B. Đối chiếu mặt đường ướt với dự báo thời tiết của ngày được nêu trong bài.","C. So độ bão hòa màu đỏ với cài đặt màn hình đang dùng để xem ảnh."],"correct_option":"A","explanation":"Phản chiếu phải liên hệ được với nguồn sáng về hướng và màu. Nếu không, đó là manh mối chỉnh sửa cần kiểm tra thêm."},"description":"Vũng nước phản chiếu ánh sáng đỏ rực nhưng không có nguồn sáng đỏ tương ứng từ các biển quảng cáo xung quanh."}]},"step_2_text_highlight":{"mechanic_type":"TEXT_HIGHLIGHT","simulated_post":{"author":"NYC Daily Không Kiểm Duyệt","time_posted":"15 phút trước","content":"Tình hình ở New York đã rơi vào hỗn loạn hoàn toàn. Một đợt bùng phát nghiêm trọng của biến thể Corona mới đã khiến toàn bộ Quảng trường Thời đại bị phong tỏa khẩn cấp vào sáng nay. Các cơ quan chính phủ đang cố tình che giấu thông tin này, nhưng bức ảnh đã phơi bày toàn bộ sự thật. Nếu không hành động ngay lập tức, gia đình bạn có thể bị cuốn vào làn sóng đại dịch tiếp theo. Mọi người cần chia sẻ bài đăng này ngay vào các nhóm để cảnh báo cộng đồng. Hãy liên hệ ngay với người thân ở Mỹ và bảo họ tích trữ thực phẩm cùng tiền mặt trước khi quá muộn."},"traps":[{"trap_id":"R005_TRAP_01","ground_truth_start":182,"ground_truth_end":283,"matched_text":"Các cơ quan chính phủ đang cố tình che giấu thông tin này, nhưng bức ảnh đã phơi bày toàn bộ sự thật.","weapon_type":["conspiracy_theory","authority_undermining"],"socratic_quiz":{"question":"Phản ứng nào tránh được cả tin mù quáng lẫn bác bỏ mọi nguồn chính thức?","options":["A. Tin bài đăng nếu nhiều bình luận kể lại trải nghiệm tương tự.","B. So tuyên bố cụ thể với dữ liệu gốc và nhiều nguồn độc lập có phương pháp minh bạch.","C. Tin thông báo chính thức vì cơ quan công quyền luôn có đầy đủ thông tin."],"correct_option":"B","explanation":"Không nguồn nào nên được miễn kiểm tra. Hãy so từng tuyên bố với dữ liệu gốc, phương pháp và các nguồn độc lập."}},{"trap_id":"R005_TRAP_02","ground_truth_start":284,"ground_truth_end":378,"matched_text":"Nếu không hành động ngay lập tức, gia đình bạn có thể bị cuốn vào làn sóng đại dịch tiếp theo.","weapon_type":["appeal_to_fear","emotional_manipulation"],"socratic_quiz":{"question":"Dấu hiệu hành vi nào cho thấy nỗi sợ đang thay thế việc đánh giá bằng chứng?","options":["A. Người đọc tìm bản tin gốc và ghi lại điều còn chưa chắc chắn.","B. Người đọc chia sẻ ngay để cảnh báo người khác trước khi kiểm tra nguồn và thời điểm.","C. Người đọc tạm dừng, so sánh nhiều nguồn rồi mới quyết định có hành động hay không."],"correct_option":"B","explanation":"Cảm xúc trở thành thao túng khi nó đẩy hành động lên trước kiểm chứng. Nhận ra sự thôi thúc đó là tín hiệu để dừng lại."}},{"trap_id":"R005_TRAP_03","ground_truth_start":455,"ground_truth_end":554,"matched_text":"Hãy liên hệ ngay với người thân ở Mỹ và bảo họ tích trữ thực phẩm cùng tiền mặt trước khi quá muộn.","weapon_type":["manufactured_urgency","panic_inducing_action"],"socratic_quiz":{"question":"Bài đăng đang yêu cầu người đọc thực hiện các bước theo thứ tự nào?","options":["A. Chia sẻ để cảnh báo trước, còn nguồn và bằng chứng sẽ được kiểm tra sau.","B. Xác định nguồn gốc, đối chiếu bằng chứng rồi mới cảnh báo nếu cần.","C. Hỏi ý kiến cộng đồng, chờ đồng thuận rồi coi đó là xác minh."],"correct_option":"A","explanation":"Lời kêu gọi đảo ngược quy trình an toàn bằng cách đặt chia sẻ trước kiểm chứng. Cảm giác cấp bách không làm bằng chứng đáng tin hơn."}}]},"step_3_sorting_game":{"mechanic_type":"DRAG_AND_DROP_SORTING","context_text":"Quá trình kẻ lừa đảo kết hợp tư liệu cũ, công nghệ AI và tâm lý học để tạo ra một chiến dịch thông tin sai lệch hoàn chỉnh.","pool_items":[{"item_id":"R005_SORT_03","text":"Soạn bài đăng chứa từ ngữ giật gân, gieo thuyết âm mưu và đính kèm ảnh đã chỉnh sửa bằng AI."},{"item_id":"R005_SORT_01","text":"Thu thập một bức ảnh thật về Quảng trường Thời đại vắng người được chụp trong đợt phong tỏa năm 2020."},{"item_id":"R005_SORT_04","text":"Phát tán bài đăng vào các nhóm mạng xã hội để kích động mọi người tích trữ hàng hóa và tăng tương tác."},{"item_id":"R005_SORT_02","text":"Dùng công cụ AI tạo sinh để đổi năm 2020 thành 2026 và sửa chi tiết trên biển quảng cáo nhằm làm mới bức ảnh."}],"correct_sequence":["R005_SORT_01","R005_SORT_02","R005_SORT_03","R005_SORT_04"],"validation_feedback":{"success":"Chính xác! Bạn đã vạch trần hoàn toàn vòng đời của một vụ lừa đảo lai: tìm tư liệu cũ -> chỉnh sửa bằng AI -> cài bẫy tâm lý -> phát tán hoảng loạn.","failure":"Thứ tự chưa đúng. Hãy bắt đầu bằng việc chọn ảnh gốc, sau đó chỉnh sửa bằng AI, tiếp theo viết nội dung thao túng và cuối cùng là phát tán."}}},"dialogue_trigger":{"question":"Nếu thấy một bức ảnh gây hoảng loạn về tình hình toàn cầu, quy trình xác minh ba bước của bạn là gì?","mil_insight":"1. Giám định kỹ thuật (Giám định AI): phóng to để tìm dị thường như chữ méo, chữ số bị lật và phản chiếu phi logic.\n2. Xác minh bối cảnh (Tìm kiếm hình ảnh ngược): dùng công cụ tìm kiếm hình ảnh để xác định ảnh gốc được chụp ở đâu và khi nào.\n3. Đối chiếu (Nguồn chính thức): kiểm tra thông báo của cơ quan có thẩm quyền hoặc cơ quan báo chí uy tín trước khi chia sẻ."}}]}]]}]}]}],"$L5"]}],["$L6","$L7"],"$L8"]}],"isPartial":"$@9","staleTime":"$a","varyParams":null},{"rsc":"$Lb","isPartial":"$@c","staleTime":"$a","varyParams":null},{"rsc":"$Ld","isPartial":"$@e","staleTime":"$a","varyParams":"$f"}],"isUpgradeableISRFallback":false,"a":"$@10","rootVaryParams":null,"needsRuntimeRequest":"$@11"}
