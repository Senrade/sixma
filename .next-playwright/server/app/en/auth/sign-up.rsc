4:["$","html",null,{"lang":"en","suppressHydrationWarning":true,"className":"h-full antialiased","children":["$","body",null,{"className":"flex min-h-full flex-col","children":["$","$L14",null,{"initialLocale":"en","localeOptions":[{"code":"en","label":"English"},{"code":"vi","label":"Tiếng Việt"},{"code":"es","label":"Español"}],"messages":{"nav.home":"Home","nav.cases":"Case hub","nav.knowledge":"Knowledge","nav.dashboard":"Dashboard","nav.about":"About","nav.contact":"Contact","nav.redeem":"Redeem","nav.signIn":"Sign in","nav.menu":"Menu","nav.close":"Close","language.label":"Language","language.vi":"Tiếng Việt","language.en":"English","nav.primaryAria":"Primary navigation","nav.mobileAria":"Mobile navigation","footer.tagline":"Interactive media and information literacy for students, families, and schools.","footer.prototype":"Hackathon prototype","footer.independent":"Independent project","footer.explore":"Explore","footer.project":"Project","footer.achievements":"Achievements","footer.eventAccess":"Event access","footer.faq":"FAQ","footer.privacy":"Privacy","footer.terms":"Terms","footer.disclaimer":"SIXMA is a submission for the 2026 UNESCO Youth Hackathon. It is an independent project, not affiliated with or sponsored by UNESCO.","home.kicker":"Media literacy, learned by doing","home.description":"An interactive media-literacy game for students, families, and educators. Work through realistic cases before the same pressure appears in real life.","home.playDemo":"Play demo","home.openCases":"Open case hub","home.redeem":"Redeem card","home.whatLabel":"What it is","home.whatTitle":"Practice the pause before you trust or share","home.whatText":"SIXMA turns misinformation patterns into short investigations. Players inspect source material, identify persuasive techniques, and trace how unsupported claims grow.","home.builtFor":"Built for","home.students":"Students","home.studentsText":"Build verification habits before reacting to viral content.","home.families":"Families","home.familiesText":"Discuss scams, emotional pressure, and suspicious claims together.","home.educators":"Educators","home.educatorsText":"Use compact cases for guided media-literacy practice.","home.howLabel":"How an investigation works","home.step1":"Inspect evidence","home.step1Text":"Locate visual inconsistencies instead of trusting first impressions.","home.step2":"Question the claim","home.step2Text":"Mark the exact language that pushes fear or faulty reasoning.","home.step3":"Trace the chain","home.step3Text":"Rebuild the sequence used to move a person from hook to harm.","home.casesLabel":"Case files","home.casesTitle":"Start the first investigation","home.browseAll":"Browse all","welcome.eyebrow":"New signal detected","welcome.title":"New here? Start with a demo case.","welcome.description":"Take one six-minute investigation and see what your first reaction might miss. No account required.","welcome.play":"Begin investigation","welcome.opening":"Opening...","welcome.cardPrompt":"Have a SIXMA case card? Redeem it to access its investigation.","welcome.redeem":"Redeem a card","welcome.about":"About SIXMA","welcome.online":"Online","demoStory.signal1":"Behind the image","demoStory.title1":"This rescue photo was not real.","demoStory.body1":"The girl and puppy were created with AI. But the picture still reached real people and shaped how they felt about a real disaster.","demoStory.sourceBefore":"The story was reported","demoStory.sourceLink":"here","demoStory.sourceAfter":"by the John S. Knight Journalism Fellowships at Stanford University.","demoStory.signal2":"The psychological reaction","demoStory.title2":"Was that easy for you to spot?","demoStory.body2":"Good eye! But most people don't look closely. This photo tugged at heartstrings and felt believable at a glance. People shared it out of empathy, and that’s precisely what makes manipulation work.","demoStory.signal3":"The bigger picture","demoStory.title3":"That was just the tip of the iceberg.","demoStory.body3":"Spotting one AI photo can be simple. The real danger? Thousands of synthetic images and spun narratives flooding our feeds every day, shaping reality before anyone stops to verify.","demoStory.signal4":"SIXMA's Solution","demoStory.title4":"A short pause can make a real difference.","demoStory.body4":"SIXMA helps you train your critical thinking through a simple habit: pause for a moment, scrutinize the source, check the evidence, and question what is really going on.","demoStory.back":"Back","demoStory.continue":"Continue","demoStory.feedbackPrompt":"Help SIXMA improve:","demoStory.feedbackLink":"Open the Feedback form here.","demoStory.explore":"Explore SIXMA","demoStory.debrief":"D001 | Debrief","demoStory.progressAria":"Scene {{current}} of {{total}}","home.faqLabel":"Questions and answers","home.faqTitle":"Frequently asked questions","home.faqIntro":"How case progression, evidence practice, and this independent project work.","faq.whatQuestion":"What does SIXMA really do, anyway?","faq.whatAnswer":"We use games to help you build a quick habit of pausing, checking sources, and spotting fake news or AI tricks before you hit \"Share\".","faq.valueQuestion":"How does this help me in real life?","faq.valueAnswer":"Think of it like a gym for your brain. By practicing on real-world scenarios, you build a habit to spot deepfakes, catch logical fallacies in news or posts, and even see right through scams.","faq.insideQuestion":"What is inside the game?","faq.insideAnswer":"Spot hidden visual errors in an image, catch logical flaws in a post, and wrap up with an interactive drag-and-drop puzzle. It takes just a couple of minutes to test your instincts and solve the case!","faq.proofQuestion":"Does this kind of training actually work?","faq.proofAnswer":"Yes! It is based on a proven psychological concept called prebunking. Exposing you to micro-doses of manipulation tactics in a controlled environment builds cognitive skills when you're out in the wild.","faq.proQuestion":"Do I really need this if I already check my sources?","faq.proAnswer":"Awesome! Since AI and deepfakes are evolving fast, SIXMA is always here whenever you want to keep your skills sharp while scrolling.","cases.kicker":"Investigation archive","cases.title":"Case hub","cases.intro":"Choose a case and work through all three evidence-based modules.","cases.search":"Search investigations","cases.searchPlaceholder":"Title, case ID, or topic","cases.gameMode":"Game mode","cases.fullCase":"Full case","cases.practice":"Module practice","cases.filter":"Filter by threat level","cases.comingSoon":"Coming soon","cases.practiceTitle":"Practice individual modules","cases.practiceText":"Module practice unlocks after a full case is completed. For now, every investigation follows the complete evidence-to-explanation sequence.","cases.checking":"Checking investigation access...","cases.empty":"No case files match this search.","case.file":"Investigation file","case.completed":"Completed","case.locked":"Locked","case.evidenceSealed":"Case sealed","case.sealedText":"The dossier preview is revealed after completion.","case.evidence":"Evidence","case.classified":"Classified","case.minutes":"min","case.modules":"modules","case.unlock":"Complete {{caseId}} to unlock","case.review":"Review case","case.investigate":"Investigate","case.imageAlt":"Evidence for {{title}}","case.hiddenSummary":"Complete the full investigation to reveal this case dossier.","case.previous":"the previous case","dashboard.kicker":"This device","dashboard.title":"Investigation dashboard","dashboard.intro":"Your progress in this test build is stored only in this browser.","learn.kicker":"Media literacy journal","learn.title":"Knowledge hub","learn.intro":"Analysis and practical tools for thinking clearly about the media you encounter every day.","learn.read":"Read","learn.minRead":"min read","redeem.kicker":"Demo event access","redeem.title":"Try the Fear Appeal card","redeem.intro":"Use the Fear Appeal demo card to unlock a special investigation and earn its card badge on this device.","redeem.demoLabel":"Demo mode","redeem.deviceOnly":"Stored on this device","redeem.codeHelp":"Enter the nine characters shown on the Fear Appeal demo card. Hyphens are added automatically.","redeem.demoNotice":"Only the Fear Appeal code is active in this demo. Access and badges are stored only in this browser; no account or server validation is active.","redeem.invalid":"That code is not active for this demo. Use the Fear Appeal code shown in the guide.","redeem.storageUnavailable":"This browser blocked local storage, so the case could not remain unlocked.","redeem.unlocked":"{{caseId}} is now unlocked on this device.","redeem.alreadyUnlocked":"{{caseId}} is already unlocked on this device. No duplicate access was added.","redeem.accessGranted":"Special case unlocked","redeem.cardArtAlt":"{{cardName}} SIXMA event card","redeem.cardBackAlt":"Back of a SIXMA event card with a redemption code","redeem.startCase":"Start S005","redeem.viewBadges":"View badges","redeem.tryCardLabel":"Demo giveaway card","redeem.guideTitle":"Test the Fear Appeal card","redeem.demoCodeLabel":"Code on this demo card","redeem.guideStepOne":"Enter the code shown above in the redemption field.","redeem.guideStepTwo":"Unlock S005 and complete its three evidence checks.","redeem.guideStepThree":"Finish the investigation to add the Fear Appeal badge to your collection.","special.checkingAccess":"Checking event access...","special.cardRequired":"Event card required","special.lockedTitle":"This special case is locked","special.lockedBody":"Redeem the Fear Appeal event card on this device before opening S005.","special.redeemCard":"Redeem a card","metadata.siteTitle":"SIXMA | Interactive media literacy","metadata.siteTitleTemplate":"%s | SIXMA","metadata.siteDescription":"Playable investigations that teach students and families to identify manipulated images, coercive rhetoric, and phishing patterns.","metadata.notFound.case":"Case not found","metadata.notFound.debrief":"Debrief not found","metadata.notFound.guide":"Guide not found","metadata.notFound.mission":"Mission not found","metadata.title.about":"About","metadata.title.achievements":"Achievements","metadata.title.caseHub":"Case Hub","metadata.title.contact":"Contact","metadata.title.dashboard":"Dashboard","metadata.title.knowledgeHub":"Knowledge Hub","metadata.title.privacy":"Privacy","metadata.title.redeem":"Redeem Event Card","metadata.title.signIn":"Sign In","metadata.title.signUp":"Create Account","metadata.title.terms":"Terms","metadata.title.mission":"Mission {{caseId}}","metadata.title.debrief":"{{caseId}} Debrief","home.heroImageAlt":"A cyber investigator reviewing digital evidence","theme.light":"Light","theme.dark":"Dark","cases.gameModeAria":"Select game mode","cases.filterAll":"ALL","cases.filterRed":"RED","cases.filterAmber":"AMBER","cases.filterGreen":"GREEN","briefing.begin":"Begin investigation","briefing.back":"Back to hub","briefing.imageAlt":"Primary evidence for {{title}}","briefing.unverified":"Unverified","briefing.label":"Case briefing","briefing.situation":"The situation","briefing.estimatedTime":"Estimated time: {{minutes}} minutes","debrief.kicker":"Case debrief / {{caseId}}","debrief.complete":"Investigation complete","debrief.summary":"You inspected the evidence, challenged the rhetoric, and reconstructed the manipulation chain.","debrief.label":"What this case teaches","debrief.title":"Carry the method forward","debrief.reflection":"Reflection question","debrief.anotherCase":"Choose another case","debrief.replay":"Replay case","debrief.knowledgeHub":"Knowledge hub","mission.step.inspect":"Inspect","mission.step.analyze":"Analyze","mission.step.reconstruct":"Reconstruct","mission.exit":"Exit mission","mission.progress":"Step {{current}} of {{total}}","mission.exitDialog.eyebrow":"Unfinished investigation","mission.exitDialog.title":"Exit this mission?","mission.exitDialog.description":"Your unfinished mission progress will be lost. The next time you open this case, it will restart from Module 01.","mission.exitDialog.confirm":"Exit mission","mission.exitDialog.cancel":"Continue mission","module.guide.aria":"How to play: {{title}}","module.guide.label":"How to play / Module {{number}}","module.guide.show":"Show steps","module.guide.hide":"Hide steps","module.image.title":"Inspect the image","module.image.summary":"Mark a meaningful visual anomaly and explain why it matters.","module.image.step1":"Drag from one edge of a suspicious area to the opposite edge, or click its center.","module.image.step2":"Answer the evidence question to document the anomaly.","module.text.title":"Analyze the language","module.text.summary":"Highlight the exact passage that uses a persuasive trap.","module.text.step1":"Select the smallest complete passage that contains the manipulation.","module.text.step2":"Confirm the highlight, then answer the critical-thinking question.","module.sort.title":"Reconstruct the chain","module.sort.summary":"Place each stage of the manipulation in chronological order.","module.sort.step1":"Tap or drag each evidence item into a numbered timeline slot.","module.sort.step2":"Reorder the timeline, submit it, and revise it if the sequence is incorrect.","module.common.criticalThinking":"Critical thinking check","module.common.correct":"Correct.","module.common.continue":"Continue","module.common.checkAnswer":"Check answer","module.common.cancel":"Cancel","module.common.ok":"OK","module.common.next":"Next","module.image.windowTitle":"Module 01 / Image Forensics","module.image.canvasAria":"Forensic evidence image. Drag across or click a suspicious area.","module.image.evidenceAlt":"Evidence","module.image.circleAria":"Current drawn evidence circle","module.image.userMarkAria":"Your evidence mark","module.image.anomalyFoundAria":"{{name}} found","module.image.drawError":"That mark does not overlap a verified evidence area closely enough. Inspect the image and try another area.","module.image.quizError":"That explanation does not match the selected anomaly. Try again.","module.image.continueToText":"Continue to Text Highlight","module.image.reviewEvidence":"Review all evidence","module.image.log":"Investigation log","module.image.evidenceFound":"Evidence found: {{found}} / {{total}}","module.image.allFound":"All visual anomalies are documented. Continue to the text investigation.","module.image.reviewTitle":"Evidence comparison","module.image.reviewSummary":"Compare your selections with every verified evidence area before continuing.","module.image.userMarkLegend":"Your selection","module.image.verifiedAreaLegend":"Verified evidence area","module.text.windowTitle":"Module 02 / Language Analysis","module.text.defaultQuestion":"Why is this selection suspicious?","module.text.communityWire":"Community wire","module.text.unverified":"Unverified","module.text.postOptionsAria":"Post options","module.text.contentAria":"Social post content to analyze","module.text.publicPost":"Public post","module.text.contextPending":"Context pending","module.text.evidenceMarks":"Evidence marks {{completed}}/{{total}}","module.text.confirmSelection":"Confirm this selection?","module.text.overlapError":"Selection overlap is {{overlap}}%. Select at least {{required}}% of one manipulation.","module.text.overlapSuccess":"Potential manipulation selected ({{overlap}}% overlap).","module.text.allFound":"All manipulation cues are documented.","module.text.quizError":"That answer does not match the selected manipulation. Try again.","module.text.correctAnswer":"Correct answer:","module.sort.windowTitle":"Module 03 / Sequence Reconstruction","module.sort.status.ready":"Ready","module.sort.status.incorrect":"Incorrect","module.sort.status.correct":"Correct","module.sort.defaultSuccess":"Correct sequence.","module.sort.defaultFailure":"That sequence is not correct yet.","module.sort.caseContext":"Case context","module.sort.evidenceBank":"Evidence bank","module.sort.timeline":"Timeline","module.sort.dropHere":"Drop here","module.sort.items":"Items: {{count}}","module.sort.status":"Status: {{status}}","module.sort.complete":"Complete investigation","module.hint.label":"Hint {{current}} of {{total}}","module.hint.show":"Need a hint?","module.hint.next":"Show a stronger hint","module.hint.area.left":"left","module.hint.area.center":"center","module.hint.area.right":"right","module.hint.area.top":"upper","module.hint.area.middle":"middle","module.hint.area.bottom":"lower","module.hint.image.inspect":"Compare text, repeated shapes, lighting, and physical joins. Look for one detail that does not follow the rest of the scene.","module.hint.image.focus":"Narrow your search to the {{vertical}}-{{horizontal}} area. Mark the suspicious detail, not the whole image.","module.hint.quiz.compareEvidence":"Prefer an answer based on something observable in the image over one based only on what seems unusual.","module.hint.quiz.rejectAssumption":"Ask which choice requires the fewest unsupported assumptions.","module.hint.quiz.identifyEffect":"Focus on what the wording makes a reader assume, feel, or do before checking evidence.","module.hint.text.inspect":"Look for the smallest passage that turns uncertainty into certainty, assigns a motive, or pressures the reader to act.","module.hint.text.focus":"The next manipulation is around the {{region}} of the post. Select the complete claim, without surrounding filler.","module.hint.text.region.start":"beginning","module.hint.text.region.middle":"middle","module.hint.text.region.end":"end","module.hint.sort.inspect":"Separate what creates attention, what increases pressure, and what asks for the risky action. Causes must come before their effects.","module.hint.sort.first":"Start with this event, then rebuild what it enables: {{item}}","dashboard.loading":"Loading progress from this device...","dashboard.completed":"Completed","dashboard.inProgress":"In progress","dashboard.remaining":"Not started","dashboard.progressTitle":"Investigation progress","dashboard.progressDescription":"Track how consistently you apply visual, language, and information-chain checks across the five core investigations.","dashboard.learningPath":"Core learning path","dashboard.caseProgress":"{{completed}} of {{total}} investigations complete","dashboard.achievementsTitle":"Learning achievements","dashboard.achievementsDescription":"These milestones reward applying the verification method across new misinformation contexts.","dashboard.viewAchievements":"Open achievements","achievements.kicker":"This device","achievements.title":"Achievements","achievements.intro":"Track learning milestones separately from the event card badges collected on this device.","achievements.tabs.learning":"Learning achievements","achievements.tabs.badges":"Badge collection","achievements.earned":"Earned","achievements.locked":"Locked","achievements.caseProgress":"Unique cases","achievements.evidence.title":"Complete the evidence loop","achievements.evidence.description":"Complete one investigation by checking visual evidence, manipulative language, and the information chain.","achievements.transfer.title":"Transfer the method","achievements.transfer.description":"Complete three different investigations to apply the same verification method across distinct misinformation contexts.","achievements.investigator.title":"Full-spectrum investigator","achievements.investigator.description":"Complete five unique core investigations to encounter the full set of manipulation scenarios.","achievements.badgeCount":"{{current}}/{{total}} badges collected","achievements.badgeCollectionIntro":"Card badges record the special investigations completed through redeemed event cards.","achievements.badgeLockedHint":"Redeem the Fear Appeal card and complete S005 to earn this badge.","achievements.redeemCard":"Try Fear Appeal","badge.earned":"Badge earned","badge.signalBreaker.title":"Fear Appeal","badge.signalBreaker.description":"Completed S005 and learned to check evidence before reacting to emotionally charged claims.","badge.viewCollection":"View badge collection","case.eventCard":"Event card","case.redeemToUnlock":"Redeem card to unlock","form.signIn.message":"Account sign-in is not connected in this test build. No credentials were sent or stored.","form.signUp.message":"Account creation is not connected in this test build. No personal data was sent or stored.","form.redeem.message":"Redemption requires the secure account service. This code was not sent or marked as used.","form.contact.message":"Message delivery is not connected in this test build. Your message was not sent or stored.","form.eventCode":"Event card code","form.checkCode":"Check code","form.name":"Name","form.email":"Email","form.message":"Message","form.password":"Password","form.displayName":"Display name","form.sendMessage":"Send message","form.signIn":"Sign in","form.createAccount":"Create account","form.codePlaceholder":"XXX-XXX-XXX","form.emailPlaceholder":"you@example.com","auth.eyebrow":"Account access","auth.signIn.title":"Sign in","auth.signIn.intro":"Account services are the next backend milestone. The playable demo remains available without an account.","auth.signIn.prompt":"New here?","auth.signIn.link":"Create an account","auth.signUp.title":"Create account","auth.signUp.intro":"This interface is ready for a secure provider, but this static MVP does not collect account data.","auth.signUp.prompt":"Already registered?","auth.signUp.link":"Sign in","about.eyebrow":"The project","about.title":"Critical thinking under pressure","about.intro":"SIXMA is an interactive media and information literacy prototype for students, families, and educators.","about.section1.title":"Why this format","about.section1.body":"Misinformation is rarely defeated by memorizing a checklist. Each case asks the learner to inspect evidence, make a judgment, receive feedback, and explain the reasoning behind that judgment.","about.section2.title":"Built for practice","about.section2.body":"The case structure combines image forensics, rhetorical analysis, and manipulation-chain reconstruction. These skills transfer to suspicious posts, scams, altered media, and high-pressure messages outside the classroom.","about.section3.title":"Project status","about.section3.body":"This is an independent hackathon prototype. Case questions and learning content remain under review.","contact.eyebrow":"Project contact","contact.title":"Contact the team","contact.intro":"Questions, classroom feedback, and partnership ideas help shape the next version.","contact.send":"Send a message","privacy.eyebrow":"Prototype policy","privacy.title":"Privacy notice","privacy.intro":"This notice describes the current static test build, not a future account-enabled production service.","privacy.section1.title":"Data stored on this device","privacy.section1.body":"The prototype stores case progress, completion times, demo event access, and earned badges in your browser's local storage. This information is not transmitted to a project server by the current application.","privacy.section2.title":"Forms and accounts","privacy.section2.body":"Account and contact screens are interface previews and do not submit data. Event codes are checked locally against a demo list; the raw code is not retained. Do not enter sensitive information into a prototype.","privacy.section3.title":"Third-party hosting","privacy.section3.body":"A deployed hosting provider may process standard request information such as IP addresses and browser metadata. A production release must publish the provider, retention period, lawful basis, and user rights before collecting account data.","privacy.section4.title":"Before production","privacy.section4.body":"This draft must be replaced with a jurisdiction-appropriate privacy policy after the authentication provider, analytics choices, audience age requirements, and data retention rules are finalized.","terms.eyebrow":"Prototype terms","terms.title":"Terms of use","terms.intro":"These plain-language terms apply to the current educational demonstration only.","terms.section1.title":"Educational prototype","terms.section1.body":"SIXMA provides practice activities and general media-literacy information. It does not certify whether every image, post, or person is authentic.","terms.section2.title":"Draft content","terms.section2.body":"Cases may contain fictional scenarios and test questions that are not final. Do not present the prototype as a substitute for professional safety advice.","terms.section3.title":"Acceptable use","terms.section3.body":"Do not attempt to enter another person's private information, disrupt the service, or represent prototype achievements as formal accreditation.","terms.section4.title":"Production review","terms.section4.body":"A public account-enabled launch requires formal legal review, a support process, age-appropriate consent decisions, and complete operator details.","article.minuteRead":"{{minutes}} minute read","article.back":"Back to knowledge hub"},"children":"$L15"}]}]}]
