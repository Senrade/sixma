{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/[locale]/layout,_N_T_/[locale]/cases/layout,_N_T_/[locale]/cases/[case_id]/layout,_N_T_/[locale]/cases/[case_id]/debrief/layout,_N_T_/[locale]/cases/[case_id]/debrief/page,_N_T_/en/cases/D001/debrief"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/$d$locale",
    "/$d$locale/cases/$d$case_id/debrief/__PAGE__"
  ],
  "prefetchHints": {
    "hints": 64,
    "slots": {
      "children": {
        "hints": 32,
        "slots": {
          "children": {
            "hints": 64,
            "slots": {
              "children": {
                "hints": 96,
                "slots": {
                  "children": {
                    "hints": 96,
                    "slots": {
                      "children": {
                        "hints": 160,
                        "slots": null
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}