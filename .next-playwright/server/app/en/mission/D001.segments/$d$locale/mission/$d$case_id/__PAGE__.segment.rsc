0:{"buildId":"JFSdapXluxcZ7WLb1GQKv","data":[{"rsc":["$","$1","c",{"children":[["$","$L2",null,{"caseData":{"level":"RED","case_id":"D001","title":"A cry for help from Hurricane Helene","short_summary":"A single flood photograph draws millions of views and sharp criticism of Hurricane Helene rescue efforts. What can the image actually support?","duration_min":6,"skills":["Visual evidence","Language and claims","Information chains"],"spotted_url":"/assets/images/D001/D001_spotted.png","theme":["Disaster response","Public information"],"story_context":"After Hurricane Helene, an emotionally powerful image of a crying girl holding a puppy in floodwater spread widely. Accounts cite it while criticizing the rescue response, but the original photographer, location, and upload are unclear. Examine what the evidence supports before reaching a conclusion.","source":{"title":"Seeing is no longer believing: Artificial Intelligence's impact on photojournalism","url":"https://jsk.stanford.edu/news/seeing-no-longer-believing-artificial-intelligences-impact-photojournalism","note":"Scenario adapted from David Carson's discussion of an AI-generated girl-and-puppy flood image that circulated during Hurricane Helene."},"modules":{"step_1_image_forensics":{"mechanic_type":"IMAGE_FORENSICS","image_url":"/assets/images/D001/D001_fake.webp","image_width":1024,"image_height":1024,"context_text":"This image was shared as documentary proof of a child's rescue during catastrophic flooding after Hurricane Helene.","target_anomalies":[{"anomaly_id":"D001_IMG_01","name":"synthetic_facial_features","x_pct":49.8,"y_pct":30.1,"radius_pct":25.5,"socratic_quiz":{"question":"After noticing overly smooth skin and unstable facial details, which conclusion is most justified?","options":["A. This clue alone proves that the entire image was generated by AI.","B. It is a clue to test against the original image, its source, and other independent details.","C. Camera processing explains the clue, so no further checks are necessary."],"correct_option":"B","explanation":"A visual anomaly is a clue, not a verdict. Compare the original, its source, and several independent details before concluding."},"description":"The girl's face has an unnaturally smooth, synthetic quality, with inconsistent detail around the eyes, mouth, and expression."}]},"step_2_text_highlight":{"mechanic_type":"TEXT_HIGHLIGHT","simulated_post":{"author":"Storm Truth Network","time_posted":"18 minutes ago","content":"Look at this little girl clinging to her puppy in the flood. The media will never show you what is really happening after the hurricane. This photo proves rescue teams abandoned families like hers while officials staged press conferences. Share it now before they delete the evidence."},"traps":[{"trap_id":"D001_TRAP_01","ground_truth_start":137,"ground_truth_end":238,"matched_text":"This photo proves rescue teams abandoned families like hers while officials staged press conferences.","weapon_type":["appeal_to_emotion","unsupported_inference"],"socratic_quiz":{"question":"Which information would most directly test the claim that rescuers abandoned families?","options":["A. The number of shares and supportive comments the post received on its first day.","B. Rescue records, location, time, and independent reporting about the specific area in question.","C. Another account reposting the same image with a similar caption."],"correct_option":"B","explanation":"One image cannot establish how an entire rescue operation behaved. Test the accusation against records and independent sources tied to the same place and time."}}]},"step_3_sorting_game":{"mechanic_type":"DRAG_AND_DROP_SORTING","context_text":"The synthetic rescue image enters a fast-moving news cycle during a real disaster and begins influencing how people judge the response.","pool_items":[{"item_id":"D001_SORT_02","text":"Viewers react to the child's distress and repost the image as evidence that rescue teams failed families."},{"item_id":"D001_SORT_03","text":"Repetition separates the image from its unknown origin, and the false story competes with verified reporting from the disaster."},{"item_id":"D001_SORT_01","text":"An account posts a synthetic rescue image with a real-disaster caption but provides no photographer, location, or original source."}],"correct_sequence":["D001_SORT_01","D001_SORT_02","D001_SORT_03"],"validation_feedback":{"success":"Correct. The synthetic image gains power through a real disaster, an emotional interpretation, and repeated sharing. As its origin disappears, the invented story can distract from verified reporting about real people.","failure":"Not quite. Begin with the unsourced image, then follow the emotional interpretation, and finish with what repeated sharing does to its origin and credibility."}}},"dialogue_trigger":{"question":"If an image creates a strong emotional reaction and appears to confirm what you already believe, what should you verify before sharing it?","mil_insight":"Trace the earliest available upload, identify the photographer or creator, confirm the date and location through independent reporting, and look for provenance such as Content Credentials. Visual artifacts are clues, not a final verdict: authentic images can also be falsely accused of being AI-generated."}}}],["$L3","$L4","$L5"],"$L6"]}],"isPartial":"$@7","staleTime":"$8","varyParams":null},{"rsc":"$L9","isPartial":"$@a","staleTime":"$8","varyParams":null},{"rsc":"$Lb","isPartial":"$@c","staleTime":"$8","varyParams":"$d"},{"rsc":"$Le","isPartial":"$@f","staleTime":"$8","varyParams":"$d"}],"isUpgradeableISRFallback":false,"a":"$@10","rootVaryParams":null,"needsRuntimeRequest":"$@11"}
