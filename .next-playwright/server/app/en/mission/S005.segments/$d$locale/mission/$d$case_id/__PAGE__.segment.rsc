0:{"buildId":"JFSdapXluxcZ7WLb1GQKv","data":[{"rsc":["$","$1","c",{"children":[["$","$L2",null,{"children":["$","$L3",null,{"caseData":{"level":"RED","case_id":"S005","title":"Why Is Times Square Empty?","short_summary":"A deserted Times Square image recirculates with claims about a 2026 health emergency and a new lockdown, setting off anxious debate.","duration_min":6,"skills":["Visual evidence","Language and claims","Information chains"],"spotted_url":"/assets/images/R005/R005_spotted.jpg","theme":["Public health","Current events"],"story_context":"Posts are sharing a completely deserted Times Square image while claiming that a severe health emergency in 2026 forced authorities to lock down New York. The original date and source are not visible in the circulating posts. Examine what can be established from the available evidence.","source":{"title":"Context Collapse and Hybrid AI Misinformation","url":"","note":"Scenario based on real-world tactics where authentic past crisis footage is digitally altered to manufacture modern panic."},"modules":{"step_1_image_forensics":{"mechanic_type":"IMAGE_FORENSICS","image_url":"/assets/images/R005/R005_fake.jpg","image_width":1536,"image_height":1024,"context_text":"Social media posts are sharing this photo as absolute proof of a 2026 Coronavirus emergency lockdown in Times Square.","target_anomalies":[{"anomaly_id":"R005_IMG_01","name":"flipped_digit_in_year","x_pct":48.5,"y_pct":6.5,"radius_pct":6,"socratic_quiz":{"question":"Which comparison best tests whether '2026' is original signage or a later overlay?","options":["A. Compare each digit's shape, perspective, and lighting with the others and with older trusted images.","B. Check whether the building commonly displays the new year on its advertising signs.","C. Sharpen the image to see whether the digits become clearer than nearby objects."],"correct_option":"A","explanation":"An overlay may break shape, perspective, or lighting consistency. Older independent images help test that hypothesis."},"description":"The first digit '2' in '2026' is flipped vertically, which is highly illogical compared to the original font."},{"anomaly_id":"R005_IMG_02","name":"corrupted_billboard_text","x_pct":76,"y_pct":26.4,"radius_pct":15,"socratic_quiz":{"question":"Which check separates compressed small text from generated or edited text?","options":["A. Compare the board's brightness with other signs in the same scene.","B. Check whether repeated characters keep their shape and form consistent words in the source image.","C. Decide whether the message fits the situation described by the post."],"correct_option":"B","explanation":"Compression removes detail but does not usually reshape every instance of a character differently. Compare with the source before concluding."},"description":"The text contains bizarre spelling errors, with distorted characters in 'STAYIE' and 'SSJCK'."},{"anomaly_id":"R005_IMG_03","name":"illogical_light_reflection","x_pct":49.5,"y_pct":82.1,"radius_pct":15,"socratic_quiz":{"question":"Which test best evaluates the red reflection on the street?","options":["A. Trace the reflection's direction and color to a matching light source in the scene.","B. Compare the wet street with the weather forecast for the date claimed by the post.","C. Compare its saturation with the display settings used to view the image."],"correct_option":"A","explanation":"A reflection should correspond to a source in direction and color. A mismatch is a clue that needs further checking."},"description":"The puddle reflects a bright red light, yet there is no corresponding red light source from the surrounding billboards."}]},"step_2_text_highlight":{"mechanic_type":"TEXT_HIGHLIGHT","simulated_post":{"author":"NYC Daily Uncensored","time_posted":"15 minutes ago","content":"The situation in New York has spiraled into complete chaos. A severe outbreak of a new Corona variant triggered an emergency lockdown across the entire Times Square earlier this morning. Government agencies are deliberately keeping this information hidden, but this photo reveals the full truth. If you don't take action immediately, your family could be caught in the next wave of the pandemic. Everyone needs to share this post with their groups right away to warn the community. Contact your relatives in the US immediately and tell them to stock up on food and cash before it's too late."},"traps":[{"trap_id":"R005_TRAP_01","ground_truth_start":187,"ground_truth_end":295,"matched_text":"Government agencies are deliberately keeping this information hidden, but this photo reveals the full truth.","weapon_type":["conspiracy_theory","authority_undermining"],"socratic_quiz":{"question":"Which response avoids both blind trust and blanket rejection of official sources?","options":["A. Trust the post when many commenters report similar experiences.","B. Compare its specific claims with primary data and independent sources that explain their methods.","C. Trust the official statement because public agencies always have complete information."],"correct_option":"B","explanation":"No source should be exempt from scrutiny. Compare specific claims with primary data, methods, and independent reporting."}},{"trap_id":"R005_TRAP_02","ground_truth_start":296,"ground_truth_end":395,"matched_text":"If you don't take action immediately, your family could be caught in the next wave of the pandemic.","weapon_type":["appeal_to_fear","emotional_manipulation"],"socratic_quiz":{"question":"Which behavior shows that fear is replacing evaluation of evidence?","options":["A. The reader finds the original report and records what remains uncertain.","B. The reader shares immediately to warn others before checking the source and date.","C. The reader pauses, compares sources, and then decides whether action is needed."],"correct_option":"B","explanation":"Emotion becomes manipulation when it moves action ahead of verification. That urge is a signal to pause."}},{"trap_id":"R005_TRAP_03","ground_truth_start":482,"ground_truth_end":591,"matched_text":"Contact your relatives in the US immediately and tell them to stock up on food and cash before it's too late.","weapon_type":["manufactured_urgency","panic_inducing_action"],"socratic_quiz":{"question":"In what order does the post ask readers to act?","options":["A. Share the warning first, then investigate its source and evidence later.","B. Trace the source, compare evidence, and warn others only if needed.","C. Ask the community, wait for agreement, and treat consensus as verification."],"correct_option":"A","explanation":"The call reverses the safe order by placing sharing before verification. Urgency does not make evidence more reliable."}}]},"step_3_sorting_game":{"mechanic_type":"DRAG_AND_DROP_SORTING","context_text":"The process by which scammers combine old footage, AI technology, and psychology to create a complete disinformation campaign.","pool_items":[{"item_id":"R005_SORT_03","text":"Draft a post containing sensational words, sow conspiracy theories, and attach the AI-edited photo."},{"item_id":"R005_SORT_01","text":"Collect a genuine photo of a deserted Times Square taken during the 2020 lockdown."},{"item_id":"R005_SORT_04","text":"Distribute the post into social media groups to incite people to hoard goods and drive engagement."},{"item_id":"R005_SORT_02","text":"Use Generative AI tools to change the year from 2020 to 2026 and alter details on the billboards to refresh the image."}],"correct_sequence":["R005_SORT_01","R005_SORT_02","R005_SORT_03","R005_SORT_04"],"validation_feedback":{"success":"Correct! You have completely uncovered the lifecycle of a hybrid scam: Find old footage -> Edit with AI -> Embed psychological traps -> Spread panic.","failure":"Not quite the right order. Start with selecting the original photo, then move to AI editing, followed by writing manipulative content, and finally, distribution."}}},"dialogue_trigger":{"question":"If you see a panic-inducing photo about a global situation, what is your 3-step verification process?","mil_insight":"1. Technical Forensics (AI Forensics): Zoom in to find anomalies like distorted text, flipped digits, and illogical reflections.\n2. Context Verification (Reverse Image Search): Use image search tools to determine when and where the original photo was taken.\n3. Cross-checking (Official Sources): Verify through statements from authorities or reputable news outlets before sharing."}}}]}],["$L4","$L5","$L6"],"$L7"]}],"isPartial":"$@8","staleTime":"$9","varyParams":null},{"rsc":"$La","isPartial":"$@b","staleTime":"$9","varyParams":null},{"rsc":"$Lc","isPartial":"$@d","staleTime":"$9","varyParams":"$e"},{"rsc":"$Lf","isPartial":"$@10","staleTime":"$9","varyParams":"$e"}],"isUpgradeableISRFallback":false,"a":"$@11","rootVaryParams":null,"needsRuntimeRequest":"$@12"}
