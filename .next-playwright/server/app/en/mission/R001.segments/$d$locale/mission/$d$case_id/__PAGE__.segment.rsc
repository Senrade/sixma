0:{"buildId":"JFSdapXluxcZ7WLb1GQKv","data":[{"rsc":["$","$1","c",{"children":[["$","$L2",null,{"caseData":{"level":"RED","case_id":"R001","title":"The AI takeover of the classroom","short_summary":"A classroom image sparks debate over how technology is being used around students, while a heated post spreads faster than answers.","duration_min":15,"skills":["Visual evidence","Language and claims","Information chains"],"spotted_url":"/assets/images/R001/R001_spotted.jpg","theme":["Education","Technology"],"story_context":"Students and parents are sharing a classroom image alongside claims about automated monitoring and evaluation. The discussion is escalating, and several posts direct readers toward further information. Examine the material before deciding what is happening.","modules":{"step_1_image_forensics":{"mechanic_type":"IMAGE_FORENSICS","image_url":"/assets/images/R001/R001_fake.jpg","image_width":1000,"image_height":1000,"context_text":"The leaked image attached to the controversy post is claimed to be 'evidence that AI is monitoring and evaluating students during class.'","target_anomalies":[{"anomaly_id":"R001_IMG_01","name":"gibberish_text","x_pct":57.4,"y_pct":18.7,"radius_pct":14.5,"socratic_quiz":{"question":"Which check best separates generated text errors from blur or low image quality?","options":["A. Compare the screen brightness with other bright areas in the classroom.","B. Check whether strokes form consistent characters across the screen.","C. Determine whether the screen is mounted where classroom displays are normally placed."],"correct_option":"B","explanation":"Blur tends to remove detail consistently; characters that deform differently from place to place warrant comparison with the source image."},"description":"Distorted, unreadable gibberish text rendered on the digital whiteboard screen."},{"anomaly_id":"R001_IMG_02","name":"clipping_students","x_pct":57.8,"y_pct":68.6,"radius_pct":15.7,"socratic_quiz":{"question":"Look at the students in the middle foreground. What specifically does not fit together?","options":["A. The students sit close enough that some of them partly block one another.","B. The smaller student's head and shoulders blend into nearby students, so it is unclear where one body ends and another begins.","C. Their faces are soft and out of focus because the camera is focused on the robot."],"correct_option":"B","explanation":"The positioning of the students in this area overlaps and follows no discernible pattern. Although there are two tables, the students' placement is illogical rather than clearly concealed. This very lack of order is the anomaly."},"description":"Students in the center foreground are abnormally overlapping and clipping into each other."}]},"step_2_text_highlight":{"mechanic_type":"TEXT_HIGHLIGHT","simulated_post":{"author":"Parents and Education Community","time_posted":"2 hours ago","content":"Just found out the Ministry of Education is piloting a new AI learning assistant in several schools next term. Honestly, this looks like a covert move to phase out real human teachers entirely. It's pretty obvious big tech is just trying to fully automate education to exploit student data for profit. Even Professor Tan stated in his latest report that 'AI is now taking full control over the classroom'. If parents don't stand up and boycott this rollout immediately, our kids will completely lose their capacity for critical thinking!"},"traps":[{"trap_id":"R001_TRAP_01","ground_truth_start":111,"ground_truth_end":193,"matched_text":"Honestly, this looks like a covert move to phase out real human teachers entirely.","weapon_type":["conspiracy_theory","intentionality_bias"],"socratic_quiz":{"question":"What evidence is needed before concluding that the pilot program intends to replace teachers?","options":["A. Reports that many parents worry AI could affect the role of teachers.","B. Confirmation that the pilot uses an AI tool in some learning activities.","C. Staffing plans, budgets, or implementation documents showing that teaching positions will be removed."],"correct_option":"C","explanation":"Using an AI tool does not establish an intention to replace teachers. A claim about motive needs specific documents or actions, not concern alone."}},{"trap_id":"R001_TRAP_02","ground_truth_start":194,"ground_truth_end":301,"matched_text":"It's pretty obvious big tech is just trying to fully automate education to exploit student data for profit.","weapon_type":["attribution_bias","overgeneralization","conspiracy_theory"],"socratic_quiz":{"question":"Which response preserves independent judgment when the post says the motive is 'obvious'?","options":["A. Provisionally trust it because the writer sounds certain and informed.","B. Reject all educational technology because data collection is a real risk.","C. Separate confident tone from substance and request evidence for both the data claim and the alleged motive."],"correct_option":"C","explanation":"Confidence does not improve evidence. Separate each claim and ask what verifiable source supports it."}},{"trap_id":"R001_TRAP_03","ground_truth_start":406,"ground_truth_end":537,"matched_text":"If parents don't stand up and boycott this rollout immediately, our kids will completely lose their capacity for critical thinking!","weapon_type":["false_dilemma","slippery_slope"],"socratic_quiz":{"push_question":"Which reasonable possibilities does the closing statement remove from the parents' choices?","options":["A. Supporting the pilot immediately without safeguards or further questions.","B. Investigating, demanding safeguards, using a monitored trial, or opposing only part of the program.","C. Boycotting later if credible evidence of serious harm emerges."],"correct_option":"B","explanation":"The post leaves only two extremes: boycott now or face disaster. Restoring the omitted middle options breaks that forced frame."}}]},"step_3_sorting_game":{"mechanic_type":"DRAG_AND_DROP_SORTING","context_text":"The panic spread by the post has led to a phishing email targeting parents.","pool_items":[{"item_id":"R001_SORT_01","text":"Click the security link below to pay a processing fee (50,000 VND) and verify your right to opt out."},{"item_id":"R001_SORT_02","text":"WARNING: Your child's personal data is currently scheduled to be synchronized with the Ministry's AI system."},{"item_id":"R001_SORT_03","text":"To protect privacy and remove your child's name from the project, parents must complete the 'Opt-Out Form' within 24 hours."}],"correct_sequence":["R001_SORT_02","R001_SORT_03","R001_SORT_01"],"validation_feedback":{"success":"Correct. You have decoded the classic psychological manipulation chain: Create fear and urgency (Hook) → Introduce an urgent solution (Pivot) → Insert a trap to collect money or personal data (Trap).","failure":"Incorrect logic. Phishing attacks rarely ask for money immediately. They usually begin by creating a fake crisis to overwhelm the victim's critical thinking."}}},"dialogue_trigger":{"question":"Ask your Teacher/Parent: if a message from the school asks parents to click an unfamiliar link and make an urgent payment to 'protect their child's learning data,' what key sign proves that it is a scam?","mil_insight":"Help parents and students compare the message against standard administrative procedures: legitimate educational institutions never use time pressure (such as a 24-hour deadline) or unofficial payment links to handle security issues."}}}],["$L3","$L4","$L5"],"$L6"]}],"isPartial":"$@7","staleTime":"$8","varyParams":null},{"rsc":"$L9","isPartial":"$@a","staleTime":"$8","varyParams":null},{"rsc":"$Lb","isPartial":"$@c","staleTime":"$8","varyParams":"$d"},{"rsc":"$Le","isPartial":"$@f","staleTime":"$8","varyParams":"$d"}],"isUpgradeableISRFallback":false,"a":"$@10","rootVaryParams":null,"needsRuntimeRequest":"$@11"}
