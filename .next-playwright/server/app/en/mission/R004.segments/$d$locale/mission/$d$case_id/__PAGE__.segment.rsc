0:{"buildId":"JFSdapXluxcZ7WLb1GQKv","data":[{"rsc":["$","$1","c",{"children":[["$","$L2",null,{"caseData":{"level":"RED","case_id":"R004","title":"National Exam Got Leaked","short_summary":"A Discord channel races with screenshots, urgent messages, and offers tied to a supposed national exam leak.","duration_min":15,"skills":["Visual evidence","Language and claims","Information chains"],"spotted_url":"/assets/images/R004/R004_spotted.jpg","theme":["Education","Online communities"],"story_context":"Students in a Discord server are reacting to claims that national exam papers have leaked. Some accounts promise immediate access, others report what friends have heard, and the deadline is approaching. Examine the screenshot, messages, and sequence before deciding what is credible.","modules":{"step_1_image_forensics":{"mechanic_type":"IMAGE_FORENSICS","image_url":"/assets/images/R004/R004_fake.jpg","image_width":853,"image_height":548,"context_text":"The screenshot attached to the channel is claimed to show '100% authentic exam papers from the Ministry of Education.' Examine whether its interface details are consistent with a genuine Discord screen.","target_anomalies":[{"anomaly_id":"R004_IMG_03","name":"distorted_ui_icon","x_pct":85.8,"y_pct":90,"radius_pct":8,"socratic_quiz":{"question":"Which observation is most useful when evaluating the two small buttons near the lower-right corner?","options":["A. Their dark background uses a similar color to the message bar.","B. The repeated GIF controls do not preserve consistent letterforms and geometry.","C. Their position is close to the other message controls."],"correct_option":"B","explanation":"Repeated interface controls should keep the same recognizable lettering, proportions, and edges. When supposedly identical GIF buttons disagree in those details, compare the screenshot with a known genuine interface before trusting it."},"description":"Distorted and malformed GIF/chat interface icons at the bottom right corner of the chat input bar."},{"anomaly_id":"R004_IMG_04","name":"artifact_edge_shape","x_pct":93.6,"y_pct":31.8,"radius_pct":8,"socratic_quiz":{"question":"What is inconsistent about the right edge of the highlighted message area?","options":["A. Its upper and lower corners use the same rounded finish.","B. Its boundary is interrupted by an inward notch that does not continue the highlighted area.","C. Its right edge sits close to the side of the chat window."],"correct_option":"B","explanation":"A message highlight should form one continuous panel. Here, the unexplained inward break interrupts its right border without any control or content causing that shape, indicating that this part of the screenshot was edited."},"description":"The right edge of the highlighted message area is interrupted by an inward notch, breaking what should be a continuous boundary."}]},"step_2_text_highlight":{"mechanic_type":"TEXT_HIGHLIGHT","simulated_post":{"author":"Scholarship Selection Committee","time_posted":"Just now","content":"Congratulations! You have already been selected for the Student Excellence Scholarship. Only 50 students have been selected. If you fail to verify within 2 hours, your place will be offered to another student. Please log in to pay your verification fee of 49,000 VND. Do not contact the school office because verification is handled by our scholarship partner."},"traps":[{"trap_id":"R004_TRAP_01","ground_truth_start":17,"ground_truth_end":87,"matched_text":"You have already been selected for the Student Excellence Scholarship.","weapon_type":["authority_bias","reward_bait"],"socratic_quiz":{"question":"How is confirming that you were 'selected' meant to change your next step?","options":["A. Shift attention from checking legitimacy to quickly completing the steps needed to claim the reward.","B. Encourage the recipient to ask the school about selection criteria before replying.","C. Give the recipient enough detail to compare the notice with the official scholarship process."],"correct_option":"A","explanation":"Feeling like a winner shifts attention from verification to claiming the prize. Check the official process before taking the next step."}},{"trap_id":"R004_TRAP_02","ground_truth_start":125,"ground_truth_end":209,"matched_text":"If you fail to verify within 2 hours, your place will be offered to another student.","weapon_type":["artificial_urgency"],"socratic_quiz":{"question":"Which check best determines whether the two-hour deadline is legitimate or merely pressure?","options":["A. Confirm that the countdown on the linked page is working accurately.","B. Check the official website's rules and contact the organization using details you find independently.","C. Compare the scholarship value with the time remaining to decide whether the risk is worthwhile."],"correct_option":"B","explanation":"A deadline is credible only when it appears in the official process and can be confirmed independently. Time pressure is not evidence."}},{"trap_id":"R004_TRAP_03","ground_truth_start":236,"ground_truth_end":266,"matched_text":"verification fee of 49,000 VND","weapon_type":["advance_fee_scam"],"socratic_quiz":{"question":"Which action checks the 'verification fee' without following the sender's path?","options":["A. Find the scholarship terms and contact the provider through its official website or phone number.","B. Send the small amount because the possible loss is low compared with the reward.","C. Check whether the payment page uses professional logos, colors, and wording."],"correct_option":"A","explanation":"Even a small fee can begin a payment or data-theft scam. Verify it through a channel you locate independently."}},{"trap_id":"R004_TRAP_04","ground_truth_start":268,"ground_truth_end":360,"matched_text":"Do not contact the school office because verification is handled by our scholarship partner.","weapon_type":["isolation_tactic"],"socratic_quiz":{"question":"Why is contacting the school through its official channel the strongest test here?","options":["A. The school may extend the deadline, so the message itself no longer needs evaluating.","B. A trusted independent channel breaks the isolation and confirms whether the notice exists.","C. The office can report how much other students have already paid."],"correct_option":"B","explanation":"Secrecy prevents a reality check. Independent contact verifies the notice without relying on the sender."}}]},"step_3_sorting_game":{"mechanic_type":"DRAG_AND_DROP_SORTING","context_text":"Arrange the steps in the chronological order of how this phishing scam unfolds to understand the full scope of the danger.","pool_items":[{"item_id":"R004_SORT_01","text":"Student receives an urgent scholarship email."},{"item_id":"R004_SORT_02","text":"Student clicks the fake verification link."},{"item_id":"R004_SORT_03","text":"Student enters their official school account username and password."},{"item_id":"R004_SORT_04","text":"The scammer's database silently captures the credentials."},{"item_id":"R004_SORT_05","text":"The fake website prompts the student for an OTP or payment detail."},{"item_id":"R004_SORT_06","text":"The attacker actively logs into the student's real school account in the background."},{"item_id":"R004_SORT_07","text":"The student loses access to their account before they even realize the money was a trick."}],"correct_sequence":["R004_SORT_01","R004_SORT_02","R004_SORT_03","R004_SORT_04","R004_SORT_05","R004_SORT_06","R004_SORT_07"],"validation_feedback":{"success":"Correct! Scammers don't just want your money directly; stealing your school account credentials gives them access to internal systems and allows them to scam others using your identity. The actual theft happens before you even pay the fee.","failure":"Not quite. Remember that phishing attacks often steal your information *before* asking for money. Simply typing in your password is the critical point where the attacker takes control."}}},"dialogue_trigger":{"question":"Ask your Teacher/Parent: If you really received a scholarship notification, how could you verify it independently without clicking the provided link?","mil_insight":"Understand that urgency and unexpected rewards are common manipulation tactics. Always verify official communications by navigating directly to the school's known official portal or contacting the administration office in person, rather than relying on provided links."}}}],["$L3","$L4","$L5"],"$L6"]}],"isPartial":"$@7","staleTime":"$8","varyParams":null},{"rsc":"$L9","isPartial":"$@a","staleTime":"$8","varyParams":null},{"rsc":"$Lb","isPartial":"$@c","staleTime":"$8","varyParams":"$d"},{"rsc":"$Le","isPartial":"$@f","staleTime":"$8","varyParams":"$d"}],"isUpgradeableISRFallback":false,"a":"$@10","rootVaryParams":null,"needsRuntimeRequest":"$@11"}
