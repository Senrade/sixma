0:{"buildId":"JFSdapXluxcZ7WLb1GQKv","data":[{"rsc":["$","$1","c",{"children":[["$","div",null,{"className":"flex min-h-screen flex-col bg-background text-foreground","children":[["$","$L2",null,{}],["$","main",null,{"className":"flex-1","children":["$","section",null,{"className":"case-grid-bg min-h-[70vh] py-12 sm:py-16","children":["$","div",null,{"className":"mx-auto max-w-7xl px-4 sm:px-6","children":[["$","$L3",null,{"kicker":"achievements.kicker","title":"achievements.title","description":"achievements.intro"}],["$","$L4",null,{"cases":[{"level":"RED","case_id":"D001","title":"A cry for help from Hurricane Helene","short_summary":"A single flood photograph draws millions of views and sharp criticism of Hurricane Helene rescue efforts. What can the image actually support?","duration_min":6,"skills":["Visual evidence","Language and claims","Information chains"],"spotted_url":"/assets/images/D001/D001_spotted.png","theme":["Disaster response","Public information"],"story_context":"After Hurricane Helene, an emotionally powerful image of a crying girl holding a puppy in floodwater spread widely. Accounts cite it while criticizing the rescue response, but the original photographer, location, and upload are unclear. Examine what the evidence supports before reaching a conclusion.","source":{"title":"Seeing is no longer believing: Artificial Intelligence's impact on photojournalism","url":"https://jsk.stanford.edu/news/seeing-no-longer-believing-artificial-intelligences-impact-photojournalism","note":"Scenario adapted from David Carson's discussion of an AI-generated girl-and-puppy flood image that circulated during Hurricane Helene."},"modules":{"step_1_image_forensics":{"mechanic_type":"IMAGE_FORENSICS","image_url":"/assets/images/D001/D001_fake.webp","image_width":1024,"image_height":1024,"context_text":"This image was shared as documentary proof of a child's rescue during catastrophic flooding after Hurricane Helene.","target_anomalies":[{"anomaly_id":"D001_IMG_01","name":"synthetic_facial_features","x_pct":49.8,"y_pct":30.1,"radius_pct":25.5,"socratic_quiz":{"question":"After noticing overly smooth skin and unstable facial details, which conclusion is most justified?","options":["A. This clue alone proves that the entire image was generated by AI.","B. It is a clue to test against the original image, its source, and other independent details.","C. Camera processing explains the clue, so no further checks are necessary."],"correct_option":"B","explanation":"A visual anomaly is a clue, not a verdict. Compare the original, its source, and several independent details before concluding."},"description":"The girl's face has an unnaturally smooth, synthetic quality, with inconsistent detail around the eyes, mouth, and expression."}]},"step_2_text_highlight":{"mechanic_type":"TEXT_HIGHLIGHT","simulated_post":{"author":"Storm Truth Network","time_posted":"18 minutes ago","content":"Look at this little girl clinging to her puppy in the flood. The media will never show you what is really happening after the hurricane. This photo proves rescue teams abandoned families like hers while officials staged press conferences. Share it now before they delete the evidence."},"traps":[{"trap_id":"D001_TRAP_01","ground_truth_start":137,"ground_truth_end":238,"matched_text":"This photo proves rescue teams abandoned families like hers while officials staged press conferences.","weapon_type":["appeal_to_emotion","unsupported_inference"],"socratic_quiz":{"question":"Which information would most directly test the claim that rescuers abandoned families?","options":["A. The number of shares and supportive comments the post received on its first day.","B. Rescue records, location, time, and independent reporting about the specific area in question.","C. Another account reposting the same image with a similar caption."],"correct_option":"B","explanation":"One image cannot establish how an entire rescue operation behaved. Test the accusation against records and independent sources tied to the same place and time."}}]},"step_3_sorting_game":{"mechanic_type":"DRAG_AND_DROP_SORTING","context_text":"The synthetic rescue image enters a fast-moving news cycle during a real disaster and begins influencing how people judge the response.","pool_items":[{"item_id":"D001_SORT_02","text":"Viewers react to the child's distress and repost the image as evidence that rescue teams failed families."},{"item_id":"D001_SORT_03","text":"Repetition separates the image from its unknown origin, and the false story competes with verified reporting from the disaster."},{"item_id":"D001_SORT_01","text":"An account posts a synthetic rescue image with a real-disaster caption but provides no photographer, location, or original source."}],"correct_sequence":["D001_SORT_01","D001_SORT_02","D001_SORT_03"],"validation_feedback":{"success":"Correct. The synthetic image gains power through a real disaster, an emotional interpretation, and repeated sharing. As its origin disappears, the invented story can distract from verified reporting about real people.","failure":"Not quite. Begin with the unsourced image, then follow the emotional interpretation, and finish with what repeated sharing does to its origin and credibility."}}},"dialogue_trigger":{"question":"If an image creates a strong emotional reaction and appears to confirm what you already believe, what should you verify before sharing it?","mil_insight":"Trace the earliest available upload, identify the photographer or creator, confirm the date and location through independent reporting, and look for provenance such as Content Credentials. Visual artifacts are clues, not a final verdict: authentic images can also be falsely accused of being AI-generated."}},{"level":"RED","case_id":"R001","title":"The AI takeover of the classroom","short_summary":"A classroom image sparks debate over how technology is being used around students, while a heated post spreads faster than answers.","duration_min":15,"skills":["Visual evidence","Language and claims","Information chains"],"spotted_url":"/assets/images/R001/R001_spotted.jpg","theme":["Education","Technology"],"story_context":"Students and parents are sharing a classroom image alongside claims about automated monitoring and evaluation. The discussion is escalating, and several posts direct readers toward further information. Examine the material before deciding what is happening.","modules":{"step_1_image_forensics":{"mechanic_type":"IMAGE_FORENSICS","image_url":"/assets/images/R001/R001_fake.jpg","image_width":1000,"image_height":1000,"context_text":"The leaked image attached to the controversy post is claimed to be 'evidence that AI is monitoring and evaluating students during class.'","target_anomalies":[{"anomaly_id":"R001_IMG_01","name":"gibberish_text","x_pct":57.4,"y_pct":18.7,"radius_pct":14.5,"socratic_quiz":{"question":"Which check best separates generated text errors from blur or low image quality?","options":["A. Compare the screen brightness with other bright areas in the classroom.","B. Check whether strokes form consistent characters across the screen.","C. Determine whether the screen is mounted where classroom displays are normally placed."],"correct_option":"B","explanation":"Blur tends to remove detail consistently; characters that deform differently from place to place warrant comparison with the source image."},"description":"Distorted, unreadable gibberish text rendered on the digital whiteboard screen."},{"anomaly_id":"R001_IMG_02","name":"clipping_students","x_pct":57.8,"y_pct":68.6,"radius_pct":15.7,"socratic_quiz":{"question":"Look at the students in the middle foreground. What specifically does not fit together?","options":["A. The students sit close enough that some of them partly block one another.","B. The smaller student's head and shoulders blend into nearby students, so it is unclear where one body ends and another begins.","C. Their faces are soft and out of focus because the camera is focused on the robot."],"correct_option":"B","explanation":"The positioning of the students in this area overlaps and follows no discernible pattern. Although there are two tables, the students' placement is illogical rather than clearly concealed. This very lack of order is the anomaly."},"description":"Students in the center foreground are abnormally overlapping and clipping into each other."}]},"step_2_text_highlight":{"mechanic_type":"TEXT_HIGHLIGHT","simulated_post":{"author":"Parents and Education Community","time_posted":"2 hours ago","content":"Just found out the Ministry of Education is piloting a new AI learning assistant in several schools next term. Honestly, this looks like a covert move to phase out real human teachers entirely. It's pretty obvious big tech is just trying to fully automate education to exploit student data for profit. Even Professor Tan stated in his latest report that 'AI is now taking full control over the classroom'. If parents don't stand up and boycott this rollout immediately, our kids will completely lose their capacity for critical thinking!"},"traps":[{"trap_id":"R001_TRAP_01","ground_truth_start":111,"ground_truth_end":193,"matched_text":"Honestly, this looks like a covert move to phase out real human teachers entirely.","weapon_type":["conspiracy_theory","intentionality_bias"],"socratic_quiz":{"question":"What evidence is needed before concluding that the pilot program intends to replace teachers?","options":["A. Reports that many parents worry AI could affect the role of teachers.","B. Confirmation that the pilot uses an AI tool in some learning activities.","C. Staffing plans, budgets, or implementation documents showing that teaching positions will be removed."],"correct_option":"C","explanation":"Using an AI tool does not establish an intention to replace teachers. A claim about motive needs specific documents or actions, not concern alone."}},{"trap_id":"R001_TRAP_02","ground_truth_start":194,"ground_truth_end":301,"matched_text":"It's pretty obvious big tech is just trying to fully automate education to exploit student data for profit.","weapon_type":["attribution_bias","overgeneralization","conspiracy_theory"],"socratic_quiz":{"question":"Which response preserves independent judgment when the post says the motive is 'obvious'?","options":["A. Provisionally trust it because the writer sounds certain and informed.","B. Reject all educational technology because data collection is a real risk.","C. Separate confident tone from substance and request evidence for both the data claim and the alleged motive."],"correct_option":"C","explanation":"Confidence does not improve evidence. Separate each claim and ask what verifiable source supports it."}},{"trap_id":"R001_TRAP_03","ground_truth_start":406,"ground_truth_end":537,"matched_text":"If parents don't stand up and boycott this rollout immediately, our kids will completely lose their capacity for critical thinking!","weapon_type":["false_dilemma","slippery_slope"],"socratic_quiz":{"push_question":"Which reasonable possibilities does the closing statement remove from the parents' choices?","options":["A. Supporting the pilot immediately without safeguards or further questions.","B. Investigating, demanding safeguards, using a monitored trial, or opposing only part of the program.","C. Boycotting later if credible evidence of serious harm emerges."],"correct_option":"B","explanation":"The post leaves only two extremes: boycott now or face disaster. Restoring the omitted middle options breaks that forced frame."}}]},"step_3_sorting_game":{"mechanic_type":"DRAG_AND_DROP_SORTING","context_text":"The panic spread by the post has led to a phishing email targeting parents.","pool_items":[{"item_id":"R001_SORT_01","text":"Click the security link below to pay a processing fee (50,000 VND) and verify your right to opt out."},{"item_id":"R001_SORT_02","text":"WARNING: Your child's personal data is currently scheduled to be synchronized with the Ministry's AI system."},{"item_id":"R001_SORT_03","text":"To protect privacy and remove your child's name from the project, parents must complete the 'Opt-Out Form' within 24 hours."}],"correct_sequence":["R001_SORT_02","R001_SORT_03","R001_SORT_01"],"validation_feedback":{"success":"Correct. You have decoded the classic psychological manipulation chain: Create fear and urgency (Hook) → Introduce an urgent solution (Pivot) → Insert a trap to collect money or personal data (Trap).","failure":"Incorrect logic. Phishing attacks rarely ask for money immediately. They usually begin by creating a fake crisis to overwhelm the victim's critical thinking."}}},"dialogue_trigger":{"question":"Ask your Teacher/Parent: if a message from the school asks parents to click an unfamiliar link and make an urgent payment to 'protect their child's learning data,' what key sign proves that it is a scam?","mil_insight":"Help parents and students compare the message against standard administrative procedures: legitimate educational institutions never use time pressure (such as a 24-hour deadline) or unofficial payment links to handle security issues."}},{"level":"RED","case_id":"R002","title":"The Canteen Complaint","short_summary":"A disturbing lunch-tray photo reaches school staff with a demand for an immediate response before the story spreads.","duration_min":12,"skills":["Visual evidence","Language and claims","Information chains"],"spotted_url":"/assets/images/R002/R002_spotted.png","theme":["School life","Food safety"],"story_context":"An anonymous message includes a canteen photo and warns that it will be shared publicly unless the school responds before a deadline. Staff must determine what the image and wording actually support before taking action.","modules":{"step_1_image_forensics":{"mechanic_type":"IMAGE_FORENSICS","image_url":"/assets/images/R002/R002_fake.png","image_width":1020,"image_height":680,"context_text":"The leaked image attached to the extortion email claims to show 'a disgusting cockroach served in the high school canteen food tray.'","target_anomalies":[{"anomaly_id":"R002_IMG_01","name":"fake_cockroach_insertion","x_pct":69.5,"y_pct":73,"radius_pct":13.5,"socratic_quiz":{"question":"Which comparison would best test whether the cockroach belongs naturally in this scene?","options":["A. Measure its length against several grains of rice to decide whether that species could exist.","B. Compare its color transitions, surface texture, and highlights with the nearby food and metal under the same light.","C. Count how many separate food items appear in the tray around it."],"correct_option":"B","explanation":"Size varies by species and perspective. Material and lighting differences under the same conditions are a stronger comparison, but the source still needs checking."},"description":"The cockroach has unusually saturated, polished coloring and a toy-like surface that does not respond to the scene's light like the rice and metal tray."}]},"step_2_text_highlight":{"mechanic_type":"TEXT_HIGHLIGHT","simulated_post":{"author":"Anonymous","time_posted":"5 hour ago","content":"I don't usually post stuff like this, but today's lunch honestly made me uncomfortable. While I was eating, I noticed what looked like a cockroach in my lunch tray. I don't know whether it came from the kitchen or somewhere else, maybe there's a perfectly good explanation out there, but if this really came from the cafeteria, students have a right to be worried. I'm not saying the cafeteria is unsafe. I'm just asking why this keeps happening and why nobody ever seems to explain anything afterward. The school seems to never take students' food feedback into consideration anyway, saying the problem is too complicated or something like that. At this point, I think parents deserve to know what's happening before this gets quietly swept under the rug..."},"traps":[{"trap_id":"R002_TRAP_01","ground_truth_start":365,"ground_truth_end":502,"matched_text":"I'm not saying the cafeteria is unsafe. I'm just asking why this keeps happening and why nobody ever seems to explain anything afterward.","weapon_type":["seeding_doubt"],"socratic_quiz":{"question":"What evidence would be needed before 'why this keeps happening' becomes a fair question?","options":["A. The author's uncertainty about where the insect came from.","B. Independently verified earlier incidents showing that the same problem has actually recurred.","C. The absence of an immediate reply beneath this particular post."],"correct_option":"B","explanation":"The phrase 'keeps happening' turns one unverified case into a pattern. That claim requires several independently verified incidents."}},{"trap_id":"R002_TRAP_02","ground_truth_start":503,"ground_truth_end":646,"matched_text":"The school seems to never take students' food feedback into consideration anyway, saying the problem is too complicated or something like that.","weapon_type":["poisoning_the_well","overgeneralization"],"socratic_quiz":{"question":"How could a reader evaluate a future school response without inheriting the post's framing?","options":["A. Judge the response by how many commenters already distrust the school.","B. Examine its evidence and reasoning before deciding whether complexity is genuine or merely an excuse.","C. Reject the response if it contains technical details that are difficult to understand."],"correct_option":"B","explanation":"The post labels any future response an excuse before it exists. Judge the response by its evidence, not by this advance framing."}},{"trap_id":"R002_TRAP_03","ground_truth_start":647,"ground_truth_end":758,"matched_text":"At this point, I think parents deserve to know what's happening before this gets quietly swept under the rug...","weapon_type":["conspiracy_theory","appeal_to_fear"],"socratic_quiz":{"question":"How does 'before this gets quietly swept under the rug' change the order in which readers act and verify?","options":["A. It makes immediate sharing feel protective, moving escalation ahead of checking whether a cover-up exists.","B. It limits the claim to one personal observation and reduces pressure to act.","C. It directs readers to an independent source before they form a judgment."],"correct_option":"A","explanation":"The implied cover-up introduces a conspiracy narrative and appeals to fear, making rapid sharing feel safer than waiting. That artificial urgency reverses a sound verification order: readers are pushed to amplify first and investigate later."}}]},"step_3_sorting_game":{"mechanic_type":"DRAG_AND_DROP_SORTING","context_text":"A misleading social media post about the school canteen has spread across the community.","pool_items":[{"item_id":"R002_SORT_01","text":"Other users repost the image with stronger claims, assuming the worst."},{"item_id":"R002_SORT_02","text":"The rumor becomes accepted as 'common knowledge' even though the original claim was never confirmed."},{"item_id":"R002_SORT_03","text":"Someone uploads a photo with a personal interpretation but without verified context."},{"item_id":"R002_SORT_04","text":"People react emotionally and share the post before waiting for official verification."}],"correct_sequence":["R002_SORT_03","R002_SORT_01","R002_SORT_04","R002_SORT_02"],"validation_feedback":{"success":"Correct. Rumors often become believable through repetition rather than evidence. An unverified observation can evolve into 'everyone knows it's true' as people add assumptions, share emotionally, and stop checking the original source.","failure":"Not quite. False information rarely spreads because of one convincing post alone. It gains momentum as people amplify unverified claims and repeat them as facts before anyone verifies the evidence."}}},"dialogue_trigger":{"question":"Ask your Teacher/Parent: If you received this message, what evidence would you need before believing the photo reflects a real food safety problem rather than a manipulated story?","mil_insight":"A single image rarely provides enough context to establish what happened. Discuss how to distinguish direct evidence from assumptions by checking the original source, verifying when and where the photo was taken, and following the school's official investigation process before drawing conclusions."}},{"level":"RED","case_id":"R003","title":"Twenty and Already Winning?","short_summary":"A polished post about money, discipline, and success pulls young viewers into a heated comparison over who is falling behind.","duration_min":15,"skills":["Visual evidence","Language and claims","Information chains"],"spotted_url":"/assets/images/R003/R003_spotted.png","theme":["Social media","Personal finance"],"story_context":"A post by a young 'Minh Khang' persona pairs financial advice with an aspirational lifestyle photo. Its message is drawing admiration, defensiveness, and comparison among viewers. Examine the post before deciding how much weight it deserves.","modules":{"step_1_image_forensics":{"mechanic_type":"IMAGE_FORENSICS","image_url":"/assets/images/R003/R003_fake.jpg","image_width":1402,"image_height":1122,"context_text":"This photo supports Minh Khang's claims about his luxury lifestyle. Examine whether its physical details remain internally consistent.","target_anomalies":[{"anomaly_id":"R003_IMG_01","name":"inconsistent_hand_features","x_pct":38.7,"y_pct":58.2,"radius_pct":8.6,"socratic_quiz":{"question":"Which comparison would be most useful when examining the phone-holding hand?","options":["A. Check whether perspective alone explains why the hand appears larger than the wrist.","B. Check whether its color and knuckle contours transition naturally from the wrist through the grip.","C. Check whether the phone angle points in the same direction as the person's gaze."],"correct_option":"B","explanation":"Perspective can explain size, but not inconsistent color or joint structure. Compare the hand-to-wrist transition and treat the mismatch as a clue, not proof."},"description":"The phone-holding hand has a subtly over-saturated, waxy color and knuckle contours that do not fully align with a natural grip."},{"anomaly_id":"R003_IMG_02","name":"warped_window_frame","x_pct":17,"y_pct":49.9,"radius_pct":11.2,"socratic_quiz":{"question":"Which check would best distinguish perspective from an inconsistency in the window area?","options":["A. Compare the frame's brightness with the buildings visible outside.","B. Trace whether the rigid frame and handle keep smooth contours or ripple independently along their length.","C. Check whether the handle is positioned at a practical height for opening the window."],"correct_option":"B","explanation":"Perspective may tilt a rigid object, but its edges should remain structurally coherent. Compare the waviness with the rest of the frame and a genuine window."},"description":"The rigid window frame and handle develop uneven, wavy contours instead of preserving consistent manufactured geometry."}]},"step_2_text_highlight":{"mechanic_type":"TEXT_HIGHLIGHT","simulated_post":{"author":"Minh Khang","time_posted":"2 hours ago","content":"It's honestly funny how some people keep saying \"money doesn't buy happiness\" every time someone posts something nice. Like... just because you can't afford it doesn't mean it's \"showing off.\" Meanwhile, everyone I know is out here grinding, getting internships, buying what they want, and actually doing something with their lives. If you're still making excuses while everyone else is moving up, maybe stop blaming other people and ask yourself why you're getting left behind. Stay mad if you want, but don't expect the world to wait for you."},"traps":[{"trap_id":"R003_T1","ground_truth_start":127,"ground_truth_end":192,"matched_text":"just because you can't afford it doesn't mean it's \"showing off.\"","weapon_type":["attacking_motive","strawman"],"socratic_quiz":{"question":"Which response evaluates the criticism without guessing the speaker's motive?","options":["A. Check whether the critic has previously posted about money.","B. Check whether the criticism names specific behavior and applies a reasonable standard.","C. Check whether most commenters describe the critic as jealous or sincere."],"correct_option":"B","explanation":"A guessed motive does not determine whether criticism is valid. Evaluate its claim and evidence first."}},{"trap_id":"R003_T2","ground_truth_start":204,"ground_truth_end":331,"matched_text":"everyone I know is out here grinding, getting internships, buying what they want, and actually doing something with their lives","weapon_type":["false_comparison"],"socratic_quiz":{"question":"What data would be needed to test the claim that buying luxury goods means greater success?","options":["A. The average price of the products shown in the post.","B. A clear measure of success plus data on income, debt, family support, and starting conditions.","C. The number of the writer's acquaintances who liked or shared the post."],"correct_option":"B","explanation":"Buying power does not automatically measure success. A meaningful comparison needs a shared measure and comparable starting conditions."}},{"trap_id":"R003_T3","ground_truth_start":333,"ground_truth_end":477,"matched_text":"If you're still making excuses while everyone else is moving up, maybe stop blaming other people and ask yourself why you're getting left behind","weapon_type":["inducing_fomo","personal_attack"],"socratic_quiz":{"question":"What evidence is needed before believing that 'everyone is moving up while you fall behind'?","options":["A. A feed containing many popular posts about shopping and travel.","B. Representative data about the group, including unposted outcomes and relevant circumstances.","C. The reader's anxiety after seeing several similar posts in a row."],"correct_option":"B","explanation":"A feed shows what people choose to publish, not a representative sample. Do not turn the feeling of falling behind into a factual conclusion."}},{"trap_id":"R003_T4","ground_truth_start":479,"ground_truth_end":543,"matched_text":"Stay mad if you want, but don't expect the world to wait for you","weapon_type":["emotional_dismissal"],"socratic_quiz":{"question":"What does 'stay mad' do to a criticism that includes evidence?","options":["A. It asks the critic to provide clearer evidence before the discussion continues.","B. It recasts the criticism as an emotional reaction so its substance can be ignored.","C. It acknowledges the critic's feelings and invites further explanation."],"correct_option":"B","explanation":"Labeling an emotion does not answer an objection. Return to the argument and evidence instead of diagnosing the speaker."}}]},"step_3_sorting_game":{"mechanic_type":"DRAG_AND_DROP_SORTING","context_text":"A post by a young 'Minh Khang' persona pairs financial advice with an aspirational lifestyle photo. Its message is drawing admiration, defensiveness, and comparison among viewers. Examine the post before deciding how much weight it deserves.","pool_items":[{"item_id":"R003_SORT_01","text":"Readers experience intense FOMO and self-doubt, fearing they are falling behind their peers."},{"item_id":"R003_SORT_02","text":"The influencer posts fabricated AI images of luxury items to establish fake status and authority."},{"item_id":"R003_SORT_03","text":"The influencer pitches an expensive 'wealth mindset masterclass' as the ultimate shortcut to success."},{"item_id":"R003_SORT_04","text":"The post uses false comparisons and condescending language to demean normal working youth as 'lazy'."}],"correct_sequence":["R003_SORT_02","R003_SORT_04","R003_SORT_01","R003_SORT_03"],"validation_feedback":{"success":"Correct! You have decoded the classic toxic flexing funnel: Fabricate status (Hook) → Belittle through false comparisons (Attack) → Trigger insecurity and FOMO (Anxiety) → Sell an expensive 'shortcut' course (Monetization).","failure":"Incorrect sequence. Toxic flexing manipulators first establish fake wealth, then attack the audience's self-esteem to create FOMO before offering their paid course as a fake solution."}}},"dialogue_trigger":{"question":"Ask your Teacher/Parent: If a social media post makes you feel anxious that you are falling behind your peers who seem to afford luxury lifestyles, what steps can you take to evaluate what is real versus staged?","mil_insight":"Social media highlights rarely reflect full reality, and AI image tools make lavish lifestyles effortless to fake. Remind youth that success is not measured by material flexing or belittling others, and urgent pitches for expensive 'mindset courses' are almost always predatory scams."}},{"level":"RED","case_id":"R004","title":"National Exam Got Leaked","short_summary":"A Discord channel races with screenshots, urgent messages, and offers tied to a supposed national exam leak.","duration_min":15,"skills":["Visual evidence","Language and claims","Information chains"],"spotted_url":"/assets/images/R004/R004_spotted.jpg","theme":["Education","Online communities"],"story_context":"Students in a Discord server are reacting to claims that national exam papers have leaked. Some accounts promise immediate access, others report what friends have heard, and the deadline is approaching. Examine the screenshot, messages, and sequence before deciding what is credible.","modules":{"step_1_image_forensics":{"mechanic_type":"IMAGE_FORENSICS","image_url":"/assets/images/R004/R004_fake.jpg","image_width":853,"image_height":548,"context_text":"The screenshot attached to the channel is claimed to show '100% authentic exam papers from the Ministry of Education.' Examine whether its interface details are consistent with a genuine Discord screen.","target_anomalies":[{"anomaly_id":"R004_IMG_03","name":"distorted_ui_icon","x_pct":85.8,"y_pct":90,"radius_pct":8,"socratic_quiz":{"question":"Which observation is most useful when evaluating the two small buttons near the lower-right corner?","options":["A. Their dark background uses a similar color to the message bar.","B. The repeated GIF controls do not preserve consistent letterforms and geometry.","C. Their position is close to the other message controls."],"correct_option":"B","explanation":"Repeated interface controls should keep the same recognizable lettering, proportions, and edges. When supposedly identical GIF buttons disagree in those details, compare the screenshot with a known genuine interface before trusting it."},"description":"Distorted and malformed GIF/chat interface icons at the bottom right corner of the chat input bar."},{"anomaly_id":"R004_IMG_04","name":"artifact_edge_shape","x_pct":93.6,"y_pct":31.8,"radius_pct":8,"socratic_quiz":{"question":"What is inconsistent about the right edge of the highlighted message area?","options":["A. Its upper and lower corners use the same rounded finish.","B. Its boundary is interrupted by an inward notch that does not continue the highlighted area.","C. Its right edge sits close to the side of the chat window."],"correct_option":"B","explanation":"A message highlight should form one continuous panel. Here, the unexplained inward break interrupts its right border without any control or content causing that shape, indicating that this part of the screenshot was edited."},"description":"The right edge of the highlighted message area is interrupted by an inward notch, breaking what should be a continuous boundary."}]},"step_2_text_highlight":{"mechanic_type":"TEXT_HIGHLIGHT","simulated_post":{"author":"Scholarship Selection Committee","time_posted":"Just now","content":"Congratulations! You have already been selected for the Student Excellence Scholarship. Only 50 students have been selected. If you fail to verify within 2 hours, your place will be offered to another student. Please log in to pay your verification fee of 49,000 VND. Do not contact the school office because verification is handled by our scholarship partner."},"traps":[{"trap_id":"R004_TRAP_01","ground_truth_start":17,"ground_truth_end":87,"matched_text":"You have already been selected for the Student Excellence Scholarship.","weapon_type":["authority_bias","reward_bait"],"socratic_quiz":{"question":"How is confirming that you were 'selected' meant to change your next step?","options":["A. Shift attention from checking legitimacy to quickly completing the steps needed to claim the reward.","B. Encourage the recipient to ask the school about selection criteria before replying.","C. Give the recipient enough detail to compare the notice with the official scholarship process."],"correct_option":"A","explanation":"Feeling like a winner shifts attention from verification to claiming the prize. Check the official process before taking the next step."}},{"trap_id":"R004_TRAP_02","ground_truth_start":125,"ground_truth_end":209,"matched_text":"If you fail to verify within 2 hours, your place will be offered to another student.","weapon_type":["artificial_urgency"],"socratic_quiz":{"question":"Which check best determines whether the two-hour deadline is legitimate or merely pressure?","options":["A. Confirm that the countdown on the linked page is working accurately.","B. Check the official website's rules and contact the organization using details you find independently.","C. Compare the scholarship value with the time remaining to decide whether the risk is worthwhile."],"correct_option":"B","explanation":"A deadline is credible only when it appears in the official process and can be confirmed independently. Time pressure is not evidence."}},{"trap_id":"R004_TRAP_03","ground_truth_start":236,"ground_truth_end":266,"matched_text":"verification fee of 49,000 VND","weapon_type":["advance_fee_scam"],"socratic_quiz":{"question":"Which action checks the 'verification fee' without following the sender's path?","options":["A. Find the scholarship terms and contact the provider through its official website or phone number.","B. Send the small amount because the possible loss is low compared with the reward.","C. Check whether the payment page uses professional logos, colors, and wording."],"correct_option":"A","explanation":"Even a small fee can begin a payment or data-theft scam. Verify it through a channel you locate independently."}},{"trap_id":"R004_TRAP_04","ground_truth_start":268,"ground_truth_end":360,"matched_text":"Do not contact the school office because verification is handled by our scholarship partner.","weapon_type":["isolation_tactic"],"socratic_quiz":{"question":"Why is contacting the school through its official channel the strongest test here?","options":["A. The school may extend the deadline, so the message itself no longer needs evaluating.","B. A trusted independent channel breaks the isolation and confirms whether the notice exists.","C. The office can report how much other students have already paid."],"correct_option":"B","explanation":"Secrecy prevents a reality check. Independent contact verifies the notice without relying on the sender."}}]},"step_3_sorting_game":{"mechanic_type":"DRAG_AND_DROP_SORTING","context_text":"Arrange the steps in the chronological order of how this phishing scam unfolds to understand the full scope of the danger.","pool_items":[{"item_id":"R004_SORT_01","text":"Student receives an urgent scholarship email."},{"item_id":"R004_SORT_02","text":"Student clicks the fake verification link."},{"item_id":"R004_SORT_03","text":"Student enters their official school account username and password."},{"item_id":"R004_SORT_04","text":"The scammer's database silently captures the credentials."},{"item_id":"R004_SORT_05","text":"The fake website prompts the student for an OTP or payment detail."},{"item_id":"R004_SORT_06","text":"The attacker actively logs into the student's real school account in the background."},{"item_id":"R004_SORT_07","text":"The student loses access to their account before they even realize the money was a trick."}],"correct_sequence":["R004_SORT_01","R004_SORT_02","R004_SORT_03","R004_SORT_04","R004_SORT_05","R004_SORT_06","R004_SORT_07"],"validation_feedback":{"success":"Correct! Scammers don't just want your money directly; stealing your school account credentials gives them access to internal systems and allows them to scam others using your identity. The actual theft happens before you even pay the fee.","failure":"Not quite. Remember that phishing attacks often steal your information *before* asking for money. Simply typing in your password is the critical point where the attacker takes control."}}},"dialogue_trigger":{"question":"Ask your Teacher/Parent: If you really received a scholarship notification, how could you verify it independently without clicking the provided link?","mil_insight":"Understand that urgency and unexpected rewards are common manipulation tactics. Always verify official communications by navigating directly to the school's known official portal or contacting the administration office in person, rather than relying on provided links."}},{"level":"RED","case_id":"S005","title":"Why Is Times Square Empty?","short_summary":"A deserted Times Square image recirculates with claims about a 2026 health emergency and a new lockdown, setting off anxious debate.","duration_min":6,"skills":["Visual evidence","Language and claims","Information chains"],"spotted_url":"/assets/images/R005/R005_spotted.jpg","theme":["Public health","Current events"],"story_context":"Posts are sharing a completely deserted Times Square image while claiming that a severe health emergency in 2026 forced authorities to lock down New York. The original date and source are not visible in the circulating posts. Examine what can be established from the available evidence.","source":{"title":"Context Collapse and Hybrid AI Misinformation","url":"","note":"Scenario based on real-world tactics where authentic past crisis footage is digitally altered to manufacture modern panic."},"modules":{"step_1_image_forensics":{"mechanic_type":"IMAGE_FORENSICS","image_url":"/assets/images/R005/R005_fake.jpg","image_width":1536,"image_height":1024,"context_text":"Social media posts are sharing this photo as absolute proof of a 2026 Coronavirus emergency lockdown in Times Square.","target_anomalies":[{"anomaly_id":"R005_IMG_01","name":"flipped_digit_in_year","x_pct":48.5,"y_pct":6.5,"radius_pct":6,"socratic_quiz":{"question":"Which comparison best tests whether '2026' is original signage or a later overlay?","options":["A. Compare each digit's shape, perspective, and lighting with the others and with older trusted images.","B. Check whether the building commonly displays the new year on its advertising signs.","C. Sharpen the image to see whether the digits become clearer than nearby objects."],"correct_option":"A","explanation":"An overlay may break shape, perspective, or lighting consistency. Older independent images help test that hypothesis."},"description":"The first digit '2' in '2026' is flipped vertically, which is highly illogical compared to the original font."},{"anomaly_id":"R005_IMG_02","name":"corrupted_billboard_text","x_pct":76,"y_pct":26.4,"radius_pct":15,"socratic_quiz":{"question":"Which check separates compressed small text from generated or edited text?","options":["A. Compare the board's brightness with other signs in the same scene.","B. Check whether repeated characters keep their shape and form consistent words in the source image.","C. Decide whether the message fits the situation described by the post."],"correct_option":"B","explanation":"Compression removes detail but does not usually reshape every instance of a character differently. Compare with the source before concluding."},"description":"The text contains bizarre spelling errors, with distorted characters in 'STAYIE' and 'SSJCK'."},{"anomaly_id":"R005_IMG_03","name":"illogical_light_reflection","x_pct":49.5,"y_pct":82.1,"radius_pct":15,"socratic_quiz":{"question":"Which test best evaluates the red reflection on the street?","options":["A. Trace the reflection's direction and color to a matching light source in the scene.","B. Compare the wet street with the weather forecast for the date claimed by the post.","C. Compare its saturation with the display settings used to view the image."],"correct_option":"A","explanation":"A reflection should correspond to a source in direction and color. A mismatch is a clue that needs further checking."},"description":"The puddle reflects a bright red light, yet there is no corresponding red light source from the surrounding billboards."}]},"step_2_text_highlight":{"mechanic_type":"TEXT_HIGHLIGHT","simulated_post":{"author":"NYC Daily Uncensored","time_posted":"15 minutes ago","content":"The situation in New York has spiraled into complete chaos. A severe outbreak of a new Corona variant triggered an emergency lockdown across the entire Times Square earlier this morning. Government agencies are deliberately keeping this information hidden, but this photo reveals the full truth. If you don't take action immediately, your family could be caught in the next wave of the pandemic. Everyone needs to share this post with their groups right away to warn the community. Contact your relatives in the US immediately and tell them to stock up on food and cash before it's too late."},"traps":[{"trap_id":"R005_TRAP_01","ground_truth_start":187,"ground_truth_end":295,"matched_text":"Government agencies are deliberately keeping this information hidden, but this photo reveals the full truth.","weapon_type":["conspiracy_theory","authority_undermining"],"socratic_quiz":{"question":"Which response avoids both blind trust and blanket rejection of official sources?","options":["A. Trust the post when many commenters report similar experiences.","B. Compare its specific claims with primary data and independent sources that explain their methods.","C. Trust the official statement because public agencies always have complete information."],"correct_option":"B","explanation":"No source should be exempt from scrutiny. Compare specific claims with primary data, methods, and independent reporting."}},{"trap_id":"R005_TRAP_02","ground_truth_start":296,"ground_truth_end":395,"matched_text":"If you don't take action immediately, your family could be caught in the next wave of the pandemic.","weapon_type":["appeal_to_fear","emotional_manipulation"],"socratic_quiz":{"question":"Which behavior shows that fear is replacing evaluation of evidence?","options":["A. The reader finds the original report and records what remains uncertain.","B. The reader shares immediately to warn others before checking the source and date.","C. The reader pauses, compares sources, and then decides whether action is needed."],"correct_option":"B","explanation":"Emotion becomes manipulation when it moves action ahead of verification. That urge is a signal to pause."}},{"trap_id":"R005_TRAP_03","ground_truth_start":482,"ground_truth_end":591,"matched_text":"Contact your relatives in the US immediately and tell them to stock up on food and cash before it's too late.","weapon_type":["manufactured_urgency","panic_inducing_action"],"socratic_quiz":{"question":"In what order does the post ask readers to act?","options":["A. Share the warning first, then investigate its source and evidence later.","B. Trace the source, compare evidence, and warn others only if needed.","C. Ask the community, wait for agreement, and treat consensus as verification."],"correct_option":"A","explanation":"The call reverses the safe order by placing sharing before verification. Urgency does not make evidence more reliable."}}]},"step_3_sorting_game":{"mechanic_type":"DRAG_AND_DROP_SORTING","context_text":"The process by which scammers combine old footage, AI technology, and psychology to create a complete disinformation campaign.","pool_items":[{"item_id":"R005_SORT_03","text":"Draft a post containing sensational words, sow conspiracy theories, and attach the AI-edited photo."},{"item_id":"R005_SORT_01","text":"Collect a genuine photo of a deserted Times Square taken during the 2020 lockdown."},{"item_id":"R005_SORT_04","text":"Distribute the post into social media groups to incite people to hoard goods and drive engagement."},{"item_id":"R005_SORT_02","text":"Use Generative AI tools to change the year from 2020 to 2026 and alter details on the billboards to refresh the image."}],"correct_sequence":["R005_SORT_01","R005_SORT_02","R005_SORT_03","R005_SORT_04"],"validation_feedback":{"success":"Correct! You have completely uncovered the lifecycle of a hybrid scam: Find old footage -> Edit with AI -> Embed psychological traps -> Spread panic.","failure":"Not quite the right order. Start with selecting the original photo, then move to AI editing, followed by writing manipulative content, and finally, distribution."}}},"dialogue_trigger":{"question":"If you see a panic-inducing photo about a global situation, what is your 3-step verification process?","mil_insight":"1. Technical Forensics (AI Forensics): Zoom in to find anomalies like distorted text, flipped digits, and illogical reflections.\n2. Context Verification (Reverse Image Search): Use image search tools to determine when and where the original photo was taken.\n3. Cross-checking (Official Sources): Verify through statements from authorities or reputable news outlets before sharing."}}]}]]}]}]}],"$L5"]}],["$L6","$L7"],"$L8"]}],"isPartial":"$@9","staleTime":"$a","varyParams":null},{"rsc":"$Lb","isPartial":"$@c","staleTime":"$a","varyParams":null},{"rsc":"$Ld","isPartial":"$@e","staleTime":"$a","varyParams":"$f"}],"isUpgradeableISRFallback":false,"a":"$@10","rootVaryParams":null,"needsRuntimeRequest":"$@11"}
